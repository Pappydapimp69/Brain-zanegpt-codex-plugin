<script>
const D = __DATA__;
// ============================================================ SCORE
// A generative adaptive score. Everything is synthesised — no assets.
//
// Six Brain lessons are structural here, not stylistic:
//  1. The AudioContext is created inside the BEGIN gesture. Creating it earlier
//     and resuming later is what the autoplay policy kills silently (test#E9).
//  2. resume() is never awaited — Brave's shields can leave that promise
//     pending forever and hang anything that waits on it (dog#E1).
//  3. Note timing comes from a LOOK-AHEAD SCHEDULER against ctx.currentTime —
//     a short timer tops up a ~150ms horizon. Per-note setTimeout drifts and is
//     throttled when backgrounded, scheduling notes in the past so they bunch
//     (shadow#E1, dog#E14).
//  4. Act changes are QUANTIZED to the next bar and masked with a stinger.
//     Cutting mid-phrase breaks meter continuity, which a listener parses
//     instantly and involuntarily (MUSIC/adaptive-scoring/quantized-transitions).
//  5. Layers crossfade EQUAL-POWER (cos/sin), because they are uncorrelated
//     sources — a linear fade would dip -3dB through the middle (dog#E57).
//  6. Voices are capped and disconnect on `onended`; scheduled nodes are not
//     freed for you (dog#E6). Gains land on an epsilon, never exact 0, since an
//     exponential ramp cannot reach zero (ideas: exponential-ramp-cannot-reach-zero).
//
// The architecture is VERTICAL layering with slow crossfades rather than
// horizontal re-sequencing: this film's state is continuous and sparse, and
// hard horizontal cuts are the kind of transition a listener consciously reads
// as "a system" (MUSIC/adaptive-scoring/horizontal-vs-vertical-architectures).
const Score = (function () {
  let ctx = null, master = null, bus = {}, on = false, voices = 0;
  const CAP = 18;

  // --- theory ---------------------------------------------------------------
  const MODES = {
    dorian:     [0, 2, 3, 5, 7, 9, 10],  // hopeful minor
    mixolydian: [0, 2, 4, 5, 7, 9, 10],  // bright, anthem
    lydian:     [0, 2, 4, 6, 7, 9, 11],  // wonder (#4 is the characteristic note)
    phrygian:   [0, 1, 3, 5, 7, 8, 10],  // danger (b2 is the characteristic note)
  };
  const ROOT = 55; // A1

  // The leitmotif: a rising 5th opening (reads as lift-off), a distinctive
  // rhythm cell, and short enough to survive fragmentation later — the three
  // things a motif needs to be transformable (MUSIC/leitmotif/memorability-test).
  // Degrees are scale indices, so a mode-flip recolours it without new material.
  const MOTIF = [
    { d: 0, t: 0, len: 2 },
    { d: 4, t: 2, len: 1 },   // the 5th
    { d: 6, t: 3, len: 1 },
    { d: 3, t: 4, len: 3 },
  ];

  // Each act picks a mode and a layer mix. This is the "one mode per zone"
  // palette — a second identity axis independent of instrumentation.
  const ACTS = [
    { mode: "dorian",     pad: .30, sub: .22, arp: 0,   lead: 0,   air: .10, pulse: 0   }, // title
    { mode: "dorian",     pad: .34, sub: .26, arp: 0,   lead: .12, air: .12, pulse: .06 }, // it began
    { mode: "dorian",     pad: .38, sub: .30, arp: .10, lead: .16, air: .14, pulse: .12 }, // accumulation
    { mode: "dorian",     pad: .28, sub: .20, arp: 0,   lead: 0,   air: .16, pulse: 0   }, // not a system
    { mode: "mixolydian", pad: .38, sub: .30, arp: .20, lead: .20, air: .12, pulse: .10 }, // graph
    { mode: "mixolydian", pad: .40, sub: .28, arp: .16, lead: .26, air: .10, pulse: .10 }, // compatible
    { mode: "lydian",     pad: .42, sub: .28, arp: .22, lead: .24, air: .10, pulse: .08 }, // emergence
    { mode: "dorian",     pad: .32, sub: .24, arp: .12, lead: .16, air: .18, pulse: .05 }, // frontier
    { mode: "phrygian",   pad: .34, sub: .34, arp: .08, lead: .18, air: .22, pulse: .04 }, // doubt
    { mode: "phrygian",   pad: .30, sub: .28, arp: 0,   lead: .14, air: .20, pulse: 0   }, // forks (let it read)
    { mode: "phrygian",   pad: .30, sub: .30, arp: 0,   lead: .10, air: .24, pulse: 0   }, // provenance
    { mode: "dorian",     pad: .40, sub: .24, arp: .10, lead: .22, air: .12, pulse: .06 }, // derived
    { mode: "dorian",     pad: .34, sub: .18, arp: 0,   lead: .24, air: .10, pulse: 0   }, // close (augmented)
  ];

  let act = 0, pendingAct = null;

  // --- transport ------------------------------------------------------------
  const BPM = 66, STEPS_PER_BAR = 8;
  const stepDur = () => 60 / BPM / 2;      // an eighth note
  let step = 0, nextT = 0, timer = null;
  const LOOKAHEAD = 0.15, TICK_MS = 40;

  function noteHz(deg, oct = 0) {
    const sc = MODES[ACTS[act].mode];
    const semis = sc[((deg % 7) + 7) % 7] + 12 * (oct + Math.floor(deg / 7));
    return ROOT * Math.pow(2, semis / 12);
  }

  function brown(sec) {
    const n = Math.floor(ctx.sampleRate * sec), b = ctx.createBuffer(1, n, ctx.sampleRate);
    const d = b.getChannelData(0);
    let last = 0;
    for (let i = 0; i < n; i++) { last = (last + (Math.random() * 2 - 1) * 0.06) * 0.985; d[i] = last * 3; }
    return b;
  }
  function ramp(param, v, sec = 0.6) {
    if (!ctx) return;
    param.cancelScheduledValues(ctx.currentTime);
    param.setTargetAtTime(v, ctx.currentTime, Math.max(0.02, sec / 3));
  }
  function retire(node, chain) {
    node.onended = () => { voices = Math.max(0, voices - 1); chain.forEach(n => { try { n.disconnect(); } catch (e) {} }); };
  }

  /** One synthesised note, scheduled at an ABSOLUTE audio-clock time. */
  function note(busName, hz, t, dur, { type = "triangle", gain = .2, glide = 0, q = 0 } = {}) {
    if (!on || voices >= CAP) return;
    voices++;
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.type = type;
    o.frequency.setValueAtTime(hz, t);
    if (glide) o.frequency.exponentialRampToValueAtTime(Math.max(20, hz * glide), t + dur);
    g.gain.setValueAtTime(0.0001, t);
    g.gain.linearRampToValueAtTime(gain, t + Math.min(.05, dur * .25));
    g.gain.exponentialRampToValueAtTime(0.0001, t + dur);   // epsilon, never 0
    let tail = g;
    if (q) { const f = ctx.createBiquadFilter(); f.type = "lowpass"; f.frequency.value = q; g.connect(f); tail = f; }
    o.connect(g);
    tail.connect(bus[busName] || master);
    o.start(t); o.stop(t + dur + .04);
    retire(o, [o, g, tail]);
  }

  // --- the look-ahead scheduler --------------------------------------------
  function schedule() {
    if (!on) return;
    while (nextT < ctx.currentTime + LOOKAHEAD) {
      const s = step % STEPS_PER_BAR;
      // A queued act change lands ONLY on a bar line, masked by a stinger.
      if (s === 0 && pendingAct !== null && pendingAct !== act) {
        act = pendingAct; pendingAct = null;
        applyMix(ACTS[act], 2.2);
        stinger(nextT);
      }
      const A = ACTS[act];
      if (A.pulse > 0 && s % 4 === 0) note("pulse", noteHz(0, -1), nextT, .18, { type: "sine", gain: A.pulse });
      if (A.arp > 0) {
        // Arpeggiate fast enough that the ear fuses it into a chord — the
        // chiptune phantom-chord trick, here just to keep the texture thin.
        const deg = [0, 2, 4, 6, 4, 2][step % 6];
        note("arp", noteHz(deg, 1), nextT, .22, { type: "square", gain: A.arp * .5, q: 1800 });
      }
      if (A.lead > 0) {
        // Motif transformations: fragmentation early (opening cell only),
        // full statement mid-film, augmentation at the close.
        const barIn = Math.floor(step / STEPS_PER_BAR) % 4;
        const aug = act >= 11 ? 2 : 1;
        const frag = act <= 2;
        for (const n of MOTIF) {
          if (frag && n.t > 2) continue;
          if (n.t === s && barIn % 2 === 0)
            note("lead", noteHz(n.d, 0), nextT, n.len * stepDur() * aug * .9,
                 { type: "triangle", gain: A.lead });
        }
      }
      nextT += stepDur();
      step++;
    }
  }

  function stinger(t) {
    // A short punctuation phrase at the boundary. Stingers only read correctly
    // when a bed is already playing, because their position is derived from the
    // active tempo grid — which is exactly why this is called from the scheduler.
    note("lead", noteHz(4, 1), t, .5, { type: "sine", gain: .16 });
    note("lead", noteHz(0, 1), t + stepDur(), .7, { type: "sine", gain: .12 });
  }

  function applyMix(A, sec) {
    // EQUAL-POWER: these layers are uncorrelated, so gains move on a cos/sin
    // curve. A linear fade between them would dip -3dB through the middle.
    for (const k of ["pad", "sub", "arp", "lead", "air", "pulse"]) {
      const target = A[k];
      const g = bus[k] && bus[k].gain;
      if (g) ramp(g, Math.sin(Math.min(1, target / .45) * Math.PI / 2) * target, sec);
    }
  }

  function start() {
    if (on) return true;
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return false;
    try { ctx = new AC(); } catch (e) { return false; }
    on = true;
    master = ctx.createGain(); master.gain.value = 0; master.connect(ctx.destination);
    if (ctx.state === "suspended") ctx.resume();     // never awaited
    ramp(master.gain, .9, 1.6);

    for (const k of ["pad", "sub", "arp", "lead", "air", "pulse", "sfx"]) {
      bus[k] = ctx.createGain(); bus[k].gain.value = 0; bus[k].connect(master);
    }
    bus.sfx.gain.value = .9;

    // pad — two sines a fifth apart, the harmonic floor
    for (const m of [0, 7]) {
      const o = ctx.createOscillator(); o.type = "sine";
      o.frequency.value = ROOT * Math.pow(2, m / 12) * 2;
      const g = ctx.createGain(); g.gain.value = .5;
      o.connect(g).connect(bus.pad); o.start();
    }
    // sub
    const sub = ctx.createOscillator(); sub.type = "sine"; sub.frequency.value = ROOT / 2;
    sub.connect(bus.sub); sub.start();
    // air — filtered brown noise
    const air = ctx.createBufferSource(); air.buffer = brown(5); air.loop = true;
    const af = ctx.createBiquadFilter(); af.type = "lowpass"; af.frequency.value = 620;
    air.connect(af).connect(bus.air); air.start();
    bus.airFilter = af;

    step = 0; nextT = ctx.currentTime + .12;
    applyMix(ACTS[act], .8);
    timer = setInterval(schedule, TICK_MS);   // tops up the horizon only
    return true;
  }

  /** SFX, quantised onto the next eighth so punctuation never fights the meter. */
  function sfx(kind) {
    if (!on) return;
    const t = Math.max(ctx.currentTime + .02, nextT);
    if (kind === "mote")  note("sfx", noteHz(2 + (step % 5), 2), t, .16, { type: "sine", gain: .05, q: 4000 });
    else if (kind === "edge")  note("sfx", noteHz(4, 2), t, .12, { type: "triangle", gain: .05 });
    else if (kind === "group") { note("sfx", noteHz(0, 1), t, 1.4, { type: "sine", gain: .14 });
                                 note("sfx", noteHz(2, 1), t + .06, 1.3, { type: "sine", gain: .10 });
                                 note("sfx", noteHz(4, 1), t + .12, 1.2, { type: "sine", gain: .09 }); }
    else if (kind === "seam")  note("sfx", noteHz(6, 2), t, .9, { type: "sine", gain: .08, glide: 1.5 });
    else if (kind === "doubt") { note("sfx", noteHz(1, 0), t, 1.1, { type: "sawtooth", gain: .10, glide: .82 });
                                 if (voices < CAP) { voices++;
                                   const s2 = ctx.createBufferSource(); s2.buffer = brown(1);
                                   const bp = ctx.createBiquadFilter(); bp.type = "bandpass";
                                   bp.frequency.value = 1100; bp.Q.value = 5;
                                   const g2 = ctx.createGain();
                                   g2.gain.setValueAtTime(.0001, t);
                                   g2.gain.linearRampToValueAtTime(.09, t + .1);
                                   g2.gain.exponentialRampToValueAtTime(.0001, t + .9);
                                   s2.connect(bp).connect(g2).connect(bus.sfx);
                                   s2.start(t); s2.stop(t + 1);
                                   retire(s2, [s2, bp, g2]); } }
  }

  return {
    start, sfx,
    /** Queue an act. Applied on the next bar line, never mid-phrase. */
    setAct(i) { if (i !== act) pendingAct = i; },
    /** Intensity director, kept separate from the act/pacing director. */
    intensity(v) {
      if (!on) return;
      if (bus.airFilter) ramp(bus.airFilter.frequency, 620 - v * 300, 1.5);
      ramp(master.gain, .9 - v * .12, 1.2);
    },
    mute(m) { if (on) ramp(master.gain, m ? 0 : .9, .5); },
    get on() { return on; },
  };
})();

(function(){
