VIZ_JS = '''
(function() {
  const input = document.getElementById('search');
  let activeProject = null;

  function apply() {
    const q = (input.value || '').trim().toLowerCase();
    const activeTypes = [...document.querySelectorAll('.chip[data-filter-type].active')].map(c => c.dataset.filterType);
    const activeTags = [...document.querySelectorAll('.chip[data-filter-tag].active')].map(c => c.dataset.filterTag);
    let visible = 0;
    document.querySelectorAll('.entry-card').forEach(card => {
      const type = card.dataset.type;
      const hasTags = card.hasAttribute('data-tags') && card.dataset.tags;
      const tags = hasTags ? card.dataset.tags.split('|') : [];
      const text = card.dataset.search || '';
      const typeOk = activeTypes.length === 0 || activeTypes.includes(type);
      const tagOk = activeTags.length === 0 || !hasTags || activeTags.some(t => tags.includes(t));
      const textOk = !q || text.includes(q);
      const projectOk = !activeProject || card.dataset.project === activeProject;
      const show = typeOk && tagOk && textOk && projectOk;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    const empty = document.getElementById('empty-state');
    if (empty) empty.classList.toggle('show', visible === 0);
    const banner = document.getElementById('active-project-banner');
    if (banner) {
      banner.classList.toggle('show', !!activeProject);
      const nameEl = document.getElementById('active-project-name');
      if (nameEl && activeProject) {
        const btn = document.querySelector('.bar-row-btn[data-filter-project="' + activeProject + '"]');
        nameEl.textContent = btn ? btn.dataset.projectLabel : activeProject;
      }
    }
  }

  function clearFiltersAndSearch() {
    input.value = '';
    document.querySelectorAll('.chip.active').forEach(c => c.classList.remove('active'));
    document.querySelectorAll('.bar-row-btn.active').forEach(b => b.classList.remove('active'));
    activeProject = null;
  }

  function showBrowse() {
    const panel = document.getElementById('browse-panel');
    const toggle = document.getElementById('browse-toggle-wrap');
    if (panel) panel.classList.add('show');
    if (toggle) toggle.style.display = 'none';
  }

  window.__jumpTo = function(id) {
    clearFiltersAndSearch();
    apply();
    showBrowse();
    requestAnimationFrame(() => {
      const el = document.getElementById(id);
      if (!el) return;
      el.style.display = '';
      el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      el.classList.add('highlight');
      setTimeout(() => el.classList.remove('highlight'), 2200);
    });
  };

  document.addEventListener('click', (e) => {
    const jumper = e.target.closest('[data-jump]');
    if (jumper) { e.preventDefault(); window.__jumpTo(jumper.dataset.jump); }
  });

  input && input.addEventListener('input', apply);
  document.querySelectorAll('.chip[data-filter-type], .chip[data-filter-tag]').forEach(chip => {
    chip.addEventListener('click', () => { chip.classList.toggle('active'); apply(); });
  });
  document.querySelectorAll('.bar-row-btn[data-filter-project]').forEach(btn => {
    btn.addEventListener('click', () => {
      const p = btn.dataset.filterProject;
      const turningOn = activeProject !== p;
      document.querySelectorAll('.bar-row-btn.active').forEach(b => b.classList.remove('active'));
      activeProject = turningOn ? p : null;
      if (turningOn) btn.classList.add('active');
      showBrowse();
      apply();
    });
  });
  const clearProjectBtn = document.getElementById('clear-project-filter');
  if (clearProjectBtn) clearProjectBtn.addEventListener('click', () => {
    activeProject = null;
    document.querySelectorAll('.bar-row-btn.active').forEach(b => b.classList.remove('active'));
    apply();
  });
  const browseToggle = document.getElementById('browse-toggle');
  if (browseToggle) browseToggle.addEventListener('click', showBrowse);
  apply();

  const toggleBtn = document.getElementById('table-toggle');
  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      const table = document.getElementById('growth-table');
      const chart = document.getElementById('growth-chart');
      const showingTable = table.classList.toggle('show');
      chart.classList.toggle('hide', showingTable);
      toggleBtn.textContent = showingTable ? 'Show chart' : 'Show table';
    });
  }

  const svg = document.getElementById('growth-svg');
  if (svg && window.__timeline) {
    const data = window.__timeline;
    const tooltip = document.getElementById('chart-tooltip');
    const guide = document.getElementById('chart-guide');
    const dot = document.getElementById('chart-dot');
    const overlay = document.getElementById('chart-overlay');
    overlay.addEventListener('mousemove', (e) => {
      const rect = overlay.getBoundingClientRect();
      const frac = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
      const idx = Math.round(frac * (data.dates.length - 1));
      const x = data.xs[idx], y = data.ys[idx];
      guide.setAttribute('x1', x); guide.setAttribute('x2', x);
      dot.setAttribute('cx', x); dot.setAttribute('cy', y);
      guide.style.opacity = 1; dot.style.opacity = 1;
      tooltip.style.opacity = 1;
      tooltip.style.left = (rect.left + x) + 'px';
      tooltip.style.top = (rect.top + y) + 'px';
      tooltip.textContent = data.dates[idx] + ' — ' + data.counts[idx] + ' lessons';
    });
    overlay.addEventListener('mouseleave', () => {
      guide.style.opacity = 0; dot.style.opacity = 0; tooltip.style.opacity = 0;
    });
  }
})();
'''


def _render_growth_chart(lessons: list) -> str:
    dated = sorted([l["date"] for l in lessons if l["date"]])
    if not dated:
        return "", ""
    from collections import Counter
    counts = Counter(dated)
    dates = sorted(counts)
    cum, total = [], 0
    for d in dates:
        total += counts[d]
        cum.append(total)
    W, H, PAD = 640, 160, 24
    n = len(dates)
    xs = [PAD + (i / max(1, n - 1)) * (W - 2 * PAD) for i in range(n)]
    top = max(cum) or 1
    ys = [H - PAD - (c / top) * (H - 2 * PAD) for c in cum]
    path = "M " + " L ".join(f"{x:.1f},{y:.1f}" for x, y in zip(xs, ys))
    area = path + f" L {xs[-1]:.1f},{H-PAD} L {xs[0]:.1f},{H-PAD} Z"
    svg = f'''<div style="position:relative">
  <svg id="growth-svg" viewBox="0 0 {W} {H}" style="width:100%;height:auto;display:block" role="img" aria-label="Lessons learned over time">
    <line x1="{PAD}" y1="{H-PAD}" x2="{W-PAD}" y2="{H-PAD}" stroke="var(--grid)" stroke-width="1"/>
    <path d="{area}" fill="var(--series-lesson)" fill-opacity="0.12" stroke="none"/>
    <path d="{path}" fill="none" stroke="var(--series-lesson)" stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="{xs[-1]:.1f}" cy="{ys[-1]:.1f}" r="4" fill="var(--series-lesson)"/>
    <text x="{xs[-1]-6:.1f}" y="{ys[-1]-10:.1f}" text-anchor="end" font-size="11" fill="var(--text-secondary)">{total} total</text>
    <line id="chart-guide" x1="0" y1="{PAD}" x2="0" y2="{H-PAD}" stroke="var(--text-muted)" stroke-width="1" style="opacity:0"/>
    <circle id="chart-dot" r="4" fill="var(--series-lesson)" stroke="var(--surface-1)" stroke-width="2" style="opacity:0"/>
    <rect id="chart-overlay" x="0" y="0" width="{W}" height="{H}" fill="transparent"/>
  </svg>
  <div id="chart-tooltip"></div>
</div>'''
    table = ['<table class="viz-table" id="growth-table"><thead><tr><th>Date</th>'
            '<th>New that day</th><th>Total so far</th></tr></thead><tbody>']
    for d, c in zip(dates, cum):
        table.append(f"<tr><td>{_esc(d)}</td><td>{counts[d]}</td><td>{c}</td></tr>")
    table.append("</tbody></table>")
    timeline_json = json.dumps({
        "dates": dates, "counts": [counts[d] for d in dates], "xs": xs, "ys": ys,
    })
    return svg + "".join(table), timeline_json


def _render_project_bars(lessons: list) -> str:
    from collections import Counter
    counts = Counter((l["project"], l["project_slug"]) for l in lessons)
    top = counts.most_common(10)
    if not top:
        return "<p class='sub'>No lessons yet.</p>"
    maxc = top[0][1]
    rows = []
    for (name, slug), c in top:
        pct = max(6, round(c / maxc * 100))
        rows.append(f'''<button class="bar-row-btn" data-filter-project="{_esc(slug)}" data-project-label="{_esc(name)}">
      <div class="bar-label" title="{_esc(name)}">{_esc(name)}</div>
      <div class="bar-track"><div class="bar-fill" style="width:{pct}%"></div></div>
      <div class="bar-value">{c}</div>
    </button>''')
    more = len(counts) - len(top)
    footer = f'<p class="sub" style="margin-top:10px">+{more} more project(s)</p>' if more > 0 else ""
    return (f'<div class="bars">{"".join(rows)}</div>{footer}'
            '<p class="sub" style="margin-top:10px">Click a project to see just its lessons.</p>')


def _spotlight_row(e: dict) -> str:
    badge = f'<span class="spotlight-badge">🔗 {e["degree"]}</span>' if e.get("degree") else ""
    return (f'<button class="spotlight-row" data-jump="{e["dom_id"]}">'
           f'<span class="spotlight-dot {e["type"]}"></span>'
           f'<span class="spotlight-label">{_esc(_short_label(e))}</span>{badge}</button>')


def _render_spotlight(lessons: list, ideas: list, tensions: list) -> str:
    recent = sorted([l for l in lessons if l["date"]], key=lambda l: l["date"],
                    reverse=True)[:6]
    pool = [e for e in lessons + ideas + tensions if e.get("degree")]
    connected = sorted(pool, key=lambda e: -e["degree"])[:8]
    if not recent and not connected:
        return ""
    recent_html = ("".join(_spotlight_row(l) for l in recent) if recent
                  else "<p class='sub'>No dated lessons yet.</p>")
    connected_html = ("".join(_spotlight_row(e) for e in connected) if connected
                      else "<p class='sub'>Nothing cross-referenced yet — "
                           "connections appear as entries start citing each other.</p>")
    return f'''<section class="card">
  <h2>Where to start</h2>
  <p class="sub">A curated slice, not everything at once</p>
  <div class="spotlight-grid">
    <div>
      <h3 style="font-size:0.95rem;margin:0 0 8px">🕒 Recently learned</h3>
      <div class="spotlight-list">{recent_html}</div>
    </div>
    <div>
      <h3 style="font-size:0.95rem;margin:0 0 8px">🔗 Well-connected</h3>
      <div class="spotlight-list">{connected_html}</div>
    </div>
  </div>
</section>'''



