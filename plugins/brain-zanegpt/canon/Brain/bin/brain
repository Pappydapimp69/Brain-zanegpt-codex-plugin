def _film_html() -> str:
    d = _film_payload()
    tl = d["timeline"]
    first_n = tl[0][1] if tl else 0
    subs = {
        "__DATA__": json.dumps(d, separators=(",", ":")),
        "__LESSONS__": str(d["lessons"]),
        "__PROJECTS__": str(d["projects"]),
        "__VERIFIED__": str(d["verified"]),
        "__UNVERIFIED__": str(d["unverified"]),
        "__FIRSTN__": ("three" if first_n == 3 else str(first_n)),
        "__FIRSTDATE__": tl[0][0] if tl else "—",
        "__LASTDATE__": tl[-1][0] if tl else "—",
        "__EDGES__": str(d["edgeTotal"]),
        "__SAFE__": str(d["safeTotal"]),
        "__INFERRED__": str(d["inferredTotal"]),
        "__BIG__": str(d["groups"][0] if d["groups"] else 0),
        "__NGROUPS__": str(len(d["groups"])),
        "__SEAMS__": f'{d["seamTotal"]:,}',
        "__SEAMA__": d["seams"][0][0] if d["seams"] else "—",
        "__SEAMB__": d["seams"][0][1] if d["seams"] else "—",
        "__SEAMTAGS__": str(d["seams"][0][2] if d["seams"] else 0),
        "__TOPEN__": str(d["tensions"]["open"]),
        "__OPENLIST__": " <br>".join(
            f'<span class="mono">{html.escape(t[0])}</span> &middot; '
            f"{html.escape(_ellipsize(t[1], 60))}" for t in d["openList"]),
    }
    page = FILM_HTML
    for k, v in subs.items():
        page = page.replace(k, v)
    return page


def cmd_film() -> int:
    """Render the system's own story as a short animated film."""
    require_link()
    ensure_cache(pull=True)
    out = None
    if "--out" in ARGS:
        out = ARGS[ARGS.index("--out") + 1]
    out = out or os.path.join(project_root(), "brain-film.html")
    write(out, _film_html())
    if "--no-open" not in ARGS:
        try:
            webbrowser.open("file://" + os.path.abspath(out))
        except Exception:
            pass
    return ok(f"film → {out}")


def cmd_viz() -> int:
    # `viz --film` is the animated telling of the same canon the static page
    # shows; they read the same data and neither is authoritative over the other.
    if "--film" in ARGS:
        return cmd_film()
    require_link()
    ensure_cache(pull=True)
    lessons = _viz_lessons()
    ideas = _viz_ideas()
    tensions = _viz_tensions()
    _build_graph(lessons, ideas, tensions)
    open_tensions = [t for t in tensions if t["status"] == "🔴"]
    projects = {l["project"] for l in lessons}

    spotlight_section = _render_spotlight(lessons, ideas, tensions)
    growth_html, timeline_json = _render_growth_chart(lessons)
    growth_section = ""
    if growth_html:
        growth_section = f'''<section class="card">
  <h2>How the memory has grown</h2>
  <p class="sub">Lessons learned, counted over time</p>
  <div class="chart-toolbar"><button class="ghost-btn" id="table-toggle">Show table</button></div>
  <div id="growth-chart">{growth_html}</div>
</section>'''

    bars_html = _render_project_bars(lessons)

    all_tags = {}
    for l in lessons:
        for t in l["tags"]:
            all_tags[t.lower()] = all_tags.get(t.lower(), 0) + 1
    top_tags = sorted(all_tags.items(), key=lambda kv: -kv[1])[:14]
    tag_chips = "".join(
        f'<button class="chip" data-filter-tag="{_esc(t)}">{_esc(t)} ({n})</button>'
        for t, n in top_tags)

    cards = ([_render_lesson_card(l) for l in lessons]
            + [_render_idea_card(i) for i in ideas]
            + [_render_tension_card(t) for t in tensions])

    html_out = f'''<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Brain — what the system knows</title>
<style>{VIZ_CSS}</style>
</head>
<body>
<div class="wrap">
  <header class="hero">
    <h1>🧠 Brain</h1>
    <p>Everything this system has learned, imagined, and is still figuring out.</p>
    <p class="generated">Generated {_esc(date.today().isoformat())}</p>
  </header>

  <div class="stat-grid">
    <div class="stat-tile t-lesson"><div class="value">{len(lessons)}</div><div class="label">Lessons learned</div></div>
    <div class="stat-tile t-idea"><div class="value">{len(ideas)}</div><div class="label">Ideas &amp; sparks</div></div>
    <div class="stat-tile t-tension"><div class="value">{len(open_tensions)}</div><div class="label">Open questions</div></div>
    <div class="stat-tile"><div class="value">{len(projects)}</div><div class="label">Projects contributing</div></div>
  </div>

  {spotlight_section}

  {growth_section}

  <section class="card">
    <h2>Where the lessons came from</h2>
    <p class="sub">Projects that have contributed the most</p>
    {bars_html}
  </section>

  <div class="browse-toggle-wrap" id="browse-toggle-wrap">
    <button class="browse-toggle" id="browse-toggle">Browse everything ({len(cards)})</button>
  </div>

  <section id="browse-panel">
    <div class="active-project-banner" id="active-project-banner">
      Showing lessons from <strong id="active-project-name"></strong>
      <button id="clear-project-filter">Clear</button>
    </div>
    <div class="filter-bar">
      <input type="search" id="search" placeholder="Search everything…">
      <button class="chip" data-filter-type="lesson">📘 Lessons</button>
      <button class="chip" data-filter-type="idea">💡 Ideas</button>
      <button class="chip" data-filter-type="tension">🧭 Open Questions</button>
    </div>
    <div class="chip-row">{tag_chips}</div>
    <div class="entry-grid">{"".join(cards)}</div>
    <div class="empty-state" id="empty-state">Nothing matches that search — try another word or clear the filters.</div>
  </section>

  <footer>Generated by <code>brain viz</code> · read-only snapshot of the shared knowledge base</footer>
</div>
<script>window.__timeline = {timeline_json or "null"};</script>
<script>{VIZ_JS}</script>
</body>
</html>'''

    out = None
    if "--out" in ARGS:
        out = ARGS[ARGS.index("--out") + 1]
    out = os.path.abspath(out) if out else os.path.join(project_root(),
                                                         "brain-viz.html")
    write(out, html_out)
    try:
        webbrowser.open("file://" + out)
    except Exception:
        pass
    return ok(f"generated {out} ({len(lessons)} lessons, {len(ideas)} ideas, "
              f"{len(open_tensions)} open questions)")


# ============================================================= analytics
# All read-only. These derive new *views* over canon that is already written;
# nothing here mutates memory or ideas. The data was always there — these just
# give it a use. See PROTOCOL.md "analyze" section.

_STOP = frozenset((
    "the a an and or but for nor so yet of to in on at by is it as be if no not "
    "with from into onto over than that this these those then once when while each "
    "any all its their your you own only just can cannot must never always more most "
    "less least even also both either neither one two per via etc eg ie vs whether "
    "which what whom whose how why where does do did done being been has have had "
    "will would should could may might are was were them they he she his her our "
    "we us out up down off about after before between within without across against "
    "same other another such new old first last next thing things some many few "
    "much very often rather still around near far itself something anything nothing "
    "everything someone anyone everyone somewhere anywhere everywhere"
).split())


def _analyze_bases() -> list[str]:
    bases = []
    m = node("memory")
    if os.path.isdir(os.path.join(m, "projects")):
        bases.append(m)
    lm = os.path.join(local_root(), "memory")
    if os.path.isdir(os.path.join(lm, "projects")):
        bases.append(lm)
    return bases


def _shared_bases() -> list[str]:
    """Training and the new half's picker aim only at approved canon: the shared
    memory node. The local store holds lessons that have not passed the steward
    yet, and a pick or Composed edge built on one would point at nothing in the
    repo once filed."""
    m = os.path.abspath(node("memory"))
    return [b for b in _analyze_bases() if os.path.abspath(b) == m]


def _field(block: str, label: str) -> str:
    """Value of a `- Label: ...` field, joined across wrapped lines up to the
    next field bullet. Label match is prefix-based so 'provenance' catches
    'Provenance (verified/assumed)' and 'where/why' catches the full label."""
    lab = label.lower()
    out, capturing = [], False
    for ln in block.splitlines():
        s = ln.strip()
        m = re.match(r"^-\s*([^:]+):\s*(.*)$", s)
        if m and m.group(1).strip().lower().startswith(lab):
            capturing = True
            if m.group(2):
                out.append(m.group(2))
            continue
        if capturing:
            if re.match(r"^-\s*[^:]+:", s) or s.startswith("## "):
                break
            out.append(s)
    return " ".join(out).strip()


def _tags_of(block: str) -> list[str]:
    line = _field(block, "tags")
    return re.findall(r"\[([a-z0-9._-]+)\]", line)


def _load_entries(bases: list[str]) -> list[dict]:
    """Every promoted lesson across the given canon bases, parsed into fields."""
    out = []
    for base in bases:
        pdir = os.path.join(base, "projects")
        if not os.path.isdir(pdir):
            continue
        scope = "local" if base != node("memory") else "shared"
        for fn in sorted(os.listdir(pdir)):
            if not fn.endswith(".md"):
                continue
            text = read(os.path.join(pdir, fn))
            for block in _blocks(text, "## E"):
                head = block.splitlines()[0]
                m = re.match(r"##\s*(E\d+)", head)
                if not m:
                    continue
                out.append({
                    "file": fn, "scope": scope, "id": m.group(1),
                    "block": block,
                    "tags": _tags_of(block),
                    "provenance": _field(block, "provenance"),
                    "rule": _field(block, "rule of thumb"),
                    "gotright": _field(block, "got right"),
                    "date": _field(block, "date"),
                    "tier": _entry_tier(block),
                })
    return out


# Trust tiers (train verification, phase 2). Derived ONLY from the review lines
# the memory steward appends to an entry (`- Audited:` / `- Reverified:`, see
# memory/REVIEW-TEMPLATE.md) — never from a field an author can type.
TIER_ORDER = ("disputed", "confirmed", "modeled", "audited", "composed", "provisional")
# `- Cited-by:` (memory/scripts/cited_by.py): written when a NEW lesson named
# this entry in Composed:. Fields: date · citing entry · polarity · sandbox or
# 'no sandbox' · observed … · link.
_CITED_LINE_RE = re.compile(r"^-\s*Cited-by\s*:\s*(\S*)\s*·\s*(projects/\S+#E\d+)\s*·\s*"
                            r"(\w+)\s*·\s*(sandboxes/\S+\.py|no sandbox)", re.M)


def _entry_cited_by(block: str) -> list[tuple[str, str, str, str]]:
    """(date, citing ref, polarity, sandbox or '') for each Cited-by line."""
    return [(d, ref, pol.lower(), "" if sb == "no sandbox" else sb)
            for d, ref, pol, sb in _CITED_LINE_RE.findall(block)]
_STEWARD_LINE_RE = re.compile(r"^-\s*(?:Audited|Reverified|Cited-by)\s*:.*$", re.M)
_REVIEW_LINE_RE = re.compile(r"^-\s*(Audited|Reverified)\s*:\s*[^·]*·\s*(\w+)"
                             r"(?:\s*·\s*(sandboxes/\S+\.py))?", re.M)


def _entry_reviews(block: str) -> list[tuple[str, str, str]]:
    """(kind, verdict, sandbox) for each review line on an entry."""
    return [(k.lower(), v.lower(), sb or "")
            for k, v, sb in _REVIEW_LINE_RE.findall(block)]


def _entry_tier(block: str) -> str:
    revs = _entry_reviews(block)
    verdicts = {(k, v) for k, v, _ in revs}
    if any(v == "fail" for _, v in verdicts):
        return "disputed"
    if ("reverified", "pass") in verdicts:
        return "confirmed"
    if ("audited", "modeled") in verdicts:
        return "modeled"
    if ("audited", "pass") in verdicts:
        return "audited"
    # built on by a later lesson whose own sandbox passed: not a test of this
    # claim, but a build that assumed it and held — one step above untested
    if any(sb and pol == "compatible" for _, _, pol, sb in _entry_cited_by(block)):
        return "composed"
    return "provisional"


def _entry_citations(entries: list[dict], idx: dict) -> dict:
    """(file, 'E<n>') -> how many OTHER entries name it in `Composed:`. The
    entry-level impact signal: a lesson others were built on costs more when
    it is wrong, so it is first in line for an expensive rebuild."""
    cites = {}
    for e in entries:
        comp = _field(e["block"], "composed")
        if not comp:
            continue
        for slug, eid in re.findall(r"([a-z0-9][a-z0-9_.-]*?)(?:\.md)?[/#](E\d+)",
                                    comp, re.I):
            f = _resolve_slug(slug, idx)
            if f and (f, eid) != (e["file"], e["id"]):
                cites[(f, eid)] = cites.get((f, eid), 0) + 1
    return cites


_BROAD_RULE_RE = re.compile(r"\b(always|never|every)\b", re.I)


# --- weakest-link ranking -------------------------------------------------
# `train` used to hand back the strongest-looking item every time (most-cited
# entry, most-shared-tags pair), so the same family kept winning and the pick
# only moved when a session happened to change that one item. The rankings
# below sort the WEAKEST link first instead, so every completed pass lifts
# that link and the top pick moves on by itself:
#   audit / rebuild : the family with the lowest review coverage first
#   edge / combined / group / default : the pair whose least-connected system
#                     has the fewest edges first
#   kernel gaps     : the domain with the fewest applied kernels first
# Ties fall back to the old signals (sandbox, citations, shared tags).

_DATE_SEG_RE = re.compile(r"\d{4}-\d{2}-\d{2}")


def _family(fname: str) -> str:
    """Coarse system family of a project file, from its name alone: drop the
    owner prefix and any date segment, keep the first two hyphen words
    ('local__2026-10-03__age-cutoff-2lag-flat-...' -> 'age-cutoff',
    'pappydapimp69__tiktok-shop.md' -> 'tiktok-shop'). Files in one family are
    one body of work for the weakest-link ranking."""
    stem = fname[:-3] if fname.endswith(".md") else fname
    segs = [x for x in stem.split("__")[1:] if not _DATE_SEG_RE.fullmatch(x)] or [stem]
    return "-".join(segs[0].split("-")[:2])


def _family_coverage(entries, kind="any", extra=()) -> dict:
    """family -> share of its shared entries that carry a review line
    (kind='any': Audited or Reverified; kind='reverified': a blind rebuild).
    `extra` = (file, id) pairs with a review still pending, counted as reviewed.
    The lower the share, the weaker the family's evidence."""
    total, got = {}, {}
    for e in entries:
        if e["scope"] != "shared":
            continue
        fam = _family(e["file"])
        total[fam] = total.get(fam, 0) + 1
        revs = _entry_reviews(e["block"])
        if (revs if kind == "any" else any(k == "reverified" for k, _v, _s in revs)) \
                or (e["file"], e["id"]) in extra:
            got[fam] = got.get(fam, 0) + 1
    return {f: got.get(f, 0) / n for f, n in total.items()}


def _edge_degree(edges) -> dict:
    """system file -> number of co-verification edges it has."""
    deg = {}
    for (a, b) in edges:
        deg[a] = deg.get(a, 0) + 1
        deg[b] = deg.get(b, 0) + 1
    return deg


def _weakest_link_order(cand, edges):
    """Re-rank seam candidates (score, shared_n, a, b, shared) so the pair with
    the least-connected system comes first; shared-tag score breaks ties."""
    deg = _edge_degree(edges)
    return sorted(cand, key=lambda c: (min(deg.get(c[2], 0), deg.get(c[3], 0)),
                                       -c[0], c[2], c[3]))


def _slug_index(bases: list[str]) -> dict:
    """Map every reasonable slug spelling of a project file to its filename,
    so a prose ref like 'astar-replan/E2' or 'loot-pity' resolves to a file."""
    idx = {}
    for base in bases:
        pdir = os.path.join(base, "projects")
        if not os.path.isdir(pdir):
            continue
        for fn in sorted(os.listdir(pdir)):
            if not fn.endswith(".md"):
                continue
            stem = fn[:-3]
            keys = {stem}
            if "__" in stem:
                keys.add(stem.split("__", 1)[1])          # sandbox-astar-replan
            for k in list(keys):
                if k.startswith("sandbox-"):
                    keys.add(k[len("sandbox-"):])          # astar-replan
            for k in keys:
                idx.setdefault(k, fn)
    return idx


def _resolve_slug(slug: str, idx: dict) -> str | None:
    slug = slug.strip().lower()
    if slug in idx:
        return idx[slug]
    # suffix fallback for short names ('recursion' -> the-game-the-recursion),
    # but only on a hyphen boundary: without it 'finding' matched
    # dog-pathfinding and 'verb' matched the project 'b'
    cands = {f for k, f in idx.items()
             if k.endswith("-" + slug) or slug.endswith("-" + k)}
    return next(iter(cands)) if len(cands) == 1 else None


# --- ideas kernels as graph vertices ----------------------------------------
# A memory entry can name the idea kernels it applied, in its `Composed:` field
# (`ideas:SONGWRITING/rhyme-tooling/two-pass-letter-assignment-keeps-schemes-
# legible`), and a new kernel can name the kernels it joins with a `- Linked:`
# line. Both are DECLARED edges whose kernel end is a vertex `ideas:<path>`.
# A kernel header merely quoted in prose is mined too, but only ever as an
# INFERRED edge to the entry that quotes it: tension T26 is open precisely
# because a quoted example reads like a composition. Existing kernels cannot
# gain a `Linked:` line (ideas canon is append-only), so the junction for old
# kernels is memory's `Composed:` field.

_KERNEL_IDX: dict = {}
_UNRESOLVED_KERNEL_REFS: set = set()


def _kernel_canon(raw: str) -> str:
    return "/".join(seg.strip() for seg in raw.split("/") if seg.strip())


def _kernel_index() -> dict:
    """lowercased kernel path -> canonical path, for every ideas kernel."""
    path = os.path.join(node("ideas"), "idea-repository.md")
    if path not in _KERNEL_IDX:
        idx = {}
        if os.path.isfile(path):
            for m in re.finditer(r"^##\s*\[([^\]]+)\]\s*$", read(path), re.M):
                canon = _kernel_canon(m.group(1))
                idx[canon.lower()] = canon
        _KERNEL_IDX[path] = idx
    return _KERNEL_IDX[path]


def _resolve_kernel(ref: str) -> str | None:
    """The exact kernel path, or a prefix ending on a segment boundary that
    matches exactly ONE kernel. Unknown or ambiguous -> None, never a guess."""
    key = _kernel_canon(re.sub(r"^ideas:", "", ref.strip(), flags=re.I)
                        .strip("[] ")).lower()
    if not key:
        return None
    idx = _kernel_index()
    if key in idx:
        return idx[key]
    hits = [c for k, c in idx.items() if k.startswith(key + "/")]
    return hits[0] if len(hits) == 1 else None


def _kernel_vertex(canon: str) -> str:
    return "ideas:" + canon


def _declared_kernel_refs(value: str) -> tuple[set[str], str]:
    """Pull `ideas:` refs out of a Composed/Linked value. Returns the kernel
    vertices and the value with those refs removed, so the remainder can go
    through the memory slug parser untouched."""
    found = set()
    pat = r"ideas:\s*(\[[^\]]+\]|[^,\s]+)"
    for m in re.finditer(pat, value, re.I):
        canon = _resolve_kernel(m.group(1))
        if canon:
            found.add(_kernel_vertex(canon))
        else:
            _UNRESOLVED_KERNEL_REFS.add(m.group(1).strip())
    return found, re.sub(pat, " ", value, flags=re.I)


def _kernel_prose_refs(block: str) -> set[str]:
    """Kernel headers quoted in prose. Only ones that resolve to a real kernel
    count, so template placeholders like `[DOMAIN / sub / kw / kw]` drop out."""
    found = set()
    for m in re.finditer(r"\[([A-Z][A-Z0-9-]+(?:\s*/\s*[^\]/\n]+)+)\]", block):
        canon = _resolve_kernel(m.group(1))
        if canon:
            found.add(_kernel_vertex(canon))
    return found


def _idea_compositions() -> list[dict]:
    """Canon kernels carrying a `- Linked:` line, shaped like memory entries
    so the graph builder can treat a kernel as the source of its own edges."""
    path = os.path.join(node("ideas"), "idea-repository.md")
    if not os.path.isfile(path):
        return []
    out = []
    for block in _blocks(read(path), "## ["):
        m = re.match(r"##\s*\[([^\]]+)\]", block)
        if not m or not _field(block, "linked"):
            continue
        out.append({"file": _kernel_vertex(_kernel_canon(m.group(1))),
                    "scope": "shared", "id": "K", "block": block,
                    "tags": set(), "gotright": ""})
    return out


def _composed_refs(entry: dict, idx: dict) -> set[str]:
    """Which OTHER system-files this entry was co-verified against. Prefers an
    explicit `Composed:` field (parseable, future-proof); else mines prose refs
    (`slug/E<n>`, `slug's ... (E<n>)`, `slug.md#E<n>`)."""
    block, own = entry["block"], entry["file"]
    files = set()
    linked = _field(block, "linked")
    if linked:
        # an ideas kernel's `Linked:` names only kernels, so the `ideas:`
        # prefix is optional there — the same rule the ideas validator applies,
        # or a ref it passes would be silently dropped here
        if not re.fullmatch(r"(n/?a|none|—|-)\.?", linked.strip(), re.I):
            for ref in re.findall(r"(?:ideas:\s*)?(\[[^\]]+\]|[^,\s]+)",
                                  linked, re.I):
                canon = _resolve_kernel(ref)
                if canon:
                    files.add(_kernel_vertex(canon))
                else:
                    _UNRESOLVED_KERNEL_REFS.add(ref.strip())
        files.discard(own)
        return files
    composed = _field(block, "composed")
    if composed:
        kernels, composed = _declared_kernel_refs(composed)
        files |= kernels
        for tok in re.split(r"[,\s]+", composed):
            # only a path-shaped token is a ref (`slug/E12`, `slug/entry-title`,
            # `file.md#E3`). A bare word in an explanatory note — "N/A (settles
            # tension T19 directly …)" — is prose, and used to become an edge
            # to any project whose name matched it
            tok = tok.strip("()[]{}.,;:'\"")
            if "/" not in tok and "#" not in tok:
                continue
            slug = re.split(r"[/#]", tok)[0]
            slug = re.sub(r"\.md$", "", slug)
            f = _resolve_slug(slug, idx) if slug else None
            if f:
                files.add(f)
    else:
        # steward-appended lines (`- Audited:` / `- Reverified:` / `- Cited-by:`)
        # name other entries by path; they are write-backs, not this entry's
        # own compositions, and would read as reverse edges here
        block = _STEWARD_LINE_RE.sub("", block)
        for slug in re.findall(r"([a-z][a-z0-9-]{2,})/E\d+", block):
            f = _resolve_slug(slug, idx)
            if f:
                files.add(f)
        for slug in re.findall(r"([a-z][a-z0-9-]{2,})'s\s+[^.]{0,80}?\(E\d+", block):
            f = _resolve_slug(slug, idx)
            if f:
                files.add(f)
        # a bare filename citation ("...local__sandbox-dbz-merged.md#E1...") —
        # the common form used by a "Link:"/"informed by" precedent reference
        # rather than a Composed: field; missing this left genuine composed-
        # precedent citations (including incompatibility findings) with no
        # graph edge at all (see tension T21).
        for slug in re.findall(r"([a-z][a-z0-9-]{2,})\.md#E\d+", block):
            f = _resolve_slug(slug, idx)
            if f:
                files.add(f)
    files.discard(own)
    return files


SKIPPED_NODE = "(skipped families)"


def _collapse_skipped() -> bool:
    """train-ignore.json `collapse` (default true): fold skipped families into
    one graph node and one scorecard row."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "train-ignore.json")
    try:
        return bool(json.loads(read(path)).get("collapse", True))
    except (OSError, ValueError):
        return True


def _cv_build_graph(entries: list[dict], idx: dict):
    """Undirected co-verification graph over system-files. Edge weight = how many
    entries co-verify the pair; diversity = distinct source files; 'safe' = the
    pair co-occurs inside some entry's 'Got right' (a positive/compatible edge)."""
    from itertools import combinations
    edges = {}
    node_tags = {}

    def _add(a, b, e, declared):
        key = (a, b)
        rec = edges.setdefault(key, {"weight": 0, "sources": set(),
                                     "safe": False, "declared": False,
                                     "incompatible": False})
        rec["weight"] += 1
        rec["sources"].add(e["file"] + "#" + e["id"])
        # a passing blind rebuild by another session is an independent source
        # for every edge this entry vouches for (distinct sandbox, not entry)
        for k, v, sb in _entry_reviews(e.get("block", "")):
            if k == "reverified" and v == "pass":
                rec["sources"].add(e["file"] + "#" + e["id"] + "@" + (sb or "rebuild"))
        rec["declared"] = rec["declared"] or declared
        # a declared refutation (T21): the pair was tested and does NOT combine
        # that way. Still an edge, so `seams` stops offering it as untested.
        if declared and _field(e.get("block", ""), "polarity").strip().lower() \
                == "incompatible":
            rec["incompatible"] = True
            return
        gr = e.get("gotright", "").lower()
        sa, sb = _safe_key(a), _safe_key(b)
        for s in (sa, sb, sa.replace("sandbox-", ""), sb.replace("sandbox-", "")):
            if s and s in gr:
                rec["safe"] = True

    # Lessons in a skipped family (train-ignore.json) fold into ONE node, so
    # hundreds of variants linking to each other stop reading as hundreds of
    # separate edges. Canon is untouched; this is only how the graph is drawn.
    skip = _ignored_files(entries) if _collapse_skipped() else set()
    fold = lambda n: SKIPPED_NODE if n in skip else n   # noqa: E731
    for e in list(entries) + _idea_compositions():
        node_tags.setdefault(fold(e["file"]), set()).update(e["tags"])
        refs = {fold(r) for r in _composed_refs(e, idx)}
        # declared means an explicit field named the refs — the same test the
        # film uses — so prose-mined MEMORY refs are inferred here too
        explicit = bool(_field(e["block"], "composed") or _field(e["block"], "linked"))
        parts = sorted(refs | ({fold(e["file"])} if refs else set()))
        for a, b in combinations(parts, 2):
            _add(a, b, e, explicit)
        # a kernel header quoted in prose links ONLY that kernel and the entry
        # quoting it, and only as INFERRED (T26) — never promoted to declared
        for k in sorted(_kernel_prose_refs(e["block"]) - refs - {e["file"]}):
            a, b = sorted((e["file"], k))
            _add(a, b, e, False)
            node_tags.setdefault(k, set()).update(e["tags"])
        for f in refs:
            node_tags.setdefault(f, set()).update(e["tags"])
    return edges, node_tags


def _safe_key(v: str) -> str:
    """The name a 'Got right' would use for a vertex."""
    if v.startswith("ideas:"):
        seg = v[6:].split("/")
        return (seg[2] if len(seg) > 2 else seg[-1]).lower()
    return v.split("__")[-1][:-3]


def _components(edges: dict) -> list[set]:
    adj = {}
    for (a, b) in edges:
        adj.setdefault(a, set()).add(b)
        adj.setdefault(b, set()).add(a)
    seen, comps = set(), []
    for n in adj:
        if n in seen:
            continue
        stack, comp = [n], set()
        while stack:
            c = stack.pop()
            if c in seen:
                continue
            seen.add(c)
            comp.add(c)
            stack.extend(adj[c] - seen)
        comps.append(comp)
    return comps


def _shortf(fn: str) -> str:
    if fn.startswith("ideas:"):
        seg = fn[6:].split("/")
        return "ideas:" + seg[0] + "/" + (seg[2] if len(seg) > 2 else seg[-1])
    s = fn[:-3]
    return s.split("__", 1)[1] if "__" in s else s


def _rep_provenance(entries, full):
    def cls(p):
        pl = p.lower()
        if re.match(r"\s*verified", pl):
            return "verified"
        if not p:
            return "unmarked"
        if "assumed" in pl:
            return "assumed"
        return "mixed"
    buckets = {"verified": [], "assumed": [], "mixed": [], "unmarked": []}
    for e in entries:
        buckets[cls(e["provenance"])].append(e)
    todo = buckets["assumed"] + buckets["mixed"] + buckets["unmarked"]
    if not full:
        print(f"  provenance : {len(buckets['verified'])} verified · "
              f"{len(todo)} need first-hand confirmation "
              f"({len(buckets['assumed'])} assumed, {len(buckets['mixed'])} mixed, "
              f"{len(buckets['unmarked'])} unmarked)")
        return
    print("## provenance worklist — lessons not yet verified first-hand\n")
    print(f"verified: {len(buckets['verified'])}   |   needs confirmation: {len(todo)}\n")
    for e in todo:
        tag = "assumed" if e in buckets["assumed"] else (
            "unmarked" if e in buckets["unmarked"] else "mixed")
        print(f"  [{tag:8}] {_shortf(e['file'])}#{e['id']}")
    if not todo:
        print("  (none — every promoted lesson is marked verified)")


def _rep_tags(entries, full):
    from itertools import combinations
    from collections import Counter
    pair = Counter()
    for e in entries:
        for a, b in combinations(sorted(set(e["tags"])), 2):
            pair[(a, b)] += 1
    top = pair.most_common(25 if full else 3)
    if not full:
        head = ", ".join(f"{a}+{b}({n})" for (a, b), n in top)
        print(f"  tags       : {len(pair)} co-occurring pairs; top {head}")
        return
    print("## tag co-occurrence — which domains ride together\n")
    for (a, b), n in top:
        print(f"  {n:3}×  [{a}] + [{b}]")


def _rep_portable(entries, full):
    def toks(s):
        return {w for w in re.findall(r"[a-z][a-z-]{3,}", s.lower())
                if w not in _STOP}
    items = [(e, toks(e["rule"])) for e in entries if len(toks(e["rule"])) >= 5]
    hits = []
    for i in range(len(items)):
        for j in range(i + 1, len(items)):
            (e1, t1), (e2, t2) = items[i], items[j]
            if e1["file"] == e2["file"]:
                continue
            inter = t1 & t2
            jac = len(inter) / len(t1 | t2)
            if jac >= 0.12:
                hits.append((jac, e1, e2, inter))
    hits.sort(key=lambda h: -h[0])
    if not full:
        print(f"  portable   : {len(hits)} cross-project rule-of-thumb echoes "
              f"(candidate general laws)")
        return
    print("## portable-law candidates — same lesson recurring across projects\n")
    for jac, e1, e2, inter in hits[:20]:
        kw = " ".join(sorted(inter)[:6])
        print(f"  {jac:.2f}  {_shortf(e1['file'])}#{e1['id']}  ~  "
              f"{_shortf(e2['file'])}#{e2['id']}")
        print(f"        shared: {kw}")
    if not hits:
        print("  (no strong cross-project echoes yet)")
    print("\n  (threshold: Jaccard >=0.12 on stopword-filtered rule-of-thumb "
          "tokens — see `brain analyze rules`)")


def _rep_density(entries, full):
    from collections import Counter
    cnt = Counter(e["file"] for e in entries)
    dates = {}
    for e in entries:
        d = e["date"]
        if re.match(r"\d{4}-\d{2}-\d{2}", d):
            dates.setdefault(e["file"], []).append(d[:10])
    ranked = cnt.most_common()
    if not full:
        hot = ", ".join(f"{_shortf(f)}({n})" for f, n in ranked[:3])
        print(f"  density    : {len(cnt)} projects, {len(entries)} lessons; "
              f"hotspots {hot}")
        return
    print("## lesson density — where the risk concentrates\n")
    for f, n in ranked:
        ds = sorted(dates.get(f, []))
        span = f"{ds[0]}…{ds[-1]}" if ds else "—"
        bar = "█" * min(n, 40)
        print(f"  {n:3}  {bar}  {_shortf(f)}  ({span})")


def _rep_graph(entries, idx, full):
    _UNRESOLVED_KERNEL_REFS.clear()
    edges, _ = _cv_build_graph(entries, idx)
    kern = {k: r for k, r in edges.items()
            if k[0].startswith("ideas:") or k[1].startswith("ideas:")}
    kdecl = sum(1 for r in kern.values() if r["declared"])
    kline = (f"; {len(kern)} touch ideas kernels ({kdecl} declared, "
             f"{len(kern) - kdecl} inferred from prose)" if kern else "")
    if not full:
        safe = sum(1 for r in edges.values() if r["safe"])
        bad = sum(1 for r in edges.values() if r.get("incompatible"))
        print(f"  graph      : {len(edges)} co-verification edges "
              f"({safe} also seen 'safe' in a Got-right"
              + (f", {bad} incompatible" if bad else "") + f"){kline}")
        if _UNRESOLVED_KERNEL_REFS:
            print(f"               {len(_UNRESOLVED_KERNEL_REFS)} `ideas:` ref(s) "
                  "match no kernel — `brain analyze graph` lists them")
        return
    print("## co-verification graph — system pairs stress-tested together\n")
    if not edges:
        print("  (no composed-lesson refs found yet)")
        return
    for (a, b), r in sorted(edges.items(), key=lambda kv: -kv[1]["weight"]):
        flag = " ✗incompatible" if r.get("incompatible") else \
            (" ✓safe" if r["safe"] else "")
        inf = "" if r["declared"] else "  (inferred)"
        print(f"  w={r['weight']} div={len(r['sources'])}{flag}  "
              f"{_shortf(a)} — {_shortf(b)}{inf}")
    if kline:
        print(f"\n  {kline[2:]}")
    for ref in sorted(_UNRESOLVED_KERNEL_REFS):
        print(f"  ✗ unresolved `ideas:{ref}` — no kernel, or more than one, matches")
    print("\n  (edge = entry names 2+ systems via Composed: or mined prose refs; "
          "✓safe = also named in a Got-right — see `brain analyze rules`; "
          "✗incompatible = a sandbox refuted the pair, `Polarity: incompatible`)")


def _rep_groups(entries, idx, full):
    edges, node_tags = _cv_build_graph(entries, idx)
    comps = [c for c in _components(edges) if len(c) >= 2]
    comps.sort(key=len, reverse=True)
    # Confidence tier: an edge is 'independent' only if 2+ distinct source
    # entries co-verify it (div>=2). Density built from div=1 edges LOOKS
    # verified but is single-sourced — one author/one entry — so we surface the
    # independent fraction alongside density instead of letting density stand
    # alone (see tension T20).
    def _indep(internal):
        return sum(1 for _a, _b, r in internal if len(r["sources"]) >= 2)

    if not full:
        sizes = ", ".join(str(len(c)) for c in comps) or "none"
        ind = sum(1 for r in edges.values() if len(r["sources"]) >= 2)
        print(f"  groups     : {len(comps)} emergent clusters (sizes {sizes}) · "
              f"independence {ind}/{len(edges)} edges multi-source")
        return
    print("## emergent groups — dense co-verified clusters (a derived view)\n")
    if not comps:
        print("  (no clusters yet — need entries composing 2+ systems)")
        return
    for i, c in enumerate(comps, 1):
        internal = [(a, b, r) for (a, b), r in edges.items() if a in c and b in c]
        possible = len(c) * (len(c) - 1) // 2
        dens = len(internal) / possible if possible else 0
        ind = _indep(internal)
        warn = "  ⚠ single-sourced" if internal and ind == 0 else ""
        print(f"  group {i} ({len(c)} systems, {len(internal)}/{possible} "
              f"edges, density {dens:.2f}, independent {ind}/{len(internal)}"
              f"){warn}:")
        for f in sorted(c):
            print(f"      {_shortf(f)}")
        print()
    print("  (group = any connected component of the edge graph, size>=2, no "
          "density minimum. 'independent' = edges with 2+ distinct sources; a high "
          "density with low independence is single-sourced, not well-verified — "
          "see `brain analyze rules`)")


def _seam_candidates(entries, idx):
    """Ranked untested-but-adjacent system pairs — the seams worth testing next.
    Returns (candidates, edges); candidate = (score, shared_count, a, b, shared_tags).
    A pair qualifies only if it shares >=2 tags AND at least one side is already in
    the edge graph (extends proven ground, not a cold pair). Shared by `analyze
    seams` and `train` so both rank seams identically."""
    edges, _node_tags = _graph(entries, idx)
    file_tags = {}
    for e in entries:
        file_tags.setdefault(e["file"], set()).update(e["tags"])
    tested = set()
    for (a, b) in edges:
        tested.add((a, b))
        tested.add((b, a))
    in_graph = {n for e in edges for n in e}
    from itertools import combinations
    cand = []
    for a, b in combinations(sorted(file_tags), 2):
        if (a, b) in tested:
            continue
        shared = file_tags[a] & file_tags[b]
        if len(shared) >= 2 and (a in in_graph or b in in_graph):
            bonus = 1 if (a in in_graph and b in in_graph) else 0
            cand.append((len(shared) + bonus, len(shared), a, b, shared))
    skip = _ignored_files(entries)
    cand = [c for c in cand if c[2] not in skip and c[3] not in skip]
    cand = _weakest_link_order(cand, edges)
    return cand, edges


def _rep_seams(entries, idx, full):
    cand, _edges = _seam_candidates(entries, idx)
    if not full:
        print(f"  seams      : {len(cand)} untested pairs adjacent to a proven "
              f"cluster (≥2 shared tags) — best stress-tests to run next")
        return
    print("## untested seams — weakest-link pairs to stress-test next\n")
    print("  (≥2 shared tags AND at least one side already in a co-verified "
          "cluster, so each\n   extends proven ground instead of starting cold)\n")
    for _score, n, a, b, shared in cand[:15]:
        print(f"  shared={n} [{' '.join(sorted(shared))}]  "
              f"{_shortf(a)} + {_shortf(b)}")
    if not cand:
        print("  (none — either all same-domain pairs tested, or no cluster to "
              "extend yet)")
    print("\n  (ranking: weakest link first — fewest edges on the less-connected "
          "side, then shared-tag count; see `brain analyze rules`)")


# ------------------------------------------------------------------- film
#
# `brain viz --film` renders the system's OWN story: how the canon accumulated,
# how the co-verification graph assembled out of it, which clusters emerged
# that nobody declared, and where the untested frontier sits. Every number is
# derived live from the same analysis the `analyze` reports use — the film
# carries no figures of its own.

def _ellipsize(text: str, n: int) -> str:
    """Cut at a word boundary, never mid-word — a title ending 'logic, not'
    reads as a typo, not a truncation."""
    if len(text) <= n:
        return text
    cut = text[:n].rsplit(" ", 1)[0].rstrip(",;:—-")
    return cut + "…"


def _film_payload() -> dict:
    from itertools import combinations
    bases = _analyze_bases()
    entries = _load_entries(bases)
    idx = _slug_index(bases)
    edges, node_tags = _cv_build_graph(entries, idx)

    # growth: cumulative lessons by date
    by_day = {}
    for e in entries:
        d = (e.get("date") or "").strip()[:10]
        if re.match(r"^\d{4}-\d{2}-\d{2}$", d):
            by_day[d] = by_day.get(d, 0) + 1
    timeline, run = [], 0
    for d in sorted(by_day):
        run += by_day[d]
        timeline.append([d, run])

    def prov(p):
        pl = p.lower()
        if re.match(r"\s*verified", pl):
            return "verified"
        if not p:
            return "unmarked"
        if "assumed" in pl:
            return "assumed"
        return "mixed"
    verified = sum(1 for e in entries if prov(e["provenance"]) == "verified")

    # An edge is DECLARED when the entries behind it carried an explicit
    # `Composed:` field, INFERRED when it had to be mined out of prose. That
    # split is load-bearing, not decoration: tension T26 is open precisely
    # because prose-mining can read an illustrative mention as a real
    # composition, so the film shows which edges rest on the weaker signal
    # instead of drawing all of them as equally earned.
    declared = set()
    for e in entries:
        if not _field(e["block"], "composed"):
            continue
        refs = _composed_refs(e, idx)
        parts = sorted(refs | ({e["file"]} if refs else set()))
        for a, b in combinations(parts, 2):
            declared.add((a, b))

    ranked = sorted(edges.items(), key=lambda kv: -kv[1]["weight"])[:140]
    seen, nodes = {}, []
    for (a, b), _rec in ranked:
        for f in (a, b):
            if f not in seen:
                seen[f] = len(nodes)
                nodes.append(_shortf(f))
    elist = [[seen[a], seen[b], rec["weight"], bool(rec["safe"]), (a, b) in declared]
             for (a, b), rec in ranked]

    sizes = sorted((len(c) for c in _components(edges)), reverse=True)
    cand, _e2 = _seam_candidates(entries, idx)

    tl = read(os.path.join(node("Tension"), "tension-ledger.md"))
    tc = {"open": 0, "leaning": 0, "resolved": 0}
    topen = []
    for b in _blocks(tl, "### "):
        st = entry_status(b)
        head = b.splitlines()[0].lstrip("# ").strip()
        if st == "\U0001F534":
            tc["open"] += 1
            topen.append([head.split(" \u00b7 ")[0], head.split(" \u00b7 ")[-1][:80]])
        elif st == "\U0001F7E1":
            tc["leaning"] += 1
        elif st == "\U0001F7E2":
            tc["resolved"] += 1

    return {
        "lessons": len(entries),
        "projects": len({e["file"] for e in entries}),
        "verified": verified,
        "unverified": len(entries) - verified,
        "timeline": timeline,
        "nodes": nodes,
        "edges": elist,
        "edgeTotal": len(edges),
        "safeTotal": sum(1 for _k, r in edges.items() if r["safe"]),
        "inferredTotal": sum(1 for k in edges if k not in declared),
        "groups": sizes,
        "seams": [[_shortf(a), _shortf(b), n] for _s, n, a, b, _sh in cand[:6]],
        "seamTotal": len(cand),
        "tensions": tc,
        "openList": topen[:6],
    }


def _rep_rules(_full=True) -> None:
    print("""## analyze rules — exactly how each report is computed

This command derives views over canon that already exists; it never edits
memory or ideas. These are the hardcoded thresholds behind each report, so
a linked project can trust the numbers without reading bin/brain source.

EDGES (graph/groups/seams all build on this):
  - An entry contributes a co-verification edge only if it names 2+ systems:
    its `Composed:` field if present (authoritative), else prose is mined for
    `slug/E<n>`, `slug's ... (E<n>)`, and `slug.md#E<n>` patterns.
  - An edge is marked SAFE only if a co-composed slug also appears in that
    entry's `Got right` field text (a positive/compatible signal, distinct
    from "a bug was found here").
  - Edge weight = how many entries co-verify that pair.

GROUPS: any connected component of the edge graph with >=2 nodes. No
  density or strength minimum — a single shared entry is enough to cluster
  two systems. A derived view, recomputed every run — never a stored roster.

SEAMS (untested pairs worth stress-testing next): a pair qualifies only if
  it shares >=2 tags AND at least one side is already in the edge graph (so
  it extends proven ground, not a cold pair from nothing). Ranked WEAKEST
  LINK first: the pair whose least-connected system has the fewest edges
  comes first; ties break on shared-tag count (+1 bonus if BOTH sides are
  already in-graph). Every edge a pass adds raises a system's degree, so the
  top pick changes as training lands.

REVIEW QUEUES (`train audit` / `train rebuild`): entries are grouped into a
  family from the project file name (owner and date segments dropped, first
  two hyphen words kept). Audit ranks the family with the LOWEST share of
  reviewed entries first, then stored-sandbox entries, then most-cited;
  rebuild ranks the family with the lowest share of blind-rebuilt entries
  first, then most-cited. A family that has been worked a lot sinks.

KERNEL GAPS (`train gap` / `train kernel`): unapplied kernels from the domain
  with the fewest applied kernels come first; ties break on tag overlap.

PORTABLE (rule-of-thumb echoes across projects): each entry's `Rule of
  thumb` text is tokenized (stopword-filtered, words >=4 chars); two
  entries from DIFFERENT projects are flagged if their token-set Jaccard
  similarity is >=0.12.

PROVENANCE: buckets by the `Provenance` field — starts with "verified" ->
  verified; contains "assumed" -> assumed; present but neither -> mixed;
  field missing entirely -> unmarked. The worklist is everything except
  verified.

TAGS / DENSITY: plain counts over the `Tags` and `Date`/project fields —
  no thresholds, just frequency.

None of this is canon — rerun any report any time; it reflects live data.""")


def _train_compose_instruction(pairs) -> None:
    print("\n--- AGENT INSTRUCTION (do this now) ---")
    print("STEP 1 — CANDIDATE (from the recorded lessons): for ONE pair below, pull BOTH")
    print("systems' existing entries (`brain query <slug>` each, or read their project")
    print("files) and reason about how those lessons COMPOSE when the two systems are")
    print("used together — reinforce, conflict, or combine into a higher-order rule.")
    for a, b, shared in pairs:
        tag = f"   (shared: {' '.join(sorted(shared))})" if shared else ""
        print(f"    {_shortf(a)}  +  {_shortf(b)}{tag}")
    print("STEP 2 — VERIFY IN A SANDBOX, ALWAYS, UNTIL SATISFIED: a reasoned composition")
    print("is only a CANDIDATE. FIRST write down the PREDICTION (a number/outcome that")
    print("could come out wrong). Then build a small deterministic sandbox (no RNG, no real")
    print("timing — parameterize any speed/seed) that actually REPRODUCES the composed")
    print("claim, and iterate until it clearly reproduces OR clearly does not. The")
    print("sandbox is what earns the edge — required, not optional (tension T22).")
    print("STEP 3 — FILE what the sandbox SHOWED (never what you reasoned): ONE memory proposal in incoming/")
    print("(`brain mine` → TEMPLATE), provenance `Verified first-hand` citing the sandbox")
    print("and its observed result, with a `Composed:` field naming the source entries")
    print("(<slug>/E<id>) — that field mints the edge. Never force a pass: an")
    print("unverified edge is worse than none (the intake rejects assumed provenance).")
    _train_evidence_rule()
    _train_outcome_rule()


def _train_seams(entries, idx, sub, rest) -> int:
    cand, edges = _seam_candidates(entries, idx)
    comps = [c for c in _components(edges) if len(c) >= 2]
    comps.sort(key=len, reverse=True)
    if sub == "edge":
        if not cand:
            return ok("no untested seams queued — nothing adjacent to extend yet; "
                      "try `brain train combined`")
        _score, n, a, b, shared = cand[0]
        print(f"✓ train edge — the weakest-link untested pair (shares {n} tags):")
        _train_compose_instruction([(a, b, shared)])
        return 0
    if sub == "combined":
        top = [(a, b, sh) for _s, _n, a, b, sh in cand[:6]]
        print(f"✓ train combined — compose 2+ systems "
              f"({len(cand)} seams queued, {len(comps)} clusters):")
        if top:
            _train_compose_instruction(top)
        else:
            print("  (no ranked seams yet — compose ANY two systems that share a real")
            print("   interface, then file with a `Composed:` field to seed the graph)")
        return 0
    # sub == "group"
    if not comps:
        return ok("no clusters yet — run `brain train combined` to create the first edges")
    if rest:
        want = rest[0].lower()
        target = next((c for c in comps if any(want in _shortf(f).lower() for f in c)), None)
        if target is None:
            return die(f"no cluster matches '{rest[0]}' (see `brain analyze groups --full`)")
    else:
        # weakest link: the cluster with the lowest share of multi-source
        # (independently verified) edges; larger clusters win ties
        def _weakness(c):
            cs = set(c)
            rs = [r for (a, b), r in edges.items() if a in cs and b in cs]
            ind = sum(1 for r in rs if len(r["sources"]) >= 2)
            return (ind / len(rs) if rs else 0.0, -len(cs), sorted(cs))
        target = min(comps, key=_weakness)
    internal = [(a, b, r) for (a, b), r in edges.items() if a in target and b in target]
    ind = sum(1 for _a, _b, r in internal if len(r["sources"]) >= 2)
    possible = len(target) * (len(target) - 1) // 2
    dens = len(internal) / possible if possible else 0
    print(f"✓ train group — {len(target)} systems, density {dens:.2f}, "
          f"independent {ind}/{len(internal)} edges:")
    for f in sorted(target):
        print(f"      {_shortf(f)}")
    touch = [(a, b, sh) for _s, _n, a, b, sh in cand if a in target or b in target]
    if touch:
        print("  untested seams that extend this cluster:")
        for a, b, sh in touch[:8]:
            print(f"      {_shortf(a)} + {_shortf(b)}  ({' '.join(sorted(sh))})")
    if ind == 0 and internal:
        print("  ⚠ this cluster is entirely single-sourced — re-verifying an existing")
        print("    edge from a second angle is as valuable as a new seam.")
    tgt = sorted(target)
    _train_compose_instruction(touch[:6] or [(tgt[0], tgt[1], set())])
    return 0


def _train_outcome_rule() -> None:
    """Three outcomes, never a silent drop (phase 3, tension T21): a refuted
    composition is knowledge, and an unfiled one gets re-tested forever."""
    print("ROUTE THE RESULT — every sandbox outcome is filed, none is dropped:")
    print("  • REPRODUCED → the memory proposal above.")
    print("  • CLEARLY REFUTED → STILL a memory proposal, with `- Polarity:")
    print("    incompatible` and the same `Composed:` refs: what failed, and what to")
    print("    do instead. That marks the pair tested, so nobody re-tries it blind.")
    print("  • MIXED (holds in some scenarios, fails in others) or STILL UNCLEAR after")
    print("    3 sandbox iterations → a TENSION: append to .brain/tension/tension-ledger.md")
    print("      ### T? · open-question · <the claim, as a question>")
    print("      <what the sandbox showed, and under which conditions each way>.")
    print("      Poles: <holds when …> **vs** <fails when …>")
    print("      Lean: 🔴 open")
    print("      Updates:")
    print("      - <date> opened from brain train; sandbox <file>, result <numbers>.")
    print("      Source: <sandbox file / session>")
    print("  File NOTHING only if it duplicates an existing lesson.")


def _train_evidence_rule() -> None:
    """Keep the sandbox: the proposal ships the script that verified it, so a
    later reader can rerun it instead of trusting the claim (memory steward
    moves it to sandboxes/ on promotion, never runs it)."""
    print("KEEP THE EVIDENCE: save the sandbox script beside the proposal as")
    print("  .brain/memory/incoming/<same YYYY-MM-DD__slug>.py  (stdlib only; its last")
    print("  printed line is `RESULT: PASS <summary>` or `RESULT: FAIL <summary>`), and")
    print("  fill the proposal's `- Sandbox:` (that file name), `- Prediction:` (written")
    print("  BEFORE the first run), `- Observed:` (the RESULT line + key numbers) and")
    print("  `- Scenarios:` (the distinct cases run; mark the one built to BREAK it).")
    print("  A rule saying always/never/every needs 3+ scenarios — or narrow the rule.")
    print("  `brain sync` pushes the script with the proposal.")


def _train_verify_rule() -> None:
    """The rule EVERY train mode shows: verification is a built-and-run sandbox
    model, never a logic/reasoning check."""
    print("\nRULE — verify with a SANDBOX MODEL, never a logic check. Whatever this mode")
    print("produces (a composed edge, a settled gap, a seeded kernel) is only real once a")
    print("small deterministic sandbox you BUILD and RUN reproduces it — no RNG, no real")
    print("timing; parameterize any speed/seed. A reasoned or logic argument is a")
    print("CANDIDATE, not verification: iterate until the model clearly reproduces the")
    print("claim or clearly refutes it, and file what it showed (never a reasoned pass), provenance")
    print("`Verified first-hand`. (A pure external-fact claim: verify against the real")
    print("source — still never by reasoning alone.) See tensions T22, T21.")
    _train_evidence_rule()
    _train_outcome_rule()


def _kernel_links_state(entries):
    """Which kernels memory already reaches, and how. Pending proposals (the
    intake queue and this project's unsynced store) count as reached, so a
    kernel someone is already working on is not handed out twice."""
    declared, quoted = set(), {}
    for e in entries:
        val = _field(e["block"], "composed")
        dec = _declared_kernel_refs(val)[0] if val else set()
        declared |= dec
        for k in _kernel_prose_refs(e["block"]) - dec:
            quoted.setdefault(k, []).append(e)
    pending = set()
    bodies = [b for _f, b, _h in _incoming_proposals(node("memory"))]
    inc = os.path.join(local_root(), "memory", "incoming")
    if os.path.isdir(inc):
        bodies += [read(os.path.join(inc, f)) for f in sorted(os.listdir(inc))
                   if f.endswith(".md")]
    for b in bodies:
        val = _field(b, "composed")
        if val:
            pending |= _declared_kernel_refs(val)[0]
        pending |= _kernel_prose_refs(b)
    return declared, quoted, pending


def _kernel_blocks():
    path = os.path.join(node("ideas"), "idea-repository.md")
    out = []
    for block in _blocks(read(path), "## [") if os.path.isfile(path) else []:
        m = re.match(r"##\s*\[([^\]]+)\]", block)
        if m:
            out.append((_kernel_vertex(_kernel_canon(m.group(1))), block))
    return out


def _kernel_gaps(entries, n=5):
    """Kernels no memory entry has applied, quoted or queued. Weakest link
    first: kernels from the domain with the fewest applied kernels, then by how
    many of memory's own tags their text uses (so it ranks toward kernels this
    canon can actually build a sandbox against, instead of alphabetically)."""
    declared, quoted, pending = _kernel_links_state(entries)
    reached = declared | set(quoted) | pending
    tagvocab = {}
    for e in entries:
        for t in e["tags"]:
            tagvocab[t] = tagvocab.get(t, 0) + 1
    applied = {}
    for v in reached:
        applied[v.split("/")[0]] = applied.get(v.split("/")[0], 0) + 1
    gaps = []
    for v, block in _kernel_blocks():
        if v in reached:
            continue
        words = set(re.findall(r"[a-z][a-z0-9-]{2,}", block.lower()))
        hit = {t for t in tagvocab if t in words}
        if len(hit) >= 2:
            # weakest link first: the domain with the fewest applied kernels
            gaps.append((applied.get(v.split("/")[0], 0), -len(hit),
                         -sum(tagvocab[t] for t in hit), v, hit))
    gaps.sort()
    return [(v, hit) for _w, _a, _b, v, hit in gaps[:n]], len(reached)


def _kernel_pair_seams(n=5, pool=150):
    """Cross-domain kernel pairs that share the most distinctive vocabulary
    (appearing in 2..5% of kernels) and are not already `Linked:`. The kernel
    analogue of an untested seam: a composition nobody has built yet."""
    ks = _kernel_blocks()
    df = {}
    toks = {}
    for v, b in ks:
        t = set(re.findall(r"[a-z][a-z0-9-]{3,}", b.lower()))
        toks[v] = t
        for w in t:
            df[w] = df.get(w, 0) + 1
    hi = max(2, len(ks) // 20)
    dist = {v: {w for w in t if 2 <= df[w] <= hi} for v, t in toks.items()}
    linked = set()
    for c in _idea_compositions():
        for r in _composed_refs(c, {}):
            linked.add(tuple(sorted((c["file"], r))))
    top = sorted(dist, key=lambda v: (-len(dist[v]), v))[:pool]
    pairs = []
    for i, a in enumerate(top):
        for b in top[i + 1:]:
            if a.split("/")[0] == b.split("/")[0] or tuple(sorted((a, b))) in linked:
                continue
            sh = dist[a] & dist[b]
            if len(sh) >= 4:
                pairs.append((-len(sh), a, b, sh))
    pairs.sort()
    return [(a, b, sh) for _n, a, b, sh in pairs[:n]]


KERNEL_MIN_REFS = 3   # a kernel/gap proposal should cite at least this many things


def _thin_kernel_link(body: str) -> str:
    """Warning text when a proposal applies an ideas kernel but its `Composed:`
    names fewer than KERNEL_MIN_REFS things: one citation is one weak edge.
    Empty string when fine, or when the proposal applies no kernel."""
    val = _field(body, "composed")
    if not val:
        return ""
    kernels, rest = _declared_kernel_refs(val)
    if not kernels:
        return ""
    mem = set(re.findall(r"([a-z0-9][a-z0-9_.-]*?)(?:\.md)?[/#](E\d+)", rest, re.I))
    n = len(kernels) + len(mem)
    if n >= KERNEL_MIN_REFS:
        return ""
    return (f"thin link: Composed names {n} ref(s) ({len(kernels)} kernel, "
            f"{len(mem)} memory); a kernel pass should cite at least "
            f"{KERNEL_MIN_REFS} things its sandbox really exercised (sibling "
            "kernels, memory entries it re-verifies) - one citation is a weak edge")


def _related_memory(entries, hit, n=3) -> list:
    """Memory lessons a kernel's sandbox could also exercise: most shared tags,
    strongest evidence tier first, at most one per family so one big family
    cannot fill the list."""
    rank = {"confirmed": 0, "audited": 1, "modeled": 2, "composed": 2,
            "provisional": 3, "disputed": 4}
    cand = sorted((-len(set(e["tags"]) & hit), rank.get(e["tier"], 5), e["file"], e["id"])
                  for e in entries
                  if e["scope"] == "shared" and len(set(e["tags"]) & hit) >= 2)
    out, seen = [], set()
    for _o, _t, f, i in cand:
        fam = _family(f)
        if fam in seen:
            continue
        seen.add(fam)
        out.append(f"{_shortf(f)}/{i}")
        if len(out) == n:
            break
    return out


def _print_gap_candidates(entries, gaps, siblings_pool) -> None:
    """Each gap kernel with the things a proposal can honestly also cite."""
    for v, hit in gaps:
        print(f"    {_kernel_header(v)}\n        (shares memory tags: "
              f"{' '.join(sorted(hit)[:8])}{' …' if len(hit) > 8 else ''})")
        sib = [w for w, _h in siblings_pool
               if w != v and w.split("/")[0] == v.split("/")[0]][:2]
        if sib:
            print("        sibling unapplied kernels: " + ", ".join(_shortf(w) for w in sib))
        rel = _related_memory(entries, hit)
        if rel:
            print("        memory it could re-verify: " + ", ".join(rel))


def _train_kernel(entries, idx) -> int:
    declared, quoted, pending = _kernel_links_state(entries)
    ks = _kernel_blocks()
    gaps, _reached = _kernel_gaps(entries, 5)
    pairs = _kernel_pair_seams(5)
    print("✓ train kernel — grow the links between memory and ideas kernels.")
    print(f"\nSTATE: {len(ks)} kernels · {len(declared)} applied by a memory entry "
          f"(declared) · {len(quoted)} only quoted in prose · {len(pending)} queued.")
    print("\nA — APPLY an untested kernel (no memory entry has built against it):")
    _print_gap_candidates(entries, gaps, _kernel_gaps(entries, 60)[0])
    if quoted:
        print("\nB — DECLARE a link that is only quoted in prose (re-verify it first; T26):")
        for v, es in sorted(quoted.items())[:5]:
            print(f"    {_shortf(v)}  ← quoted by "
                  + ", ".join(f"{_shortf(e['file'])}/{e['id']}" for e in es[:3]))
    if pairs:
        print("\nC — COMPOSE two kernels from different domains into a new one:")
        for a, b, sh in pairs:
            print(f"    {_shortf(a)}  +  {_shortf(b)}   (shared: {' '.join(sorted(sh)[:6])})")
    print("\n--- AGENT INSTRUCTION (do this now) ---")
    print("Pick ONE target. BUILD and RUN a small deterministic sandbox (no RNG, no real")
    print("timing) that reproduces what the kernel claims — and push it until you find")
    print("where it stops holding; that boundary is usually the lesson.")
    print("MINIMUM CITATIONS: one citation is one weak edge. Make the sandbox exercise at")
    print(f"least {KERNEL_MIN_REFS} things and cite all of them: the kernel plus >= {KERNEL_MIN_REFS - 1} more (the sibling")
    print("kernels and the memory entries listed under it are candidates). Cite only what")
    print("the run genuinely touches - padding a citation is worse than a thin link.")
    print("FILE what the sandbox showed (routing below):")
    print("  A or B → a memory proposal whose `Composed:` names the kernel(s) as")
    print("           `ideas:<DOMAIN>/<path>` plus the `<slug>/E<n>` entries it re-verifies;")
    print("  C      → a new ideas kernel in ideas/incoming/ with `- Linked: <A>, <B>`.")
    _train_verify_rule()
    return 0


def _train_gap(entries, idx) -> int:
    print("✓ train gap — settle a thin or open area, then file it.")
    print("\n--- AGENT INSTRUCTION (do this now) ---")
    print("STEP 1 — find a REAL gap: an open 🔴 tension touching current work, a domain")
    print("with little/no coverage (`brain query <topic>` returning almost nothing IS the")
    print("signal), or an idea filed with no build-from-it follow-up.")
    print("STEP 2 — settle it by BUILDING and RUNNING a sandbox model that reproduces the")
    print("behavior (or, for a pure external fact, a cited real source) — not by reasoning")
    print("about it. Don't fabricate coverage.")
    print("STEP 3 — file what the model/source showed: a memory lesson (a real")
    print("bug/decision) via incoming/, an ideas kernel if it's a reusable pattern, or a")
    print("tension if it's an unresolved fork. (Public-facing: the Collective gap loop.)")
    gaps, reached = _kernel_gaps(entries, 5)
    if gaps:
        print(f"\nKERNEL GAPS — ideas no memory entry has applied yet ({reached} kernels "
              "already reached). Building one in a sandbox is a gap by definition; file it")
        print("with `Composed: ideas:<DOMAIN>/<path>` so the link lands in the graph.")
        print(f"A kernel proposal should cite at least {KERNEL_MIN_REFS} things its sandbox really")
        print("exercises (the kernel plus sibling kernels and/or memory entries below):")
        _print_gap_candidates(entries, gaps, _kernel_gaps(entries, 60)[0])
    _train_verify_rule()
    return 0


def _kernel_domain_coverage(entries):
    """(total kernels per domain, kernels reached by memory per domain)."""
    declared, quoted, pending = _kernel_links_state(entries)
    reached = declared | set(quoted) | pending
    tot, hit = {}, {}
    for v, _b in _kernel_blocks():
        d = v.split("/")[0]
        tot[d] = tot.get(d, 0) + 1
        if v in reached:
            hit[d] = hit.get(d, 0) + 1
    return tot, hit


def _uncovered_kernel_domains(entries, n=8) -> list:
    """(domain, reached, total): kernel domains memory has barely exercised,
    least-covered share first, bigger domains first on ties."""
    tot, hit = _kernel_domain_coverage(entries)
    rows = [(hit.get(d, 0) / t, -t, d) for d, t in tot.items() if hit.get(d, 0) < t]
    rows.sort()
    return [(d, hit.get(d, 0), tot[d]) for _s, _t, d in rows[:n]]


def _thin_families(entries, n=8, max_size=2) -> list:
    """(lessons, family): project families with at most `max_size` lessons,
    thinnest first - the places a new family or domain is still cheap to grow."""
    cnt = {}
    for e in entries:
        if e["scope"] == "shared":
            f = _family(e["file"])
            cnt[f] = cnt.get(f, 0) + 1
    return sorted((c, f) for f, c in cnt.items() if c <= max_size)[:n]


def _lessons_without_kernel(entries, n=6) -> list:
    """Verified lessons no ideas kernel was written from or cites, strongest
    tier first, one per family: candidates to graduate into a new kernel."""
    rank = {"confirmed": 0, "audited": 1}
    stems = _stem_counts(entries)
    cand = []
    for e in entries:
        if e["scope"] != "shared" or e["tier"] not in rank:
            continue
        # a variant in a saturated claim family would only mint another kernel
        # for a claim that already has a dozen sandboxes
        if stems.get("-".join(_slug_tokens(e["file"])[:SATURATION_STEM_TOKENS]), 0) \
                >= SATURATION_CAP:
            continue
        if _declared_kernel_refs(_field(e["block"], "composed") or "")[0] \
                or _kernel_prose_refs(e["block"]):
            continue
        cand.append((rank[e["tier"]], e["file"], e["id"]))
    out, seen = [], set()
    for _r, f, i in sorted(cand):
        fam = _family(f)
        if fam in seen:
            continue
        seen.add(fam)
        out.append(f"{_shortf(f)}/{i}")
        if len(out) == n:
            break
    return out


def _norm_name(x: str) -> str:
    """Domain / tag / family spelling folded so 'Tiktok Shop', 'tiktok_shop' and
    'TIKTOK-SHOP' are one name."""
    return re.sub(r"[^a-z0-9]+", "-", x.lower().replace("ideas:", "")).strip("-")


def _pending_idea_headers() -> list:
    """Kernel headers already queued in ideas/incoming/ (shared cache and this
    project's local store), so concurrent runs do not invent the same idea."""
    out = []
    for root in (os.path.join(node("ideas"), "incoming"),
                 os.path.join(local_root(), "ideas", "incoming")):
        if not os.path.isdir(root):
            continue
        for fn in sorted(os.listdir(root)):
            if fn.endswith(".md") and fn.upper() not in ("TEMPLATE.MD", "README.MD"):
                out += re.findall(r"^##\s*\[([^\]]+)\]", read(os.path.join(root, fn)), re.M)
    # the schema placeholder `[DOMAIN / sub / kebab-kernel / kebab-hook]` is not an idea
    return [h for h in out if not re.match(r"\s*DOMAIN\s*/", h)]


def _known_domains(entries) -> dict:
    """Every domain-ish name that already exists: ideas kernel domains (canon and
    queued), memory project families, and memory tags."""
    kd = {_norm_name(v.split("/")[0]) for v, _b in _kernel_blocks()}
    for h in _pending_idea_headers():
        kd.add(_norm_name(h.split("/")[0]))
    fam = {_norm_name(_family(e["file"])) for e in entries if e["scope"] == "shared"}
    tags = {_norm_name(t) for e in entries for t in e["tags"]}
    return {"kernel domains": kd, "memory families": fam, "memory tags": tags}


def _domain_exists(name: str, known: dict) -> str:
    """Which known set already holds `name` ('' when it is genuinely new)."""
    n = _norm_name(name)
    for label, names in known.items():
        if n in names:
            return label
    return ""


def _train_new_idea(entries, idx) -> int:
    ks = _kernel_blocks()
    tot, hit = _kernel_domain_coverage(entries)
    pend = _pending_idea_headers()
    print("✓ train newidea — create an idea that does not exist yet: a NEW kernel in the")
    print("  ideas repo, not another variant of one already there.")
    print(f"\nSTATE: {len(ks)} kernels across {len(tot)} domains, {len(pend)} more queued.")
    print("\nALREADY EXISTS - kernel domains (kernels each); a new idea must not restate one:")
    row = ", ".join(f"{d.replace('ideas:', '')} {t}" for d, t in sorted(tot.items()))
    print("    " + row)
    if pend:
        print("\nQUEUED, not yet merged (do not duplicate): "
              + "; ".join(h[:70] for h in pend[:8]))
    print("\nWAYS TO FIND A GENUINELY NEW ONE (each must still pass the novelty check below):")
    grads = _lessons_without_kernel(entries)
    if grads:
        print("  A - GRADUATE a verified lesson no kernel was written from:")
        print("      " + ", ".join(grads))
    pairs = _kernel_pair_seams(5)
    if pairs:
        print("  B - COMPOSE two kernels from different domains into a new one:")
        for a, b, sh in pairs:
            print(f"      {_shortf(a)}  +  {_shortf(b)}   (shared: {' '.join(sorted(sh)[:6])})")
    thin = sorted((t, d) for d, t in tot.items())[:6]
    print("  C - a pattern from a REAL scenario in a thin domain (fewest kernels): "
          + ", ".join(f"{d.replace('ideas:', '')} ({t})" for t, d in thin))
    print("\n--- AGENT INSTRUCTION (do this now) ---")
    print("1. NOVELTY CHECK first. State the pattern in one sentence, then `brain query` its")
    print("   two or three key terms and compare with the nearest kernels. If an existing")
    print("   kernel already says it (even in other words), drop it and pick another - the")
    print("   steward holds near-duplicates, so a restated idea is wasted work.")
    print("2. State it as a kernel (it must pass the artifact and portability tests - see")
    print("   `brain mine`), then BUILD and RUN a small deterministic sandbox that shows the")
    print("   claim holds and where it stops holding.")
    print("3. File it in ideas/incoming/ with `- Linked:` naming at least")
    print(f"   {KERNEL_MIN_REFS} existing related kernels the sandbox genuinely exercises (fewer only if the")
    print("   domain truly has fewer), and for A cite the source lesson in the memory")
    print("   proposal you file with it. Cite only what the run touched.")
    _train_verify_rule()
    return 0


def _train_new_domain(entries, idx, rest) -> int:
    known = _known_domains(entries)
    name = rest[0] if rest else None
    if name:
        where = _domain_exists(name, known)
        if where:
            print(f"✗ train newdomain - '{name}' already exists ({where}), so it is not a new domain.")
            print(f"  `brain query {name}` to see it. Pick a name that is not on the lists below,")
            print("  or grow it with `brain train gap` / `brain train kernel` instead.\n")
            name = None
        else:
            print(f"✓ train newdomain - '{name}' does not exist yet (not a kernel domain, a memory")
            print("  family or a memory tag). Seed it.")
    if not name:
        print("✓ train newdomain - create a domain that does not exist yet.")
        print("\nALREADY EXISTS - kernel domains: "
              + ", ".join(sorted(d.replace("ideas:", "") for d in
                                 {v.split("/")[0] for v, _b in _kernel_blocks()})))
        fams = sorted(known["memory families"])
        print(f"\nALREADY EXISTS - memory families ({len(fams)}): " + ", ".join(fams[:60])
              + (f", ... (+{len(fams) - 60} more)" if len(fams) > 60 else ""))
        pend = _pending_idea_headers()
        if pend:
            print("\nQUEUED, not yet merged: " + "; ".join(h.split("/")[0].strip() for h in pend[:10]))
        print("\n(Memory tags are checked too: a name that is already a tag counts as existing.)")
    print("\n--- AGENT INSTRUCTION (do this now) ---")
    if not name:
        print("1. PICK a domain that is not on the lists above and is not a synonym of anything")
        print("   on them. Ground it in a REAL scenario or a cited real source you can work")
        print("   with now - not a topic you only know in the abstract. Confirm with")
        print("   `brain query <its main keyword>` that it returns nothing relevant.")
    print("A domain with no records can't be gap-detected against - there's nothing to be")
    print("sparse relative to. So SEED it: from a REAL scenario in that domain, create the")
    print("first 1-3 entries - a reusable kernel in ideas (must pass the artifact +")
    print("portability tests), and/or a memory lesson if a real decision/bug already")
    print("surfaced. If any existing kernel or lesson is adjacent, cite what the sandbox")
    print("genuinely exercises (up to the usual minimum of 3); say plainly if it is isolated.")
    print("Later sessions can then detect true gaps against this seed.")
    _train_verify_rule()
    return 0


# Refutations only had somewhere to land once `Polarity:` existed (phase 3,
# T21). Count only lessons filed under the evidence process (they carry a
# Sandbox or Prediction field, so their author saw the routing rule): a date
# cutoff let 38 same-day lessons written before Polarity read as a fake zero.
# A Sandbox line marked "backfilled" (phase 5) was attached later to an older
# lesson, so it does not count either.


# Saturation. A single-source edge between two entries that verify the SAME
# claim is not a gap in independence, it is the loop handing itself its own
# last move: each new sandbox cites two earlier ones, makes two new single-
# source edges, and AIM points straight back at the family. Observed 2026-10:
# one claim (the 2-lag average flat at P and 2P) re-verified 467 times in nine
# days of hourly runs, every file distinct and honest, while five unrelated
# lessons waited behind them. The claim's STEM is the first five slug tokens
# (date and scope prefix stripped); two entries with one stem are one family.
SATURATION_STEM_TOKENS = 5
SATURATION_CAP = 12          # sandbox-backed entries per stem before AIM stops offering it
SATURATION_WINDOW = 50       # recent sandbox-backed entries the HEALTH line looks at
SATURATION_WARN_SHARE = 0.5  # one stem owning more than this share of the window


def _claim_stem(fn: str) -> str:
    """'local__2026-10-03__age-cutoff-2lag-flat-at-p-and-2p-set-cover-base-1039.md'
    -> 'age-cutoff-2lag-flat-at-p'. Stable across offset/modulus/data-structure
    suffixes, which is exactly the axis the flood varied."""
    s = fn[:-3] if fn.endswith(".md") else fn
    if s.startswith("ideas:"):
        return s
    s = s.split("__")[-1]
    return "-".join(s.split("-")[:SATURATION_STEM_TOKENS])


def _sandbox_backed(entries) -> list:
    return [e for e in entries
            if (_field(e["block"], "sandbox") and "backfilled" not in _field(e["block"], "sandbox"))
            or _field(e["block"], "prediction")]


def _slug_tokens(fn: str) -> list[str]:
    s = fn[:-3] if fn.endswith(".md") else fn
    if s.startswith("ideas:"):
        return [s]
    return s.split("__")[-1].split("-")


def _stem_counts(entries) -> dict:
    """Sandbox-backed entries per slug prefix, for every prefix length from 2
    up to the stem length — so a family that branched ('age-cutoff-2lag-…' and
    'age-cutoff-contiguous-…') is still one family at the prefix they share."""
    counts = {}
    for e in _sandbox_backed(entries):
        toks = _slug_tokens(e["file"])
        for k in range(2, SATURATION_STEM_TOKENS + 1):
            if len(toks) >= k:
                p = "-".join(toks[:k])
                counts[p] = counts.get(p, 0) + 1
    return counts


def _saturation(entries) -> tuple[str, int, int]:
    """(top stem, its count, window size) over the most recent sandbox-backed
    entries. Pure, so the selftest can negative-control it."""
    recent = sorted(_sandbox_backed(entries), key=lambda e: e["date"], reverse=True)[:SATURATION_WINDOW]
    counts = {}
    for e in recent:
        st = _claim_stem(e["file"])
        counts[st] = counts.get(st, 0) + 1
    if not counts:
        return "", 0, 0
    top = max(counts, key=counts.get)
    return top, counts[top], len(recent)


def _aim_filter(single, stem_counts, ignored=frozenset()) -> tuple[list, int, int]:
    """Drop single-source edges that would only deepen a saturated family, or
    that touch a family training was told to skip. Returns (kept,
    dropped_same_family, dropped_saturated)."""
    kept, same, sat = [], 0, 0
    for a, b in single:
        if a in ignored or b in ignored:
            sat += 1
            continue
        ta, tb = _slug_tokens(a), _slug_tokens(b)
        shared = 0
        for x, y in zip(ta, tb):
            if x != y:
                break
            shared += 1
        if shared >= SATURATION_STEM_TOKENS:
            same += 1                      # one claim stem on both ends
            continue
        # a branched family: the two ends share a shorter prefix that is itself
        # saturated, or either end's own stem is
        hit = False
        for k in range(min(shared, SATURATION_STEM_TOKENS), 1, -1):
            if stem_counts.get("-".join(ta[:k]), 0) >= SATURATION_CAP:
                hit = True
                break
        for t in (ta, tb):
            if stem_counts.get("-".join(t[:SATURATION_STEM_TOKENS]), 0) >= SATURATION_CAP:
                hit = True
        if hit:
            sat += 1
            continue
        kept.append((a, b))
    return kept, same, sat


def _train_health(entries) -> list[str]:
    """Is testing actually able to fail? Real verification refutes some
    fraction of claims; a long run of passes with none refuted is a warning
    sign about the sandboxes, not a sign the canon is right."""
    comp = sorted((e for e in entries
                   if _field(e["block"], "composed").strip().lower()
                   not in ("", "n/a", "na", "none", "-", "—")
                   and ((_field(e["block"], "sandbox")
                         and "backfilled" not in _field(e["block"], "sandbox"))
                        or _field(e["block"], "prediction"))),
                  key=lambda e: e["date"], reverse=True)[:20]
    bad = sum(1 for e in comp
              if _field(e["block"], "polarity").strip().lower() == "incompatible")
    revs = [r for e in entries for r in _entry_reviews(e["block"])]
    rfail = sum(1 for _k, v, _s in revs if v == "fail")
    out = [f"HEALTH: {bad}/{len(comp)} recent sandbox-backed composed lessons "
           f"refuted · reviews {len(revs) - rfail} pass / {rfail} fail"]
    if len(comp) >= 10 and bad == 0:
        out.append("  ⚠ 0 refuted in the last 10+ composed lessons. Real tests fail "
                   "sometimes — suspect sandboxes that build their answer in, and "
                   "push each claim to where it breaks.")
    if len(revs) >= 10 and rfail == 0:
        out.append("  ⚠ every review so far passed — audit harder (question 1 and 2).")
    top, n, win = _saturation(entries)
    if win:
        out.append(f"SATURATION: top claim `{top}` holds {n}/{win} of the last "
                   f"{SATURATION_WINDOW} sandbox-backed lessons")
        if win >= 10 and n > SATURATION_WARN_SHARE * win:
            out.append("  ⚠ one claim owns most recent verification — the loop is re-verifying "
                       "its own output. AIM below skips that family; pick a different seam.")
    return out


_REVIEW_TARGET_RE = re.compile(r"^-\s*Target\s*:\s*(?:projects/)?([^\s#]+)#(E\d+)", re.M)
_REVIEW_KIND_RE = re.compile(r"^-\s*Kind\s*:\s*([A-Za-z]+)", re.M)


def _pending_drafts() -> list[tuple[str, str]]:
    """(filename, body) of proposals filed but not yet promoted: the shared
    intake queue plus this project's local one. A draft carrying a STEWARD HOLD
    marker is excluded: it is waiting on a human, so its target is NOT covered
    and must stay pickable (otherwise one held draft blocks its target forever)."""
    out = [(f, b) for f, b, held in _incoming_proposals(node("memory")) if not held]
    d = os.path.join(local_root(), "memory", "incoming")
    if os.path.isdir(d):
        for f in sorted(os.listdir(d)):
            if f.endswith(".md") and f not in ("README.md", "TEMPLATE.md", "stubs.md"):
                b = read(os.path.join(d, f))
                if "STEWARD HOLD" not in b:
                    out.append((f, b))
    return out


def _pending_review_targets() -> dict:
    """{'audit': {(file, 'E<n>')}, 'rebuild': {...}} named by pending reviews.
    The steward only writes `Audited:`/`Reverified:` once it promotes a review,
    so until then the queues would offer the same target again."""
    got = {"audit": set(), "rebuild": set()}
    for _f, body in _pending_drafts():
        tm, km = _REVIEW_TARGET_RE.search(body), _REVIEW_KIND_RE.search(body)
        if not (tm and km):
            continue
        kind = "rebuild" if km.group(1).lower() in ("rebuild", "reverified") else "audit"
        got[kind].add((tm.group(1), tm.group(2)))
    return got


def _pending_compositions() -> list[dict]:
    """Pending non-review proposals shaped like entries, so the graph builder
    counts the pairs they compose as already taken. Same-session loops then
    stop re-offering a pair, kernel, or edge that has a draft waiting."""
    out = []
    for f, body in _pending_drafts():
        if _REVIEW_TARGET_RE.search(body) and _REVIEW_KIND_RE.search(body):
            continue
        if not _field(body, "composed"):
            continue
        out.append({"file": "incoming/" + f, "scope": "pending", "id": "E0",
                    "block": body, "tags": set(_tags_of(body)), "gotright": ""})
    return out


def _graph(entries, idx):
    """Co-verification graph for TARGETING (train): canon plus pending drafts."""
    return _cv_build_graph(list(entries) + _pending_compositions(), idx)


def _ignore_patterns() -> list:
    """Compiled patterns from train-ignore.json beside the CLI: families that
    automatic training must not pick (a family can be saturated for good)."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "train-ignore.json")
    try:
        return [re.compile(x, re.I) for x in json.loads(read(path))["patterns"]]
    except (OSError, ValueError, KeyError, re.error):
        return []


def _train_ignored(e) -> bool:
    """True if this lesson belongs to a family training has been told to skip."""
    pats = _ignore_patterns()
    if not pats:
        return False
    blk = e["block"]
    text = " ".join([e["file"], blk.splitlines()[0] if blk else "",
                     _field(blk, "what"), _field(blk, "why built"),
                     _field(blk, "rule of thumb"), _field(blk, "composed")])
    return any(p.search(text) for p in pats)


def _ignored_files(entries) -> set:
    return {e["file"] for e in entries if _train_ignored(e)}


# --- The new half: path strengths (paths.json beside the CLI) ---------------
# The current half reaches for the weakest link. The new half follows use: a
# path two systems share gets stronger each time a lesson uses it and fades
# when nothing does. Derived from canon on every run and never stored, so
# turning it off (`"enabled": false`) leaves no trace to clean up.
PATHS_DEFAULTS = {"enabled": True, "decay_per_day": 0.85,
                  "follow_share": 0.75, "fail_weight": 0.6,
                  "trial_start": ""}


def _paths_conf() -> dict:
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "paths.json")
    conf = dict(PATHS_DEFAULTS)
    try:
        conf.update({k: v for k, v in json.loads(read(path)).items()
                     if k in PATHS_DEFAULTS})
    except (OSError, ValueError):
        pass
    return conf


def _path_strengths(entries, idx, edges=None, today=None) -> dict:
    """(a, b) -> strength. Each lesson using the path adds 1 (a declared
    refutation subtracts fail_weight), faded by decay_per_day per day of age.
    Skipped families (train-ignore.json) are left out."""
    import datetime
    conf = _paths_conf()
    if edges is None:
        edges, _nt = _graph(entries, idx)
    dates = {e["file"] + "#" + e["id"]: e["date"] for e in entries}
    today = today or datetime.date.today()
    decay = float(conf["decay_per_day"])
    out = {}
    for (a, b), rec in edges.items():
        if SKIPPED_NODE in (a, b):
            continue
        sign = -float(conf["fail_weight"]) if rec["incompatible"] else 1.0
        total = 0.0
        for src in rec["sources"]:
            d = dates.get(src.split("@", 1)[0], "")
            try:
                age = max(0, (today - datetime.date.fromisoformat(d[:10])).days)
            except ValueError:
                age = 30
            total += sign * decay ** age
        if total:
            out[(a, b)] = total
    return out


def _node_strength(strengths) -> dict:
    out = {}
    for (a, b), s in strengths.items():
        out[a] = out.get(a, 0.0) + s
        out[b] = out.get(b, 0.0) + s
    return out


NEW_HALF_MODES = ("kernel", "edge", "gap")
_PICKED_RE = re.compile(r"^-\s*Picked-by\s*:\s*(new|current)-half", re.M | re.I)


def _pick_half(entries, mode, salt=0) -> str:
    """Which half takes this pass. Only kernel/edge/gap passes are shared;
    audit and rebuild check existing canon and stay with the current half.
    Deterministic: every lesson filed and every pass moves the slot along, so
    follow_share of the slots go to the new half."""
    conf = _paths_conf()
    if not conf["enabled"] or mode not in NEW_HALF_MODES:
        return "current"
    share = min(1.0, max(0.0, float(conf["follow_share"])))
    # x13 mod 20 is a permutation, so any 20 consecutive slots hold exactly
    # share*20 new-half slots, and neighbouring passes land far apart
    return "new" if ((len(entries) + salt) * 13) % 20 < round(share * 20) else "current"


def _new_half_targets(entries, idx) -> list:
    """The new half's own picker: strongest path first, plus the companion
    most used alongside it that has not yet been tested with both ends.
    [(a, b, companion, strength)]. Hubs (the top 2% of nodes by link count,
    e.g. a running project log) are never a target end. Filing a lesson that
    cites all three links the companion to both ends, so the next pick moves
    on to the next companion, then the next path - no lock-in."""
    edges, _nt = _graph(entries, idx)
    st = _path_strengths(entries, idx, edges)
    deg = _edge_degree(edges)
    nodes = sorted((n for n in deg if n != SKIPPED_NODE), key=lambda n: (-deg[n], n))
    hub = set(nodes[:len(nodes) // 50]) | {SKIPPED_NODE}
    nbr = {}
    for (a, b), v in st.items():
        nbr.setdefault(a, {})[b] = v
        nbr.setdefault(b, {})[a] = v
    out, seen = [], set()
    for (a, b), v in sorted(st.items(), key=lambda x: (-x[1], x[0])):
        if v <= 0 or a in hub or b in hub:
            continue
        comp = sorted(((s, c) for n in (a, b) for c, s in nbr.get(n, {}).items()
                       if c not in (a, b) and c not in hub and s > 0
                       and not (c in nbr.get(a, {}) and c in nbr.get(b, {}))),
                      key=lambda x: (-x[0], x[1]))
        if comp and frozenset((a, b, comp[0][1])) not in seen:
            seen.add(frozenset((a, b, comp[0][1])))
            out.append((a, b, comp[0][1], v))
    # bridge handoff: paths touching a current-half lesson that held go first
    # (stable sort, so each group stays strongest-first)
    follow = _bridge(entries, idx)["follow"] if _paths_conf()["enabled"] else set()
    out.sort(key=lambda t: not ({t[0], t[1], t[2]} & follow))
    return out[:5]


_ENTRY_TOKEN_RE = re.compile(r"([A-Za-z0-9_.-]+)/(E\d+)")


def _bridge(entries, idx) -> dict:
    """The bridge between the halves (Conscience: read-only, worked out from
    canon on every run). Two handoffs:
    - recheck: lessons that cite a DISPUTED lesson (an audit failed it). The
      current half audits these first, so a broken link does not stay buried
      in a chain. A `Polarity: incompatible` lesson does NOT contradict what it
      cites: it refutes that composition only, never the entries
      (memory/REVIEW-TEMPLATE.md), so it puts nothing in this queue.
    - follow: files of current-half lessons that held (not disputed, not a
      refutation, not citing a contradicted lesson). The new half builds on these first, so what the weak-link
      search finds becomes a path.
    {"recheck": {(file, id): cited (file, id)}, "follow": set(files)}"""
    def refs(e):
        out = set()
        for slug, eid in _ENTRY_TOKEN_RE.findall(_field(e["block"], "composed") or ""):
            f = _resolve_slug(slug, idx)
            if f:
                out.add((f, eid))
        return out
    bad = {(e["file"], e["id"]) for e in entries if e["tier"] == "disputed"}
    recheck, follow = {}, set()
    for e in entries:
        key = (e["file"], e["id"])
        hit = refs(e) & bad
        if hit and key not in bad and e["tier"] in ("provisional", "composed") \
                and _field(e["block"], "polarity").strip().lower() != "incompatible":
            recheck[key] = sorted(hit)[0]
        m = _PICKED_RE.search(e["block"])
        if m and m.group(1).lower() == "current" and key not in bad and key not in recheck \
                and _field(e["block"], "polarity").strip().lower() != "incompatible":
            follow.add(e["file"])
    return {"recheck": recheck, "follow": follow}


def _train_zanegpt() -> None:
    print("\nZANEGPT CHECK (the bridge's second half — not yours to answer): write the")
    print("proposal with a `- Scenarios:` case marked as the one built to BREAK the claim,")
    print("then run `brain check <proposal.md>`. A separate ZaneGPT agent that did not make")
    print("this pick writes the hidden assumption, what would prove it wrong, a break")
    print("scenario and a verdict into it. The steward HOLDS a trial pick without that")
    print("check, with a stale one (the claim edited after it), or with a `fails` verdict.")


# ---------------------------------------------------------------- the ZaneGPT check
# The bridge was built in two parts (93aa9b2): Conscience routes handoffs, ZaneGPT
# pressure-tests every pick. The second part shipped as printed advice the picker
# answered for itself. `brain check` runs it as a SEPARATE agent — a fresh
# `claude -p` process that never saw the pick — and the memory steward holds a
# trial pick without it (memory/scripts/steward.py zanegpt_problems).
_ZANEGPT_KEYS = ("zanegpt verdict", "hidden assumption", "would prove it wrong",
                 "break scenario", "checked by")
_ZANEGPT_LABELS = {"zanegpt verdict": "ZaneGPT verdict", "hidden assumption": "Hidden assumption",
                   "would prove it wrong": "Would prove it wrong",
                   "break scenario": "Break scenario", "checked by": "Checked by"}
_ZANEGPT_ANSWER = {"hidden assumption": "HIDDEN ASSUMPTION", "would prove it wrong": "WOULD PROVE IT WRONG",
                   "break scenario": "BREAK SCENARIO", "zanegpt verdict": "VERDICT"}


def _zanegpt_digest(text: str) -> str:
    """Same 12-hex digest as the steward's zanegpt_digest: What, Rule of thumb
    and Prediction, whitespace collapsed."""
    import hashlib
    claim = "\n".join(" ".join(_field(text, k).split())
                      for k in ("what", "rule of thumb", "prediction"))
    return hashlib.sha256(claim.encode("utf-8")).hexdigest()[:12]


def _zanegpt_prompt(text: str) -> str:
    parts = [(k, _field(text, k)) for k in ("what", "design", "rule of thumb", "prediction",
                                            "observed", "scenarios")]
    lesson = "\n".join(f"{k.upper()}: {v}" for k, v in parts if v)
    return ("You are ZaneGPT, the checking half of Brain's bridge. You did not make this pick "
            "and have no stake in it. " + STANCES["zanegpt"][1].replace("\n", " ") + "\n\n"
            "Pressure-test this proposed lesson. Do not rewrite it.\n\n" + lesson + "\n\n"
            "Reply with exactly these four lines and nothing else:\n"
            "HIDDEN ASSUMPTION: <the unstated assumption the rule rests on>\n"
            "WOULD PROVE IT WRONG: <a concrete result that would refute it>\n"
            "BREAK SCENARIO: <one scenario built to break it>\n"
            "VERDICT: holds|weak|fails — <one sentence why>")


def _zanegpt_parse(answer: str) -> dict:
    """The four answer lines -> {key: value}; a missing line is left out."""
    out = {}
    for k, lab in _ZANEGPT_ANSWER.items():
        m = re.search(r"^\W*" + lab + r"\W*:\s*(.+)$", answer, re.M | re.I)
        if m:
            out[k] = " ".join(m.group(1).split()).strip(" *")
    return out


def _zanegpt_write(text: str, ans: dict, today: str) -> str:
    """Replace any earlier check and insert the new one after `- Picked-by:`
    (else before `- Link:`, else at the end of the field list)."""
    keep = []
    skip = False
    for ln in text.splitlines():
        m = re.match(r"^-\s*([^:]+):", ln.strip())
        if m:
            skip = m.group(1).strip().lower() in _ZANEGPT_KEYS
        elif not (ln.startswith("  ") or ln.startswith("\t")):
            skip = False
        if not skip:
            keep.append(ln)
    block = [f"- {_ZANEGPT_LABELS[k]}: {ans[k]}" for k in _ZANEGPT_KEYS[:4]]
    block.append(f"- Checked by: ZaneGPT · separate agent (brain check) · {today} · "
                 f"digest {_zanegpt_digest(text)}")
    at = next((i + 1 for i, ln in enumerate(keep) if re.match(r"^-\s*Picked-by\s*:", ln.strip(), re.I)), None)
    if at is None:
        at = next((i for i, ln in enumerate(keep) if re.match(r"^-\s*Link\s*:", ln.strip(), re.I)), len(keep))
    while at < len(keep) and (keep[at].startswith("  ") or keep[at].startswith("\t")):
        at += 1
    return "\n".join(keep[:at] + block + keep[at:]) + ("\n" if text.endswith("\n") else "")


def cmd_check() -> int:
    """`brain check <proposal.md> [--answer FILE]`: run the bridge's ZaneGPT
    check on a proposal with a separate agent and write it into the file."""
    import datetime, subprocess, tempfile, shutil
    args = [a for a in sys.argv[2:] if not a.startswith("--")]
    if not args:
        return die("usage: brain check <proposal.md> [--answer FILE]")
    path = args[0]
    if not os.path.isfile(path):
        alt = os.path.join(local_root(), "memory", "incoming", os.path.basename(path))
        path = alt if os.path.isfile(alt) else path
    if not os.path.isfile(path):
        return die(f"no proposal at {args[0]}")
    text = read(path)
    if not (_field(text, "what") and _field(text, "rule of thumb")):
        return die("not a lesson proposal (no What / Rule of thumb)")
    prompt = _zanegpt_prompt(text)
    if "--answer" in sys.argv:
        answer = read(sys.argv[sys.argv.index("--answer") + 1])
    elif shutil.which("claude"):
        print("· running the ZaneGPT check in a separate agent (claude -p) …")
        try:
            r = subprocess.run(["claude", "-p", prompt], capture_output=True, text=True,
                               timeout=600, cwd=tempfile.gettempdir())
        except subprocess.TimeoutExpired:
            return die("the ZaneGPT check timed out — re-run, or use --answer")
        answer = r.stdout
    else:
        print(prompt)
        return die("no `claude` CLI here: give the prompt above to a separate agent that did "
                   "not make the pick, save its reply, then run "
                   f"`brain check {args[0]} --answer <reply.txt>`")
    ans = _zanegpt_parse(answer)
    miss = [_ZANEGPT_ANSWER[k] for k in _ZANEGPT_ANSWER if k not in ans]
    if miss:
        return die(f"the ZaneGPT answer is missing {', '.join(miss)} — nothing written:\n{answer.strip()[:600]}")
    write(path, _zanegpt_write(text, ans, datetime.date.today().isoformat()))
    v = ans["zanegpt verdict"]
    print(f"  hidden assumption: {ans['hidden assumption']}")
    print(f"  would prove it wrong: {ans['would prove it wrong']}")
    print(f"  break scenario: {ans['break scenario']}")
    return ok(f"ZaneGPT check written — verdict: {v}"
              + ("  (the steward will HOLD this until the lesson is revised)" if v.lower().startswith("fails") else ""))


def _train_label(half: str) -> None:
    print(f"\nLABEL (required): add the line `- Picked-by: {half}-half` to the memory")
    print("proposal, right after `- Composed:`. It records which half chose this target;")
    print("`brain paths` scores the two halves by it.")


def _train_new_half(entries, idx, mode, salt=0) -> bool:
    tg = _new_half_targets(entries, idx)
    if not tg:
        return False
    a, b, c, v = tg[salt % len(tg)]
    print(f"✓ train {mode} — NEW HALF: follow a strong path and bring in its companion")
    print(f"    path       {_shortf(a)}  +  {_shortf(b)}   (strength {v:.2f})")
    print(f"    companion  {_shortf(c)}   (used alongside, not yet tested with both)")
    print("\n--- AGENT INSTRUCTION (do this now) ---")
    print("STEP 1 — read what the three already established (`brain query <slug>` each).")
    print("STEP 2 — write the PREDICTION first (a number/outcome that could come out")
    print("wrong) for how the companion behaves when it runs WITH the path, then build")
    print("ONE small deterministic sandbox that exercises all three together. Iterate")
    print("until it clearly reproduces or clearly does not.")
    print("STEP 3 — FILE what the sandbox showed: one memory proposal in incoming/,")
    print("provenance `Verified first-hand`, `Composed:` naming all three (<slug>/E<id> or")
    print("ideas:<DOMAIN>/<path>).")
    _train_evidence_rule()
    _train_outcome_rule()
    return True


def _run_half(mode, entries, idx, salt=0) -> int:
    """Run a shared pass: the half whose slot it is picks the target."""
    half = _pick_half(entries, mode, salt)
    if half == "new" and _train_new_half(entries, idx, mode, salt):
        _train_zanegpt()
        _train_label("new")
        return 0
    rc = {"kernel": _train_kernel, "gap": _train_gap,
          "edge": lambda e, i: _train_seams(e, i, "edge", [])}[mode](entries, idx)
    if _paths_conf()["enabled"]:
        _train_zanegpt()
        _train_label("current")
    return rc


def _query_paths(mem_hits, idea_hits) -> list[str]:
    """Lines for `brain query`: the strongest paths out of the hits, the
    companions those paths usually travel with, and a few far-away paths into
    other subject areas that have gone quiet."""
    if not _paths_conf()["enabled"]:
        return []
    bases = _analyze_bases()
    entries = _load_entries(bases)
    idx = _slug_index(bases)
    st = _path_strengths(entries, idx)
    if not st:
        return []
    hit = {m.group(1) for m in (re.search(r"projects/([^\s#]+\.md)#E\d+", h)
                                for h in mem_hits) if m}
    for b in idea_hits:
        m = re.match(r"##\s*\[([^\]]+)\]", b)
        if m:
            hit.add(_kernel_vertex(_kernel_canon(m.group(1))))
    nbr = {}
    for (a, b), s in st.items():
        nbr.setdefault(a, {})[b] = s
        nbr.setdefault(b, {})[a] = s
    out_paths = sorted(((s, h, o) for h in hit for o, s in nbr.get(h, {}).items()
                        if o not in hit and s > 0), reverse=True)
    if not out_paths:
        return []
    lines = ["strongest paths out of the hits:"]
    shown = set()
    for s, h, o in out_paths[:5]:
        shown.add(o)
        lines.append(f"    {s:5.2f}  {_shortf(h)} → {_shortf(o)}")
    comp = sorted(((s, o, c) for _s, _h, o in out_paths[:5]
                   for c, s in nbr.get(o, {}).items()
                   if c not in hit and c not in shown and s > 0), reverse=True)
    if comp:
        lines.append("  companions (usually used alongside):")
        seen = set()
        for s, o, c in comp:
            if c in seen:
                continue
            seen.add(c)
            lines.append(f"    {s:5.2f}  {_shortf(c)}  (with {_shortf(o)})")
            if len(seen) == 3:
                break
    subs = _load_subjects()
    tags = {}
    for e in entries:
        tags.setdefault(e["file"], set()).update(e["tags"])

    def area(n):
        if n.startswith("ideas:"):
            return _subject_of({_kernel_key(n)}, subs)[0]
        return _subject_of(tags.get(n, set()), subs)[0]
    here = {area(h) for h in hit}
    asum = {}
    for n, s in _node_strength(st).items():
        asum[area(n)] = asum.get(area(n), 0.0) + s
    far = sorted(((asum.get(area(o), 0.0), -s, h, o) for s, h, o in out_paths
                  if area(o) not in here and area(o) != "Other"))
    if far:
        lines.append("  far away (paths into quieter areas):")
        seen = set()
        for _a, ns, h, o in far:
            if area(o) in seen:
                continue
            seen.add(area(o))
            lines.append(f"    {-ns:5.2f}  {_shortf(o)}  [{area(o)}]")
            if len(seen) == 2:
                break
    return lines


def _paths_score(entries, start, end, window=7) -> dict:
    """Lessons filed start..end, grouped by their `Picked-by:` label:
    {"new"|"current": (n, reused, disputed)}. Reused = another lesson cited
    this exact entry (a `Cited-by:` line) within `window` days of it."""
    import datetime
    D = datetime.date.fromisoformat
    out = {"new": [0, 0, 0], "current": [0, 0, 0]}
    for e in entries:
        m = _PICKED_RE.search(e["block"])
        try:
            d = D(e["date"][:10])
        except ValueError:
            continue
        if not m or not start <= d <= end:
            continue
        row = out[m.group(1).lower()]
        row[0] += 1
        for cd, _ref, _pol, _sb in _entry_cited_by(e["block"]):
            try:
                if 0 <= (D(cd[:10]) - d).days <= window:
                    row[1] += 1
                    break
            except ValueError:
                pass
        row[2] += e["tier"] == "disputed"
    return {k: tuple(v) for k, v in out.items()}


def cmd_paths() -> int:
    """`brain paths`: the new half's strongest paths and next picks, the
    bridge handoffs between the halves, and the reuse flow since
    trial_start (who built on whom). It reports; it passes no verdict."""
    import datetime
    require_link()
    ensure_cache(pull=True)
    conf = _paths_conf()
    bases = _shared_bases()
    entries = _load_entries(bases)
    idx = _slug_index(bases)
    st = _path_strengths(entries, idx)
    print(f"✓ paths — new half {'ON' if conf['enabled'] else 'OFF'} · "
          f"{len(st)} paths, {sum(1 for v in st.values() if v >= 1)} at 1+")
    for (a, b), v in sorted(st.items(), key=lambda x: -x[1])[:5]:
        print(f"    {v:5.2f}  {_shortf(a)} + {_shortf(b)}")
    tg = _new_half_targets(entries, idx)
    if tg:
        print("  new half's next picks (path + companion):")
        for a, b, c, v in tg:
            print(f"    {_shortf(a)} + {_shortf(b)}  →  {_shortf(c)}")
    br = _bridge(entries, idx)
    print(f"\nBRIDGE (Conscience routes, ZaneGPT checks; the owner decides)")
    print(f"  to the new half: {len(br['follow'])} current-half lesson(s) that held, built on first")
    for f in sorted(br["follow"])[:3]:
        print(f"      {_shortf(f)}")
    print(f"  to the current half: {len(br['recheck'])} lesson(s) citing a disputed lesson, audited first")
    for (f, i), (cf, ci) in sorted(br["recheck"].items())[:3]:
        print(f"      {_shortf(f)}#{i}  ← cites disputed {_shortf(cf)}#{ci}")
    trial = [e for e in entries if _PICKED_RE.search(e["block"])]
    zc = [e for e in trial if "brain check" in _field(e["block"], "checked by")]
    zv = [_field(e["block"], "zanegpt verdict").split()[0].lower() for e in zc if _field(e["block"], "zanegpt verdict")]
    print(f"  ZaneGPT (checks every pick, separate agent): {len(zc)} of {len(trial)} trial lesson(s) checked"
          + (f" · {zv.count('holds')} holds, {zv.count('weak')} weak" if zc else "")
          + " · the steward holds an unchecked or `fails` pick")
    if not conf["trial_start"]:
        return 0
    start = datetime.date.fromisoformat(conf["trial_start"])
    lab = {}
    for e in entries:
        m = _PICKED_RE.search(e["block"])
        if m:
            lab[f"projects/{e['file']}#{e['id']}"] = m.group(1).lower()
    flow = {}
    for e in entries:
        m = _PICKED_RE.search(e["block"])
        if not m:
            continue
        for cd, ref, _pol, _sb in _entry_cited_by(e["block"]):
            if cd[:10] >= str(start):
                k = (lab.get(ref, "outside"), m.group(1).lower())
                flow[k] = flow.get(k, 0) + 1
    sc = _paths_score(entries, start, datetime.date.today())
    print(f"\nSINCE {start}: new half {sc['new'][0]} lessons ({sc['new'][2]} disputed) · "
          f"current half {sc['current'][0]} ({sc['current'][2]} disputed)")
    print("  reuse flow (who built on whom):")
    for src in ("new", "current", "outside"):
        print(f"    {src:8} → new {flow.get((src, 'new'), 0):3} · current {flow.get((src, 'current'), 0):3}")
    print(f"  across the bridge: {flow.get(('new', 'current'), 0) + flow.get(('current', 'new'), 0)}")
    return 0


def _review_queues(entries, idx):
    """(audit_queue, rebuild_queue) of entries, WEAKEST LINK first.
    Audit: provisional entries — the family with the lowest review coverage
    first (so a family that has been worked a lot drops down the queue), then
    ones with a stored sandbox (there is code to read), then by how many
    entries cite them. Rebuild: audited entries that are HIGH IMPACT (cited by
    others, or a broad always/never rule) — the expensive check is reserved
    for where being wrong costs most — the family with the fewest blind
    rebuilds first."""
    cites = _entry_citations(entries, idx)
    shared = [e for e in entries if e["scope"] == "shared"]

    def impact(e):
        return cites.get((e["file"], e["id"]), 0) \
            + (1 if _BROAD_RULE_RE.search(e["rule"]) else 0)
    pend = _pending_review_targets()
    cov_any = _family_coverage(shared, "any", pend["audit"] | pend["rebuild"])
    cov_rb = _family_coverage(shared, "reverified", pend["rebuild"])
    skip = _ignored_files(shared)
    recheck = _bridge(entries, idx)["recheck"] if _paths_conf()["enabled"] else {}
    audit = sorted((e for e in shared if e["tier"] in ("provisional", "composed")
                    and e["file"] not in skip
                    and (e["file"], e["id"]) not in pend["audit"]),
                   key=lambda e: ((e["file"], e["id"]) not in recheck,
                                  cov_any[_family(e["file"])],
                                  -bool(_field(e["block"], "sandbox")),
                                  -impact(e), e["file"], e["id"]))
    rebuild = sorted((e for e in shared
                      if e["tier"] == "audited" and impact(e) > 0
                      and e["file"] not in skip
                      and (e["file"], e["id"]) not in pend["rebuild"]),
                     key=lambda e: (cov_rb[_family(e["file"])],
                                    -impact(e), e["file"], e["id"]))
    return audit, rebuild, impact


def _review_template() -> str:
    path = os.path.join(node("memory"), "REVIEW-TEMPLATE.md")
    if not os.path.isfile(path):
        return ("  (memory/REVIEW-TEMPLATE.md not in the cache yet — "
                "`brain sync` to update it)")
    return "--- REVIEW SCHEMA (memory/REVIEW-TEMPLATE.md, verbatim) ---\n" + read(path)


def _train_audit(entries, idx) -> int:
    audit, _rebuild, impact = _review_queues(entries, idx)
    tally = {}
    for e in entries:
        if e["scope"] == "shared":
            tally[e["tier"]] = tally.get(e["tier"], 0) + 1
    print("✓ train audit — check that an entry's sandbox actually TESTS its claim.")
    print("  TIERS: " + " · ".join(f"{tally.get(t, 0)} {t}" for t in TIER_ORDER))
    for line in _train_health(entries):
        print("  " + line.lstrip())
    if not audit:
        return ok("no provisional entries to audit")
    _pt = _pending_review_targets()
    cov = _family_coverage(entries, "any", _pt["audit"] | _pt["rebuild"])
    recheck = _bridge(entries, idx)["recheck"] if _paths_conf()["enabled"] else {}
    print("\nQUEUE (provisional; bridge rechecks first, then weakest family, stored sandbox, most-cited):")
    for e in audit[:5]:
        sb = "sandbox" if _field(e["block"], "sandbox") else "no sandbox"
        fam = _family(e["file"])
        why = recheck.get((e["file"], e["id"]))
        tag = f"BRIDGE: cites disputed {_shortf(why[0])}#{why[1]}; " if why else ""
        print(f"    projects/{e['file']}#{e['id']}  ({tag}{sb}; impact {impact(e)}; "
              f"family {fam} {cov[fam]:.0%} reviewed)")
    print("\n--- AGENT INSTRUCTION (do this now) ---")
    print("Pick ONE. Read the entry (`brain query <slug> --verbose` or the project file)")
    print("and its stored sandbox if it has one. You did NOT write it — if you did, skip it.")
    print("Answer three questions, and only these:")
    print("  1. Does the model COMPUTE the result, or is the answer built in (assumed)?")
    print("  2. Does what it tested cover what the Rule of thumb claims, or less?")
    print("  3. Is the claim about a real system (browser, library, API) tested only")
    print("     against a hand-written model? Then the verdict is `modeled`.")
    print("Verdict pass | fail | modeled. File ONE review in .brain/memory/incoming/")
    print("(name YYYY-MM-DD__review-<slug>.md) with the schema below, then `brain sync`.")
    print("An honest fail is as valuable as a pass — it is how the canon gets corrected.")
    print()
    print(_review_template())
    return 0


def _train_rebuild(entries, idx) -> int:
    _audit, rebuild, impact = _review_queues(entries, idx)
    print("✓ train rebuild — blind re-verification of a high-impact audited entry.")
    if not rebuild:
        return ok("no audited high-impact entries yet — run `brain train audit` first")
    e = rebuild[0]
    fam = _family(e["file"])
    cov = _family_coverage(entries, "reverified", _pending_review_targets()["rebuild"])
    print(f"\nTARGET: projects/{e['file']}#{e['id']}  (impact {impact(e)}; "
          f"family {fam} {cov[fam]:.0%} rebuilt; {len(rebuild)} queued, one per run)")
    print("CLAIM (all you get — do NOT open the entry's sandbox or Design first):")
    print(f"  What: {_field(e['block'], 'what')}")
    print(f"  Rule of thumb: {e['rule']}")
    pred = _field(e["block"], "prediction")
    if pred:
        print(f"  Author's prediction: {pred}")
    print("\n--- AGENT INSTRUCTION (do this now) ---")
    print("Write YOUR prediction first. Build your own small deterministic sandbox from")
    print("the claim above with YOUR OWN fixture and inputs — reusing the original's")
    print("setup shares its blind spots (august-10#E14) — (stdlib only; last line")
    print("`RESULT: PASS|FAIL <summary>`), run it,")
    print("and save it as .brain/memory/incoming/YYYY-MM-DD__<slug>.py. File ONE review")
    print("(Kind: rebuild) naming it, with Prediction and Observed, then `brain sync`.")
    print("Only now compare with the entry's own sandbox, and say in Checked where the")
    print("two differ (fixture, inputs, scenarios). A fail marks the entry disputed;")
    print("that is the point of the check.")
    print()
    print(_review_template())
    return 0


# --- train auto -----------------------------------------------------------
# One entry point for an unattended routine. It always runs FIVE base passes,
# one per mode in AUTO_CHAIN. A mode with no meaningful work left is SKIPPED,
# and the run owes one replacement pass per skip, run after the five, that
# trains NEW ground instead: a skipped memory pass is replaced by seeding a new
# domain or family, a skipped kernel pass by growing a new ideas kernel. At most
# ten passes (all five skipped); when no skip is left to replace the run is
# COMPLETE. The routine just calls `brain train auto --pass 1..10` in order and
# stops at the first COMPLETE.

AUTO_CHAIN = ("kernel", "edge", "audit", "rebuild", "gap")
AUTO_BASE_PASSES = len(AUTO_CHAIN)
AUTO_MAX_PASSES = 2 * AUTO_BASE_PASSES
# what trains new ground for a skipped mode: kernel-side skips grow new ideas,
# memory-side skips seed new domains / families
AUTO_REPLACEMENT = {"kernel": "newidea", "gap": "newidea",
                    "edge": "newdomain", "audit": "newdomain",
                    "rebuild": "newdomain"}


def _auto_plan(exhausted: dict, n: int):
    """(action, mode, replaces) for pass n. `exhausted` maps mode -> reason or ''.
    action: 'run' (pass n runs chain[n-1]), 'skipped' (that mode has nothing
    meaningful left; the pass does no work), 'replace' (pass n >5 runs the
    new-ground mode owed for the (n-5)th skipped base pass), or 'complete'
    (no skip left to replace, or past pass 10). Pure, so the selftest can
    negative-control it."""
    n = max(n, 1)
    if n > AUTO_MAX_PASSES:
        return "complete", None, None
    if n <= AUTO_BASE_PASSES:
        mode = AUTO_CHAIN[n - 1]
        return ("skipped", mode, None) if exhausted.get(mode) else ("run", mode, None)
    skips = [m for m in AUTO_CHAIN if exhausted.get(m)]
    k = n - AUTO_BASE_PASSES - 1
    if k < len(skips):
        return "replace", AUTO_REPLACEMENT[skips[k]], skips[k]
    return "complete", None, None


def _mode_exhausted(mode: str, entries, idx) -> str:
    """'' when `mode` still has meaningful work, else the reason it has none.
    Audit and rebuild are exhausted only when their queue is empty: the queue is
    already weakest-family-first, so there is no coverage cutoff to guess at."""
    if mode in ("kernel", "gap"):
        gaps, _reached = _kernel_gaps(entries, 1)
        return "" if gaps else "every kernel is already applied, quoted or queued"
    if mode == "edge":
        edges, _nt = _graph(entries, idx)
        single = [(a, b) for (a, b), r in edges.items() if len(r["sources"]) < 2]
        single, _same, _sat = _aim_filter(single, _stem_counts(entries), _ignored_files(entries))
        cand, _e = _seam_candidates(entries, idx)
        if single or cand:
            return ""
        return "no unsaturated single-source edge and no untested seam"
    if mode in ("audit", "rebuild"):
        audit, rebuild, _imp = _review_queues(entries, idx)
        return "" if (audit if mode == "audit" else rebuild) else "the queue is empty"
    return f"unknown mode {mode}"


def _run_mode(mode: str, entries, idx, salt: int = 0) -> int:
    if mode in NEW_HALF_MODES:
        return _run_half(mode, entries, idx, salt)
    if mode == "audit":
        return _train_audit(entries, idx)
    if mode == "rebuild":
        return _train_rebuild(entries, idx)
    if mode == "newidea":
        return _train_new_idea(entries, idx)
    return _train_new_domain(entries, idx, [])


def _train_auto(entries, idx, rest) -> int:
    n, replace = 1, ""
    for i, tok in enumerate(rest):
        if tok in ("--pass", "-p") and i + 1 < len(rest) and rest[i + 1].isdigit():
            n = int(rest[i + 1])
        elif tok == "--replace" and i + 1 < len(rest):
            replace = rest[i + 1]
        elif tok.isdigit():
            n = int(tok)
    if replace:
        if replace not in AUTO_REPLACEMENT:
            return die(f"--replace takes one of: {', '.join(AUTO_CHAIN)}")
        mode = AUTO_REPLACEMENT[replace]
        print(f"✓ train auto — replacement for the skipped `{replace}` pass: {mode}\n")
        return _run_mode(mode, entries, idx)
    cache = {}

    class _Lazy(dict):
        def get(self, mode, default=None):
            if mode not in cache:
                cache[mode] = _mode_exhausted(mode, entries, idx)
            return cache[mode]

    ex = _Lazy()
    action, mode, replaces = _auto_plan(ex, n)
    print(f"✓ train auto — pass {n} of at most {AUTO_MAX_PASSES} "
          f"(base chain: {' > '.join(AUTO_CHAIN)})")
    if action == "complete":
        print(f"AUTO: pass={n} status=complete")
        print("  RUN COMPLETE - every base pass ran, or every skipped pass already has its")
        print("  replacement. Stop here; do not run further passes.")
        return 0
    nxt = f"brain train auto --pass {n + 1}"
    if action == "skipped":
        print(f"AUTO: pass={n} mode={mode} status=skipped")
        print(f"  SKIPPED {mode}: {ex.get(mode)}.")
        print("  This pass does no training. Go on to the next pass as normal; the skip is")
        print(f"  made up by an extra replacement pass after pass {AUTO_BASE_PASSES} "
              f"({AUTO_REPLACEMENT[mode]}).")
        print(f"  NEXT: {nxt}")
        return 0
    if action == "replace":
        print(f"AUTO: pass={n} mode={mode} status=replace replaces={replaces}")
        print(f"  REPLACEMENT pass: `{replaces}` was skipped, so this pass trains new "
              f"ground instead ({mode}).\n")
    else:
        print(f"AUTO: pass={n} mode={mode} status=run")
        print(f"  running: brain train {mode}\n")
    rc = _run_mode(mode, entries, idx, n)
    print(f"\nNEXT: {nxt}  (stop when it prints RUN COMPLETE, or after pass {AUTO_MAX_PASSES})")
    return rc


def _train_default_loop(entries, idx) -> int:
    """Bare `brain train`: the optimal default loop. The TRAINING is building and
    running deterministic sandboxes that verify how systems compose; the
    edge/group graph is only a targeting tool. Prioritizes raising independence."""
    edges, _nt = _graph(entries, idx)
    comps = [c for c in _components(edges) if len(c) >= 2]
    indep = sum(1 for r in edges.values() if len(r["sources"]) >= 2)
    _deg = _edge_degree(edges)
    single = sorted(((a, b) for (a, b), r in edges.items() if len(r["sources"]) < 2),
                    key=lambda p: (min(_deg.get(p[0], 0), _deg.get(p[1], 0)), p))
    single, skip_same, skip_sat = _aim_filter(single, _stem_counts(entries), _ignored_files(entries))
    cand, _e = _seam_candidates(entries, idx)
    print("✓ train — the training is BUILDING AND RUNNING SANDBOXES that verify how")
    print("systems compose. The edge/group graph creates no knowledge; it only AIMS you.")
    print(f"\nSTATE: {len(edges)} edges · {len(comps)} clusters · independence "
          f"{indep}/{len(edges)} multi-source · {len(cand)} untested seams queued.")
    for line in _train_health(entries):
        print(line)
    if single:
        print("\nAIM — single-source edges to RE-VERIFY from a new angle (raises independence; do first):")
        for a, b in single[:4]:
            print(f"    {_shortf(a)} + {_shortf(b)}")
    if skip_same or skip_sat:
        print(f"    (skipped {skip_same} edge(s) inside one claim family and {skip_sat} touching a "
              f"family already at {SATURATION_CAP}+ sandboxes — re-verifying those adds no independence)")
    if cand:
        print("Or a high-value UNTESTED seam to extend coverage:")
        for _s, _n, a, b, sh in cand[:3]:
            print(f"    {_shortf(a)} + {_shortf(b)}  ({' '.join(sorted(sh))})")
    audit_q, rebuild_q, _imp = _review_queues(entries, idx)
    if audit_q:
        print(f"Or REVIEW existing canon ({len(audit_q)} provisional, "
              f"{len(rebuild_q)} ready for rebuild): `brain train audit` / `brain train rebuild`.")
    print("\n--- THE LOOP (repeat until done) ---")
    print("1. AIM (seconds): pick ONE target, in priority order: (a) a single-source edge")
    print("   above to re-verify; (b) a high-value untested seam; (c) a group of 2-5 related")
    print("   systems to combine in one sandbox. Prefer (a) while independence is low.")
    print("2. COMPOSE from RECORDED lessons: `brain query <slug>` each target system, read")
    print("   what each established, and state the specific claim about how they interact.")
    print("3. SANDBOX (the training, MANDATORY): write the PREDICTION first (a number/outcome")
    print("   that could come out wrong), then build a small DETERMINISTIC model (no RNG, no")
    print("   real timing; parameterize speed/seed) that reproduces the claim. Run it; iterate")
    print("   until it CLEARLY reproduces or CLEARLY refutes. A logic argument is not verification.")
    print("4. FILE what the sandbox showed: one memory proposal, provenance `Verified")
    print("   first-hand` citing the sandbox + observed numbers, `Composed:` naming every source")
    print("   entry (<slug>/E<id>) — cite 2-5 systems when genuinely exercised, to lift several")
    print("   edges at once. Push straight to incoming/ on main; the auto-steward promotes/holds.")
    print("   Ship the sandbox with it: save it as .brain/memory/incoming/<same stem>.py and")
    print("   fill `- Sandbox:`, `- Prediction:`, `- Observed:`, `- Scenarios:` (see `brain")
    print("   mine` TEMPLATE). An always/never/every rule needs 3+ scenarios, one built to")
    print("   break it — or narrow the rule to what was tested.")
    print("   If `brain sync` reports the proposal NOT pushed, fix the listed reasons in")
    print("   the file and re-run `brain sync` (up to 3 tries) before you report.")
    print("   If it CLEARLY REFUTED: still file it, with `- Polarity: incompatible`.")
    print("   If MIXED or unclear after 3 iterations: file a TENSION (open-question) in")
    print("   .brain/tension/tension-ledger.md. File NOTHING only for a duplicate.")
    print("\nINVARIANTS: the sandbox is never optional; never claim verified without a run; never")
    print("edit canon directly (incoming/ only); prefer raising independence over new single-")
    print("source edges. Report each pass in one line: target → sandbox result → filed/none.")
    print("\n(Targeted modes still exist: brain train auto [--pass N]|edge|group|combined|gap|kernel|newdomain|newidea|audit|rebuild.)")
    return 0


def cmd_train() -> int:
    """Bare `brain train` runs the optimal default loop (sandbox-verified composition,
    independence-first); the graph only aims it. The CLI has no
    LLM, so train GATHERS a target and hands the agent (reading the output) an
    explicit build instruction; the agent does the work and files the result —
    which is what actually grows the co-verification graph. EVERY mode verifies its
    output with a built-and-run sandbox model, never a logic/reasoning check (T22).
    Subcommands: auto [--pass N] · group [name] · edge · combined · gap · kernel
    · newdomain [name] · newidea · audit · rebuild (phase 2 review of existing canon)."""
    require_link()
    ensure_cache(pull=True)
    bases = _shared_bases()
    if not bases:
        return die("no canon found to train against (is the cache populated?)")
    entries = _load_entries(bases)
    idx = _slug_index(bases)
    sub = (ARGS[0].lower() if ARGS else "").strip()
    rest = ARGS[1:]
    if sub == "new" and rest and rest[0].lower() in ("domain", "idea"):
        sub, rest = "new" + rest[0].lower(), rest[1:]
    if sub == "auto":
        return _train_auto(entries, idx, rest)
    if sub == "edge":
        return _run_half("edge", entries, idx)
    if sub in ("group", "combined"):
        return _train_seams(entries, idx, sub, rest)
    if sub in ("gap", "gaps"):
        return _run_half("gap", entries, idx)
    if sub in ("kernel", "kernels"):
        return _run_half("kernel", entries, idx)
    if sub in ("newdomain", "new-domain"):
        return _train_new_domain(entries, idx, rest)
    if sub in ("newidea", "new-idea"):
        return _train_new_idea(entries, idx)
    if sub in ("audit", "audits"):
        return _train_audit(entries, idx)
    if sub in ("rebuild", "reverify"):
        return _train_rebuild(entries, idx)
    if sub:
        return die(f"unknown train mode '{sub}' "
                   "(auto | group | edge | combined | gap | kernel | newdomain | newidea | audit | rebuild)")
    return _train_default_loop(entries, idx)


def cmd_analyze() -> int:
    require_link()
    ensure_cache(pull=True)
    bases = _analyze_bases()
    if not bases:
        return die("no canon found to analyze (is the cache populated?)")
    which = (ARGS[0].lower() if ARGS else "").strip()
    if which == "rules":
        _rep_rules()
        return 0
    entries = _load_entries(bases)
    idx = _slug_index(bases)
    reports = {
        "provenance": lambda full: _rep_provenance(entries, full),
        "tags": lambda full: _rep_tags(entries, full),
        "portable": lambda full: _rep_portable(entries, full),
        "density": lambda full: _rep_density(entries, full),
        "graph": lambda full: _rep_graph(entries, idx, full),
        "groups": lambda full: _rep_groups(entries, idx, full),
        "seams": lambda full: _rep_seams(entries, idx, full),
    }
    if which in reports:
        reports[which](True)
        return 0
    if which in ("all", "full"):
        for name, fn in reports.items():
            fn(True)
            print()
        return 0
    if which and which not in reports:
        return die(f"unknown report '{which}' (try: {', '.join(reports)}, 'all', or 'rules')")
    print(f"✓ analyze — {len(entries)} lessons across {len({e['file'] for e in entries})} "
          f"projects (read-only; nothing mutated)")
    for fn in reports.values():
        fn(False)
    print("  (brain analyze <report>  for full detail; 'all' for everything; "
          "'rules' for exact thresholds)")
    return 0


