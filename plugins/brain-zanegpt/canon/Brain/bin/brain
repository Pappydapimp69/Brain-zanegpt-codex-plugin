    "doctor": cmd_doctor,
    "query": cmd_query, "paths": cmd_paths, "check": cmd_check, "challenge": cmd_challenge, "mine": cmd_mine, "sync": cmd_sync,
    "gate": cmd_gate, "install-hooks": lambda: cmd_install_hooks(),
    "unlink": cmd_unlink, "uninstall": cmd_uninstall, "curate": cmd_curate,
    "update": cmd_update, "viz": cmd_viz, "film": cmd_film, "analyze": cmd_analyze,
    "train": cmd_train, "export": cmd_export,
    "tension": cmd_tension, "scorecard": cmd_scorecard,
}


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd = COMMANDS.get(sys.argv[1])
    if not cmd:
        return die(f"unknown command '{sys.argv[1]}' (try: {', '.join(COMMANDS)})")
    return cmd()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
