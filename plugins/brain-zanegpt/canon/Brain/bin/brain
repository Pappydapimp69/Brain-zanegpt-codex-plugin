#!/usr/bin/env python3
"""brain — vendor-neutral CLI for the Brain cognitive system (v2).

The knowledge repos no longer sit beside a project. They live once per machine
in a cache (~/.brain), and each project links to that cache with a chosen
access mode. Any agent (or human) that can run a shell command can use it —
pure standard library, no dependencies.

Commands:
  brain install                       put `brain` on PATH (one-time, per machine).
                                      Always ends by asking whether to install
                                      the ZaneGPT plugin (answer required on a
                                      terminal; printed, not hung on, off one)
  brain zanegpt                       install the ZaneGPT Claude Code plugin on
                                      its own (what the install prompt runs)
  brain link [--mode read-only|full] [--cache DIR]
  brain export [--out F] [--split|--full]
                                      render the canon for readers with no
                                      shell. default: one index file (a
                                      LOCATOR — assumes the reader has the
                                      repos). --split adds per-node files +
                                      a tag index. --full inlines every
                                      entry body for a reader that CANNOT
                                      reach the repos at all
                                      link THIS project; --cache sets where the
                                      knowledge repos live (default ~/.brain; use
                                      e.g. ~/Documents/.brain if the home root is
                                      sandbox-blocked). The path is remembered, so
                                      later commands need no flag or env var.
  brain mode [read-only|full]         show or switch access mode (any time)
  brain tension                       confidence per tension, derived from its
                                      Evidence:/Decision: lines (read-only)
  brain scorecard [--sessions]        Brain and each model scored on one fixed
                                      subject tree (subjects.json), plus the
                                      owner's decisions, kept separate
                                      (--sessions lists session ids still
                                      missing a model in ~/.brain/session-models.json)
  brain stance [conversation|discussion|debate|feedback|brainstorm|brief|tts|zanegpt]
                                      show or set the collaboration stance — how
                                      the agent engages this session (default
                                      conversation). --verbose prints the full card.
  brain rearm [N]                     show/set how many prompts pass between
                                      stance re-injections (default 10, 0 off)
  brain claude-hook [on|off]          install/remove the UserPromptSubmit hook
                                      that does the re-injecting
  brain brief-gate [on|off]           show/toggle the brief gate: challenge a
                                      VAGUE human brief before planning (default
                                      on). A removable module — `off` disables it.
  brain enable | disable              turn the link on/off; disabled freezes the
                                      local store as-is and stops running
  brain status                        one-line health of the link + local store
  brain doctor                        why the intake queue is stuck, file by file
  brain query <terms...>              retrieval (main knowledge, pulled fresh)
  brain paths                         the halves and the bridge: strongest
                                      paths, next picks, handoffs, and who
                                      built on whom since trial_start
  brain check <proposal.md>           the bridge's ZaneGPT check: a separate agent
                                      writes the hidden assumption, what would
                                      prove it wrong, a break scenario and a
                                      verdict into a trial pick (steward-enforced)
  brain challenge <terms...>          ZaneGPT pressure test of what canon holds
                                      on a topic: tested vs untested, contradictions,
                                      missing variables, next move
  brain mine                          gather evidence + instruct the agent to
                                      extract lessons into the LOCAL store
  brain curate                        convert legacy stubs → proposal skeletons
  brain sync                          reconcile local store with main (also
                                      self-updates the CLI to the latest):
                                        read-only → verify + promote into LOCAL
                                        full      → verify local through main, push
  brain update                        FORCE this machine's CLI + knowledge cache to
                                      latest main (run after a merge) — refreshes
                                      every linked project here at once
  brain gate                          refusing pre-commit/CI check (exit 1 blocks)
  brain install-hooks [repo]          install the gate as a pre-commit hook
  brain unlink [--force]              undo THIS project's link (pointer, hook,
                                      local .brain store); --force if unsynced
  brain uninstall [--force]           thorough removal: this project's link +
                                      the ~/.brain cache + the PATH entry/shim
  brain viz [--out FILE]               generate a friendly static HTML page of
                                      everything in the system and open it
  brain viz --film | brain film [--out FILE]
                                      the same canon told as a short animated
                                      film: how the graph assembled, which
                                      clusters emerged, where the frontier is
  brain train [auto|group|edge|combined|gap|kernel|newdomain|newidea|audit|rebuild]
                                      turn analyze into a work-list: gather a
                                      target + hand the agent a build instruction
                                      that grows the graph (files Composed: edges)
  brain analyze [report]              read-only analytics over existing canon —
                                      no report alone edits anything. Reports:
                                        provenance  lessons still 'assumed', a
                                                    verification worklist
                                        tags        which tags ride together
                                        portable    rules-of-thumb recurring
                                                    across projects (general laws)
                                        density     where lessons cluster (hotspots)
                                        graph       co-verification edges mined from
                                                    which lessons were composed together
                                        groups      dense co-verified clusters
                                                    (emergent 'systems', a derived view)
                                        seams       high-value UNTESTED pairs to
                                                    stress-test next
                                      No arg = one-line summary of each; a name =
                                      that full report; 'all' = every full report;
                                      'rules' = exact thresholds behind graph/
                                      groups/seams/portable (for linked projects
                                      that didn't build this and need to trust it).

Quiet by default: every command prints one status line. Add --verbose for detail.
The gate enforces the involuntary-action law (tension T17): a staged diff
touching an open 🔴 tension refuses unless acknowledged (BRAIN_ACK=T11 git commit).
"""

from __future__ import annotations

import html
import json
import os
import re
import shutil
import subprocess
import sys
import time
import webbrowser
from datetime import timedelta, date

# Windows-console safety: a default cp1252 console can't encode ✓ / 🔴 / → and
# would crash Python mid-print. Detect capability from the ORIGINAL encoding,
# force replace-on-error as a crash net, and fall back to ASCII glyphs when the
# console isn't UTF-capable — so output is clean, not mojibake, and never fatal.
_UTF = "utf" in (getattr(sys.stdout, "encoding", "") or "").lower()
for _s in (sys.stdout, sys.stderr):
    try:
        _s.reconfigure(errors="replace")
    except (AttributeError, ValueError):
        pass
_ASCII = {"✓": "[ok]", "✗": "[x]", "⚠": "[!]", "🔴": "(open)", "🟡": "(lean)",
          "🟢": "(resolved)", "⚪": "(superseded)", "→": "->", "·": "-",
          "•": "-", "…": "..."}
_builtin_print = print


def print(*a, **k):  # noqa: A001 — deliberate module-scope shadow for safety
    if not _UTF and a:
        a = tuple("".join(_ASCII.get(c, c) for c in str(x)) for x in a)
    _builtin_print(*a, **k)


VERBOSE = "--verbose" in sys.argv or os.environ.get("BRAIN_VERBOSE") == "1"


def _strip_flag(argv, flag):
    """Pull `--flag value` out of a list, returning (value, remaining)."""
    if flag in argv:
        i = argv.index(flag)
        val = argv[i + 1] if i + 1 < len(argv) else None
        return val, argv[:i] + argv[i + 2:]
    return None, argv

_cache_flag, _rest = _strip_flag(sys.argv[2:], "--cache")
ARGS = [a for a in _rest if a != "--verbose"]

# knowledge repos, and the GitHub org they live under (for cache cloning)
# Bumped whenever this file changes in a way linked projects must pick up.
# `brain status` compares it against the cache's copy and flags a stale CLI.
VERSION = "2.3.0"
# Bumped ONLY when POINTER below changes. The stamp travels inside the
# injected block, so _inject_pointer can tell a current block from a stale
# one without diffing prose.
POINTER_VERSION = 2

NODES = ("Brain", "memory", "ideas", "Tension")
DEFAULT_ORG = os.environ.get("BRAIN_ORG", "Pappydapimp69")


def _resolve_cache() -> str:
    # precedence: --cache flag > BRAIN_CACHE env > this project's recorded cache
    # > ~/.brain default. The per-project fallback means a sandbox that blocks the
    # home root (e.g. the Codex Windows app) can point the cache at Documents once
    # at link time and every later command finds it with no env var to re-set.
    if _cache_flag:
        return os.path.abspath(os.path.expanduser(_cache_flag))
    if os.environ.get("BRAIN_CACHE"):
        return os.path.expanduser(os.environ["BRAIN_CACHE"])
    try:
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True).stdout.strip()
        if top:
            raw = open(os.path.join(top, ".brain", "config.json"),
                       encoding="utf-8").read()
            rec = json.loads(raw).get("cache")
            if rec and os.path.isdir(rec):
                return rec
    except (OSError, ValueError):
        pass
    return os.path.expanduser("~/.brain")


CACHE = _resolve_cache()


# ------------------------------------------------------------- output helpers

def ok(msg: str) -> int:
    print(f"✓ {msg}")
    return 0


def die(msg: str, code: int = 1) -> int:
    print(f"✗ {msg}")
    return code


def detail(msg: str) -> None:
    if VERBOSE:
        print(f"  {msg}")


def read(path: str) -> str:
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return ""


def write(path: str, text: str) -> None:
    # dirname("FILE.md") is "", and makedirs("") raises. Every existing caller
    # passes an os.path.join'd path so this never fired, but any caller taking a
    # filename from the user (`export --out FILE`) hits it immediately.
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(text)


def git(cwd: str, *args: str, check: bool = True) -> str:
    out = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if check and out.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)}: {out.stderr.strip()}")
    return out.stdout


# ------------------------------------------------------------- project config

def project_root() -> str:
    try:
        return git(os.getcwd(), "rev-parse", "--show-toplevel").strip()
    except RuntimeError:
        return os.getcwd()


def _ensure_git_repo() -> bool:
    """Make the current directory its OWN git repo if it isn't one — brain keys
    everything off git (project root, mine's history, the gate). Returns True if
    it created one. Also covers the 'no .git, but a parent dir is a repo' case,
    which otherwise makes brain treat the parent (e.g. the home folder) as the
    project."""
    cwd = os.getcwd()
    top = git(cwd, "rev-parse", "--show-toplevel", check=False).strip()
    if top and os.path.normcase(os.path.abspath(top)) == os.path.normcase(cwd):
        return False  # already its own repo
    git(cwd, "init", "--quiet", check=False)
    return True


def cfg_path() -> str:
    return os.path.join(project_root(), ".brain", "config.json")


def load_cfg() -> dict:
    raw = read(cfg_path())
    return json.loads(raw) if raw.strip() else {}


def save_cfg(cfg: dict) -> None:
    write(cfg_path(), json.dumps(cfg, indent=2) + "\n")


def _inside_cache() -> str:
    """The node repos' own path if the cwd sits inside the machine-wide cache.

    A cache dir is never a project. Commands run from one used to fail with a
    bare "not linked", which reads as "the link broke" rather than "you are
    standing in the wrong directory" — and `brain link` would cheerfully make
    the cache dir its OWN git repo and project store. Both real, both repeat
    offenders; report the actual cause instead."""
    try:
        cwd = os.path.realpath(os.getcwd())
        cache = os.path.realpath(CACHE)
    except OSError:
        return ""
    return cache if cwd == cache or cwd.startswith(cache + os.sep) else ""


def require_link(need_enabled: bool = True) -> dict:
    cfg = load_cfg()
    if not cfg:
        where = _inside_cache()
        if where:
            sys.exit(die(f"not linked — and the cwd is INSIDE the brain cache "
                         f"({where}). A cache/node directory is never a "
                         f"project: cd to the project you meant, then retry."))
        sys.exit(die("not linked — run `brain link`"))
    if need_enabled and not cfg.get("enabled", True):
        sys.exit(die("link disabled — `brain enable` to resume"))
    return cfg


# ------------------------------------------------------------- the cache

def node(name: str) -> str:
    for entry in os.listdir(CACHE) if os.path.isdir(CACHE) else []:
        if entry.lower() == name.lower():
            return os.path.join(CACHE, entry)
    return os.path.join(CACHE, name)


def ensure_cache(pull: bool = True) -> list[str]:
    """Clone missing node repos into the cache; pull main. Returns notes."""
    os.makedirs(CACHE, exist_ok=True)
    notes = []
    for name in NODES:
        path = node(name)
        if not os.path.isdir(os.path.join(path, ".git")):
            url = f"https://github.com/{DEFAULT_ORG}/{name}.git"
            detail(f"cloning {name} → {path}")
            r = subprocess.run(["git", "clone", "-q", url, path],
                               capture_output=True, text=True)
            if r.returncode != 0:
                notes.append(f"{name}: clone failed ({r.stderr.strip()[:60]})")
                continue
        if pull:
            try:
                git(path, "checkout", "-q", "main")
                git(path, "pull", "-q", "origin", "main")
            except RuntimeError as e:
                notes.append(f"{name}: pull failed ({str(e)[:50]})")
    return notes


# ------------------------------------------------------------- local store

def local_root() -> str:
    return os.path.join(project_root(), ".brain")


def ensure_local() -> None:
    """The project's private mirror of the system, format-identical to main."""
    root = local_root()
    for sub in ("memory/incoming", "memory/projects", "ideas", "tension"):
        os.makedirs(os.path.join(root, sub), exist_ok=True)
    seed = {
        "memory/PITFALLS.md": "# LOCAL PITFALLS — this project's private index\n",
        "memory/incoming/stubs.md": "# LOCAL STUBS\n\n"
                                    "<!-- append stubs below -->\n",
        "ideas/idea-repository.md": "# LOCAL IDEAS\n",
        "ideas/exploration.md": "# LOCAL EXPLORATION\n",
        "tension/tension-ledger.md": "# LOCAL TENSION LEDGER\n",
    }
    for rel, body in seed.items():
        p = os.path.join(root, rel)
        if not os.path.exists(p):
            write(p, body)


# ------------------------------------------------------------- knowledge parse

STATUS_MARKS = ("🔴", "🟡", "🟢", "⚪")
# Words a tension heading can contain that are no evidence it is the tension a
# diff touches. The original list was 15 short words, which left every ordinary
# five-letter English word in play as a keyword — and the gate needs only two
# of them to refuse a commit. Measured against four real commits from a session
# that had nothing to do with any open fork: 3 refusals, all on vocabulary
# ("phase"+"without", "asked"+"never"+"value", "assumption"+"enough"). With the
# list below and the type token dropped, the same four commits refuse 0 times,
# while a diff genuinely editing the co-verification graph still trips both
# tensions about it. A gate that cries wolf gets acknowledged reflexively,
# which is the same as not having one.
STOPWORDS = {
    "the", "with", "that", "this", "into", "over", "from", "have",
    "what", "when", "your", "their", "and", "not", "for",
    "about", "after", "again", "against", "already", "always", "another",
    "because", "before", "being", "between", "could", "during", "either",
    "enough", "every", "first", "found", "given", "going", "however",
    "itself", "least", "likely", "makes", "more", "most", "much", "must",
    "needs", "never", "often", "other", "others", "rather", "really", "same",
    "several", "should", "since", "still", "such", "than", "then", "there",
    "these", "things", "those", "through", "under", "until", "using", "value",
    "values", "very", "want", "were", "where", "whether", "which", "while",
    "whole", "whose", "will", "within", "without", "would", "asked", "asks",
}


def _norm(s: str) -> str:
    return s.lower().replace("-", "").replace("/", " ")


def matches(block: str, terms: list[str]) -> bool:
    low = block.lower()
    flat = _norm(block)
    return any(t.lower() in low or _norm(t) in flat for t in terms)


def _incoming_proposals(mem_root: str) -> list[tuple[str, str, bool]]:
    """Proposals sitting in an intake queue: (filename, body, held).

    These are NOT canon and must never be quoted as if they were. They still
    have to be VISIBLE, because the alternative is what this system did until
    now: a lesson the owner wrote, that failed the schema check and was held,
    is unreachable by `brain query` — so the tool answers "no records — valid;
    proceed" about ground somebody has already covered.

    That is not a missing feature, it is a wrong answer, and it is worse than
    an empty system: an agent that is told nothing is there goes and learns it
    again. It happened in this repo's own history — `brain query preflight`
    returned 0 while a preflight lesson sat held on every field.
    """
    d = os.path.join(mem_root, "incoming")
    if not os.path.isdir(d):
        return []
    out = []
    for f in sorted(os.listdir(d)):
        if not f.endswith(".md") or f in ("README.md", "TEMPLATE.md", "stubs.md"):
            continue
        body = read(os.path.join(d, f))
        out.append((f, body, "STEWARD HOLD" in body))
    return out


def _memory_index(base: str) -> list[str]:
    entries, cur = [], None
    for line in read(os.path.join(base, "PITFALLS.md")).splitlines():
        if line.startswith("- `["):
            if cur:
                entries.append(cur)
            cur = line
        elif cur and line.startswith("  "):
            cur += " " + line.strip()
        else:
            if cur:
                entries.append(cur)
            cur = None
    if cur:
        entries.append(cur)
    return entries


def _blocks(text: str, marker: str) -> list[str]:
    blocks, cur = [], None
    for line in text.splitlines():
        if line.startswith(marker):
            if cur:
                blocks.append("\n".join(cur))
            cur = [line]
        elif cur is not None:
            if line.startswith("## ") and not line.startswith(marker):
                blocks.append("\n".join(cur))
                cur = None
            else:
                cur.append(line)
    if cur:
        blocks.append("\n".join(cur))
    return blocks


def entry_status(b: str) -> str:
    """A tension's status is its `Lean:` line's FIRST mark. Scanning the whole
    block for the first mark in STATUS_MARKS order read any entry whose history
    mentions a transition (`🔴→🟡`) or keeps its original lean as 🔴 open — T20
    and a governance fork were reported open while leaning. Blocks with no
    Lean line (status in the heading) keep the old whole-block rule."""
    lines = b.splitlines()
    lean = [l for l in lines if re.match(r"\s*Lean\s*:", l)]
    # the field that STATES the status wins over prose that mentions one:
    # Lean line, else the heading, else the old whole-block scan
    for line in lean[:1] + lines[:1]:
        hits = [(line.find(m), m) for m in STATUS_MARKS if m in line]
        if hits:
            return min(hits)[1]
    return next((m for m in STATUS_MARKS if m in b), "")


# ------------------------------------------------------------- commands

def cmd_link() -> int:
    where = _inside_cache()
    if where:
        return die(f"refusing to link — the cwd is INSIDE the brain cache "
                   f"({where}). Linking here would git-init the node repo's "
                   f"own subfolder and plant a .brain store in it. cd to the "
                   f"real project first.")
    cfg = load_cfg()
    first = not cfg
    mode = None
    if "--mode" in ARGS:
        mode = ARGS[ARGS.index("--mode") + 1]
    if first and not mode:
        # interactive prompt only on first link
        if sys.stdin.isatty():
            print("First link. Choose access mode:")
            print("  [1] read-only — reads main, writes only to this project's "
                  "local store, never pushes")
            print("  [2] full      — reads, writes, and pushes to main")
            choice = input("mode [1/2]: ").strip()
            mode = "full" if choice == "2" else "read-only"
        else:
            mode = "read-only"
            detail("non-interactive: defaulting to read-only")
    mode = mode or cfg.get("mode", "read-only")
    if mode not in ("read-only", "full"):
        return die(f"unknown mode '{mode}' (read-only|full)")

    inited = _ensure_git_repo()
    notes = ensure_cache(pull=True)
    if inited:
        notes.append("initialized a git repo here (was not one)")
    ensure_local()
    cfg.update({"mode": mode, "enabled": True, "org": DEFAULT_ORG,
                "cache": CACHE, "stance": cfg.get("stance", "conversation")})
    save_cfg(cfg)
    _inject_pointer()
    if not load_cfg().get("hooked"):
        cmd_install_hooks(silent=True, target=project_root())
        cfg["hooked"] = True
        save_cfg(cfg)
    for n in notes:
        detail(n)
    warn = f" ({len(notes)} cache warning(s); --verbose)" if notes else ""
    return ok(f"linked ({mode}){warn}")


PTR_OPEN = "<!-- brain:pointer v{} — managed by `brain link`/`sync`; edits here are overwritten -->"
PTR_CLOSE = "<!-- /brain:pointer -->"

POINTER = (
    "\n## Cognitive system: Brain (linked via `brain` CLI)\n"
    "This project is linked to the Brain cognitive system. Do not read the node\n"
    "repos directly — use the CLI.\n"
    "\n"
    "**How to invoke it (try in order, use the first that runs):**\n"
    "1. `brain <cmd>`\n"
    "2. if `brain` is not found: `python \"$HOME/.brain/Brain/bin/brain\" <cmd>`\n"
    "   (Windows PowerShell: `python \"$env:USERPROFILE\\.brain\\Brain\\bin\\brain\" <cmd>`)\n"
    "\n"
    "When the user asks anything like \"query save\" / \"ask brain X\" / \"mine this\",\n"
    "run the matching `brain` command yourself — do not make the user type paths.\n"
    "Before non-trivial work: `brain query <terms>`. To capture lessons, write a\n"
    "proposal file + `brain sync` (or `brain mine` for a work-list). `brain sync`\n"
    "reconciles with main. Keep session output minimal.\n"
    "\n"
    "### Using Brain well (read this before deciding it's empty)\n"
    "- **Query with 1-2 KEYWORDS, not sentences.** `brain query reachability`, not\n"
    "  `brain query \"ai cannot reach the exit on a walled map\"`. The matcher is\n"
    "  keyword-based; long phrases return 0. **A 0-result query almost always means\n"
    "  rephrase, not \"empty system\"** — try broader / single terms first, and read\n"
    "  the `local:` bucket, not just the shared counts.\n"
    "- **Re-query at each NEW sub-problem, not only at session start.** Every\n"
    "  non-trivial bug or decision is its own retrieval trigger.\n"
    "- **Capture non-bugs too, not only bugs:** reusable pattern -> `ideas`;\n"
    "  unresolved fork -> `tension`; experiment/synthesis -> `exploration`; a\n"
    "  committed decision -> an ADR in the build (and if it generalizes, ALSO an\n"
    "  `ideas` kernel). See `orchestration.md`'s write-back table.\n"
    "- **At each milestone, produce a Cognitive Update UNPROMPTED** (New Ideas,\n"
    "  Memory, Tensions, Exploration, Graduation Candidates) — the standing rule in\n"
    "  `orchestration.md`.\n"
    "- **Surface any open (red/yellow) tension that touches your work to the user**\n"
    "  before committing to that fork.\n"
    "- **Never hand-write a proposal format.** `brain mine` prints the current\n"
    "  schema verbatim from the memory repo — follow it exactly. A format you\n"
    "  invent parses as an EMPTY entry and is held on every field at once.\n"
)


def _pointer_block() -> str:
    return (PTR_OPEN.format(POINTER_VERSION) + POINTER.rstrip() + "\n"
            + PTR_CLOSE + "\n")


# Every heading the pointer itself has ever used, lowercased. An unmarked
# pointer can only be found by its text, so this set is what tells us where the
# block ENDS.
POINTER_HEADINGS = ("cognitive system: brain", "using brain well")
_HEADING_RE = re.compile(r"^#{1,6}\s")


def _is_pointer_heading(line: str) -> bool:
    text = line.lstrip("#").strip().lower()
    return any(text.startswith(h) for h in POINTER_HEADINGS)


def _strip_legacy_pointer(body: str) -> str:
    """Remove a pre-marker pointer block: the '## Cognitive system: Brain'
    heading down to the first heading that is not the pointer's own.

    The rule used to be "down to the next `## `", on the reasoning that the
    pointer's subheadings are all `### ` so any `## ` must be outside it. That
    holds for the pointer and says nothing about the OWNER's text. A CLAUDE.md
    whose hand-written sections sat under the pointer as `### ` had no `## `
    left before EOF, so the scan ran to the end of the file and deleted them.

    SEVEN lost its fork lineage, five Brain entry references and a note about
    an inherited red test exactly this way, on an ordinary `brain link` — and
    silently, because the upgrade reports "pointer refreshed" either way. Every
    project still on an unmarked pointer is one link away from the same thing,
    which is why this is a fix and not a footnote.

    Ending the block on the first UNRECOGNISED heading means the worst case is
    now leaving a stale line behind rather than eating an owner's work.
    """
    lines, out, inside, removed = body.splitlines(True), [], False, 0
    for line in lines:
        if not inside and line.startswith("## ") and "Cognitive system: Brain" in line:
            inside, removed = True, removed + 1
            continue
        if inside and _HEADING_RE.match(line) and not _is_pointer_heading(line):
            inside = False
        if inside:
            removed += 1
            continue
        out.append(line)
    if removed:
        detail(f"replaced an unmarked pointer block ({removed} lines)")
    return "".join(out)


def _inject_pointer() -> None:
    """Write the pointer, and REWRITE it when it is out of date.

    This used to return early whenever a pointer existed, so a project kept the
    text it was linked with forever — a stale copy no `brain update` could reach
    (each project holds its own). The version stamp makes the block replaceable,
    so a POINTER change propagates on the next `link` or `sync`.
    """
    root = project_root()
    target = next((os.path.join(root, n) for n in ("CLAUDE.md", "AGENTS.md")
                   if os.path.exists(os.path.join(root, n))), None)
    if not target:
        target = os.path.join(root, "CLAUDE.md")
    body = read(target)
    current = _pointer_block()

    if PTR_OPEN.format(POINTER_VERSION) in body:
        return                                   # already current

    verb = "added"
    if PTR_CLOSE in body:                        # marked, but an older version
        head, _, rest = body.partition("<!-- brain:pointer ")
        _, _, tail = rest.partition(PTR_CLOSE)
        body, verb = head.rstrip() + "\n" + tail.lstrip("\n"), "refreshed"
    elif "Cognitive system: Brain" in body:      # legacy, unmarked
        body, verb = _strip_legacy_pointer(body), "refreshed"

    write(target, (body.rstrip() + "\n" if body.strip() else "") + current)
    detail(f"pointer {verb} in {os.path.basename(target)} (v{POINTER_VERSION})")


def cmd_mode() -> int:
    cfg = require_link(need_enabled=False)
    if not ARGS:
        return ok(f"mode: {cfg.get('mode')}"
                  f"{'' if cfg.get('enabled', True) else ' (DISABLED)'}")
    new = ARGS[0]
    if new not in ("read-only", "full"):
        return die(f"unknown mode '{new}' (read-only|full)")
    cfg["mode"] = new
    save_cfg(cfg)
    return ok(f"mode → {new}")


# Collaboration stances — HOW the agent engages this session (orthogonal to the
# read-only/full access `mode`). The default is conversation; the others shape
# posture and lean on a knowledge node. Quiet by default prints the one-liner;
# --verbose prints the full card the agent adopts.
STANCES = {
    "conversation": (
        "normal collaborative help — answer, move the task forward, stay balanced",
        "CONVERSATION (default): engage as a normal collaborator. Understand the ask,\n"
        "help directly, keep the task moving. Balanced and responsive; no special\n"
        "posture. Reach for another stance only when the work calls for it."),
    "discussion": (
        "explore a topic together — surface angles and trade-offs, don't rush a verdict",
        "DISCUSSION: explore WITH the user. Lay out the key considerations, trade-offs,\n"
        "and open questions; hold several angles at once; think out loud. Don't collapse\n"
        "to one answer prematurely — map the space first. (leans on the tension node)"),
    "debate": (
        "argue positions — steelman each side, challenge assumptions, press for evidence",
        "DEBATE: take a side and argue it, or argue opposing sides in turn. Steelman\n"
        "before you strike; challenge the user's assumptions; demand evidence; concede\n"
        "real points. Adversarial but honest — the aim is a stronger conclusion, not a\n"
        "win. (leans on the tension node's poles)"),
    "feedback": (
        "critique the work — weak/risky/missing first, specific, with fixes",
        "FEEDBACK: critique mode. Lead with what's weak, risky, or missing — highest\n"
        "impact first. Be specific and direct, point at the exact spot, and pair every\n"
        "problem with a concrete fix. Praise only what's load-bearing. (leans on\n"
        "memory's pitfalls)"),
    "brainstorm": (
        "diverge — many options fast, defer judgment, build don't criticize",
        "BRAINSTORM: diverge. Generate many options quickly; quantity and range over\n"
        "polish; defer ALL judgment during the generating pass; build on ideas rather\n"
        "than criticize them. Sort and cull afterward. (feeds ideas / exploration.md)"),
    "brief": (
        "answer tersely — direct answer or action, skip preamble and over-explanation",
        "BRIEF: reply tersely. Give the direct answer or action and stop; no restating\n"
        "the question, no preamble, no multi-paragraph rationale. One or two sentences\n"
        "where the task allows it. Expand past that only if the user asks for detail or\n"
        "the question genuinely can't be answered correctly in short form."),
    # ZANEGPT — the persona stance. Every other stance shapes POSTURE; this one
    # also sets VOICE, and voice is the part that decays. It lives here rather
    # than in a one-time instruction for the reason canon already records under
    # [VOICE / consistency / style-is-per-request-not-session-state]: a register
    # asked for once sinks under the next ten turns while `brain status` still
    # cheerfully reports it as set. The hook re-sends this; a chat message
    # cannot re-send itself.
    "zanegpt": (
        "answer in character as ZaneGPT — analytical, premise-testing, agency-first",
        "ZANEGPT: reply in character, not in a generic assistant register. This is the\n"
        "voice for EVERY reply in the session — status lines, results, corrections and\n"
        "refusals included — not a mode that waits to be named. Infer the real goal.\n"
        "Test the premise instead of accepting it. Name the variables the request is\n"
        "missing. Keep observation, interpretation and recommendation apart so the user\n"
        "can disagree with one without losing the others. Surface the contradiction,\n"
        "the tradeoff, the competing explanation — not the reassurance. Dry where it\n"
        "fits; never contrarian for sport; never padded. End on the concrete next move.\n"
        "A voice is not a disguise: if someone sincerely asks what they are talking to,\n"
        "answer honestly, and the character never overrides a safety, privacy or\n"
        "tool-use rule. (pairs with the zanegpt skill)"),
    # SANDBOX — under evaluation against `brief`. Terser than `brief` because a
    # spoken reply cannot be skimmed: every sentence that is not the answer is
    # paid for in listening time.
    #
    # The caveat clause is load-bearing, not politeness. Without it "no extra
    # explanations" reads as absolute and drops caveats that change the answer —
    # which is exactly the failure HOOK.md's reply-style rule names: default to
    # compressing, never default to concealing. One sentence is the ceiling, so
    # it cannot grow back into prose.
    #
    # The offer clause SHORTENS replies rather than lengthening them: spoken
    # instructions are the worst case for this channel — a list of steps cannot
    # be skimmed, re-read, or copied — so proposing the action replaces the
    # recital instead of adding to it. An offer, never an auto-apply: the user
    # is talking, not reviewing a diff.
    "tts": (
        "terse for speech — direct response only; caveat in one sentence, offer the fix",
        "TTS: Terse replies. Direct response to my prompt only and no extra\n"
        "explanations. If a caveat changes the answer, say it in one sentence.\n"
        "If the fix is one you can apply, offer to apply it in one short question\n"
        "instead of listing the steps."),
}


def cmd_stance() -> int:
    cfg = require_link(need_enabled=False)
    cur = cfg.get("stance", "conversation")
    if not ARGS:
        one, card = STANCES.get(cur, STANCES["conversation"])
        detail(card)
        return ok(f"stance: {cur} — {one}")
    new = ARGS[0]
    if new not in STANCES:
        return die(f"unknown stance '{new}' ({'|'.join(STANCES)})")
    cfg["stance"] = new
    save_cfg(cfg)
    one, card = STANCES[new]
    detail(card)
    return ok(f"stance → {new} — {one}")


def cmd_brief_gate() -> int:
    """The brief gate — a self-contained, reversible module. When ON (default), a
    session that receives a VAGUE human brief flags it and sharpens it WITH the
    user before planning or building (a weak/scattered `brain query` result is the
    tell). Condition-scoped: it fires ONLY on an actionable brief a person handed
    you — it does NOT fire when there is no human brief (auto/self-directed runs
    pick their own well-formed task and gate that their own way). `brain
    brief-gate off` disables it in one line if it proves noisy."""
    cfg = require_link(need_enabled=False)
    cur = cfg.get("brief_gate", True)
    if not ARGS:
        return ok(f"brief-gate: {'on' if cur else 'off'}")
    new = ARGS[0].lower()
    if new not in ("on", "off"):
        return die("usage: brain brief-gate [on|off]")
    cfg["brief_gate"] = (new == "on")
    save_cfg(cfg)
    return ok(f"brief-gate → {new}")


# --------------------------------------------------- stance re-arm (the hook)

REARM_DEFAULT = 10


def _stance_card(cfg: dict) -> str:
    """The stance card plus whichever modifiers are on, as one block.

    Printing this ONCE at `brain stance` was the whole defect: a stance is
    stored durably but injected once, so it sinks under later turns and the
    agent drifts back to its default register while `brain status` still
    reports the stance as set. This is the text the hook re-sends.
    """
    name = cfg.get("stance", "conversation")
    _, card = STANCES.get(name, STANCES["conversation"])
    lines = ["[brain] active stance — this is current, not history:", "", card]
    mods = []
    if not cfg.get("xplain", False):
        mods.append("xplain OFF — no restating the question or your plan, no "
                    "justifying an answer that was not challenged, no defining "
                    "terms already used correctly, no unasked-for alternatives, "
                    "no 'why this matters' closers, no preamble. This never "
                    "suppresses the answer itself, a flagged risk or conflict, "
                    "what you could not do, or reasoning the stance exists to "
                    "produce.")
    if cfg.get("brief_gate", True):
        mods.append("brief-gate ON — challenge a vague brief and sharpen it "
                    "with the user before planning or building.")
    mods.append("Terse is not compliant. A real conflict, risk or wrong "
                "assumption in the request is part of the answer, not extra — "
                "say it in a line. The same goes for anything unsafe you hit "
                "while working. Stop and ask only if proceeding either way "
                "would waste work or be hard to undo.")
    if mods:
        lines += ["", "Modifiers:"] + [f"- {m}" for m in mods]
    return "\n".join(lines)


def _tick_path() -> str:
    return os.path.join(local_root(), "stance-tick.json")


def cmd_stance_tick() -> int:
    """UserPromptSubmit hook body: re-send the stance card every N prompts.

    Prints a hook JSON envelope on an injection turn and NOTHING otherwise, so
    it costs one line of context per N turns. Fails silent and exit 0 on every
    error — a broken counter must never block the user's prompt.
    """
    try:
        payload = json.loads(sys.stdin.read() or "{}") if not sys.stdin.isatty() else {}
    except (ValueError, OSError):
        payload = {}
    try:
        cfg = load_cfg()
        if not cfg or not cfg.get("enabled", True):
            return 0
        every = int(cfg.get("stance_rearm", REARM_DEFAULT))
        if every <= 0:
            return 0

        session = str(payload.get("session_id", ""))
        state = {}
        if os.path.exists(_tick_path()):
            try:
                state = json.loads(read(_tick_path())) or {}
            except ValueError:
                state = {}
        # A new session re-arms immediately: the first prompt is exactly when
        # the card is cheapest and most load-bearing.
        n = 0 if state.get("session") != session else int(state.get("n", 0)) + 1
        ensure_local()
        write(_tick_path(), json.dumps({"session": session, "n": n}))
        if n % every:
            return 0
        print(json.dumps({
            "hookSpecificOutput": {
                "hookEventName": "UserPromptSubmit",
                "additionalContext": _stance_card(cfg),
            },
            "suppressOutput": True,
        }))
    except Exception:
        return 0
    return 0


def cmd_rearm() -> int:
    """Show or set how many prompts pass between stance re-injections."""
    cfg = require_link(need_enabled=False)
    cur = int(cfg.get("stance_rearm", REARM_DEFAULT))
    if not ARGS:
        return ok(f"stance re-arm: every {cur} prompt(s)"
                  + ("" if cur else " (off)"))
    try:
        new = int(ARGS[0])
    except ValueError:
        return die("usage: brain rearm <N>   (0 disables)")
    if new < 0:
        return die("re-arm interval cannot be negative")
    cfg["stance_rearm"] = new
    save_cfg(cfg)
    return ok(f"stance re-arm → every {new} prompt(s)" if new
              else "stance re-arm → off")


def cmd_claude_hook() -> int:
    """Install/remove the UserPromptSubmit hook in this project's Claude Code
    settings. Separate from `install-hooks`, which installs the git pre-commit
    gate — different runtime, different file, deliberately not merged."""
    cfg = require_link(need_enabled=False)
    path = os.path.join(project_root(), ".claude", "settings.json")
    want_off = ARGS and ARGS[0].lower() == "off"
    data = {}
    if os.path.exists(path):
        try:
            data = json.loads(read(path)) or {}
        except ValueError:
            return die(f"{path} is not valid JSON — fix it first; a malformed "
                       "settings file silently disables every setting in it")

    cli = os.path.join(node("Brain"), "bin", "brain")
    cmd = f'python3 "{cli}" stance-tick'
    entries = data.setdefault("hooks", {}).setdefault("UserPromptSubmit", [])
    entries[:] = [e for e in entries
                  if not any("stance-tick" in h.get("command", "")
                             for h in e.get("hooks", []))]
    if want_off:
        if not entries:
            data["hooks"].pop("UserPromptSubmit", None)
        if not data.get("hooks"):
            data.pop("hooks", None)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        write(path, json.dumps(data, indent=2) + "\n")
        return ok("stance hook removed")

    entries.append({"hooks": [{"type": "command", "command": cmd,
                               "timeout": 10}]})
    os.makedirs(os.path.dirname(path), exist_ok=True)
    write(path, json.dumps(data, indent=2) + "\n")
    every = int(cfg.get("stance_rearm", REARM_DEFAULT))
    detail(f"wrote {path}")
    return ok(f"stance hook installed — re-arms every {every} prompt(s); "
              "open /hooks once so Claude Code reloads settings")


def cmd_disable() -> int:
    cfg = require_link(need_enabled=False)
    cfg["enabled"] = False
    save_cfg(cfg)
    return ok("link disabled — local store frozen; `brain enable` to resume")


def cmd_enable() -> int:
    cfg = require_link(need_enabled=False)
    cfg["enabled"] = True
    save_cfg(cfg)
    return ok(f"link enabled ({cfg.get('mode')})")


def _cli_stale() -> str:
    """'' if this CLI is current, else the NEWER version sitting in the cache.

    Compared as text rather than by import: the cache copy is a file on disk,
    not a module, and may be newer than the process already running.

    Ordered, not merely different. Plain inequality reported "v2.3.0 STALE
    (v2.2.0 on main)" the moment anyone ran a CLI they had just edited — the
    development case, and the one where a false staleness warning is most
    likely to be believed and acted on.
    """
    def parts(v):
        return tuple(int(x) if x.isdigit() else -1 for x in v.split("."))
    try:
        txt = read(os.path.join(node("Brain"), "bin", "brain"))
        m = re.search(r'^VERSION = "([^"]+)"', txt, re.M)
    except OSError:
        return ""
    return m.group(1) if m and parts(m.group(1)) > parts(VERSION) else ""


# The nine fields the memory repo's validator requires of a proposal. Kept as a
# literal rather than imported: the validator lives in another repo that may not
# be checked out, and a doctor that cannot run without it is a doctor nobody runs.
PROPOSAL_FIELDS = ("tags", "what", "why built", "design", "got right",
                   "where/why", "fix", "why this fix", "rule of thumb",
                   "provenance", "link")
# The eight narrative fields the steward holds if under MIN_SUBSTANCE chars.
PROPOSAL_SUBSTANCE = ("what", "why built", "design", "got right", "where/why",
                      "fix", "why this fix", "rule of thumb")
PROPOSAL_MIN_SUBSTANCE = 30
# Same bullet grammar the steward parses (memory/scripts/steward.py FIELD_RE):
# a field is a real `- Label:` line, not a word that happens to appear in prose.
_PROPOSAL_FIELD_RE = re.compile(
    r"^\s*-\s*\**([A-Za-z/ ]+?)\**\s*(?:\(.*?\))?\s*:\s*(.*)$")


def _proposal_fields(text: str) -> dict:
    """Parse `- Label: value` bullets the way the steward does (indented lines
    continue the previous field), so doctor and the steward agree on what a
    proposal contains."""
    fields, key = {}, None
    for line in text.splitlines():
        m = _PROPOSAL_FIELD_RE.match(line)
        if m and len(m.group(1).strip()) < 30:
            key = m.group(1).strip().lower()
            fields[key] = m.group(2).strip()
        elif key and (line.startswith("  ") or line.startswith("\t")):
            fields[key] += " " + line.strip()
        else:
            key = None
    return fields


def cmd_doctor() -> int:
    """Say why the intake queue is stuck, file by file.

    A held proposal reports the same eleven "missing field" lines as every other
    held proposal, so a queue of them looks like one problem repeated and gets
    read as noise. It is not one problem: some are a mechanical rename away from
    promoting and some genuinely have no such field written. Those need
    different work from different people, and until something separates them the
    whole queue sits there being equally hopeless.

    This reports; it does not rewrite. The steward owns canon, and a tool that
    edits someone's lessons until its own check passes is worse than the check.
    """
    require_link()
    rows = _incoming_proposals(node("memory"))
    if not rows:
        return ok("intake queue empty")
    clean, shape, other = [], [], []
    for f, body, held in rows:
        # Check the PROPOSAL, not the hold block appended to it. A steward hold
        # spells out "missing field 'tags'" for every field it wants, so
        # scanning the whole file finds all nine field names in the complaint
        # about their absence and reports the queue as perfectly healthy.
        proposal = body.split("STEWARD HOLD")[0]
        fields = _proposal_fields(proposal)
        if re.search(r"^##\s*REVIEW\s*$", proposal, re.M):
            missing = [x for x in ("target", "kind", "verdict", "checked", "link")
                       if not any(k.startswith(x) for k in fields)]
            if not held:
                clean.append(f)
            elif missing:
                shape.append((f, missing, False))
            else:
                block = body[body.find("STEWARD HOLD"):]
                other.append((f, [l.strip("- ").strip() for l in block.splitlines()
                                  if l.startswith("- ")][:3]))
            continue
        # A field counts only as a real `- Label:` bullet (prefix match, as in
        # the steward). A bare substring test passes a proposal that never wrote
        # `- Design:` because the word "design" appears somewhere in its prose.
        missing = [x for x in PROPOSAL_FIELDS
                   if not any(k.startswith(x) for k in fields)]
        if not re.search(r"^\s*-\s*ID\s*:", proposal, re.M):
            missing.append("id")
        thin = [x for x in PROPOSAL_SUBSTANCE
                if any(k.startswith(x) for k in fields)
                and len(next(v for k, v in fields.items() if k.startswith(x)))
                < PROPOSAL_MIN_SUBSTANCE]
        missing += [f"{x} (under {PROPOSAL_MIN_SUBSTANCE} chars)" for x in thin]
        if not held:
            clean.append(f)
        elif missing:
            shape.append((f, missing,
                          bool(re.search(r"^##+\s*(what|tags|design|fix)\b", body, re.M | re.I))))
        else:
            # Every field name is present and the steward still refused it, so
            # the reason is not "which fields" — quote what it actually said
            # rather than guessing, which is what the identical eleven-line
            # hold blocks made everyone do.
            block = body[body.find("STEWARD HOLD"):]
            why = [l.strip("- ").strip() for l in block.splitlines()
                   if l.startswith("- ")][:3]
            other.append((f, why))
    print(f"intake queue: {len(rows)} proposal(s)")
    if clean:
        print(f"\n  {len(clean)} not held — waiting on the steward:")
        for f in clean:
            print(f"    {f}")
    if shape:
        head = [f for f, _, h in shape if h]
        print(f"\n  {len(shape)} missing field labels the validator looks for.")
        if head:
            print(f"  {len(head)} of them wrote those fields as `## Headings` — "
                  "the content is there, the shape is not. Rewrite each as a "
                  "`- Field:` line; `brain mine` prints the schema verbatim.")
        for f, m, h in shape:
            print(f"    {f}{'   (heading-style)' if h else ''}")
            print(f"      missing: {', '.join(m)}")
    if other:
        print(f"\n  {len(other)} carry every field name and were still held. "
              "The steward's own reasons:")
        for f, why in other:
            print(f"    {f}")
            for w in why:
                print(f"      {w}")
    print("\nUntil a proposal promotes it is invisible to `brain query`'s canon "
          "buckets, so every lesson above is one the system has been told and "
          "cannot answer with.")
    return 0


def cmd_status() -> int:
    cfg = load_cfg()
    if not cfg:
        return die("not linked — run `brain link`")
    if not cfg.get("enabled", True):
        return ok(f"linked ({cfg.get('mode')}) · DISABLED · local store frozen")
    stubs = [l for l in read(os.path.join(local_root(), "memory", "incoming",
             "stubs.md")).splitlines() if l.startswith("- ")]
    props = [f for f in os.listdir(os.path.join(local_root(), "memory",
             "incoming")) if f.endswith(".md")
             and f not in ("stubs.md", "README.md", "TEMPLATE.md")] \
        if os.path.isdir(os.path.join(local_root(), "memory", "incoming")) else []
    gate = "" if cfg.get("brief_gate", True) else " · brief-gate off"
    # Kernels and forks count too. Reporting only memory here is what let a
    # written-but-unpushed tension sit in a store the status line called empty.
    other = (len(_local_proposal_files("ideas")) + len(_local_ideas_blocks())
             + len(_local_proposal_files("tension")) + len(_local_tension_blocks()))
    extra = f", {other} idea/tension finding(s)" if other else ""
    newer = _cli_stale()
    stale = f" · CLI v{VERSION} STALE (v{newer} on main — `brain update`)" if newer else ""
    # The SHARED intake queue, which is nobody's local store and was therefore
    # in nobody's status line. A held proposal is invisible to `brain query`
    # too, so a backlog of them is a set of lessons the system has been told
    # and cannot answer with — the one number most worth seeing on a status.
    shared = _incoming_proposals(node("memory"))
    held = sum(1 for _, _, h in shared if h)
    queue = ""
    if shared:
        queue = (f" · intake queue: {len(shared)} proposal(s)"
                 + (f", {held} HELD (invisible to `brain query`)" if held else ""))
    return ok(f"linked ({cfg.get('mode')}, {cfg.get('stance', 'conversation')}){gate}{stale} · "
              f"local: {len(stubs)} stub(s), {len(props)} proposal(s){extra} awaiting sync{queue}")


def _shared_canon() -> list:
    """The four shared-canon sources, in retrieval order, as (label, entries).

    Defined once on purpose: `query` filters this and `export` renders it, so a
    node added here reaches both. Two copies of this list is exactly how an
    export silently stops representing what the CLI actually searches — the
    index still looks healthy while pointing at a canon that has moved.
    """
    return [
        ("memory", _memory_index(node("memory"))),
        ("tension", _blocks(read(os.path.join(
            node("Tension"), "tension-ledger.md")), "### ")),
        ("ideas", _blocks(read(os.path.join(
            node("ideas"), "idea-repository.md")), "## [")),
        ("exploration", _blocks(read(os.path.join(
            node("ideas"), "exploration.md")), "### ")),
    ]


# Where each node's entries actually live, so a reader without a shell can open
# the source rather than trust the digest.
_CANON_FILES = {
    "memory": "memory/PITFALLS.md",
    "tension": "Tension/tension-ledger.md",
    "ideas": "ideas/idea-repository.md",
    "exploration": "ideas/exploration.md",
}


def _clip(text: str, width: int) -> str:
    text = " ".join(text.split())
    if len(text) <= width:
        return text
    return text[:width].rsplit(" ", 1)[0] + "…"


def _index_line(block: str, width: int = 130) -> str:
    """One catalogue bullet for one canon entry.

    The two canon shapes need different handling and conflating them is what
    made the first version unreadable: a memory entry is a SINGLE line
    (`- `[tags]` lesson → path#E1`), so treating line one as a heading and the
    remainder as the gist produced 678 entries that were all heading and no
    gist. Tension/ideas/exploration entries are real multi-line blocks where
    that split is correct.
    """
    lines = [ln.strip() for ln in block.splitlines() if ln.strip()]
    if not lines:
        return ""

    first = lines[0]
    if first.startswith("- `["):
        # memory: tags, lesson, and the anchor that locates the full entry.
        body = first[1:].strip() if first.startswith("-") else first
        anchor = ""
        if "→" in body:
            body, anchor = body.rsplit("→", 1)
            anchor = anchor.strip()
        tags, _, lesson = body.partition("` ")
        tags = (tags + "`").strip()
        out = f"- {tags} {_clip(lesson, width)}"
        return out + (f" → `{anchor}`" if anchor else "")

    head = lines[0].lstrip("#").strip().lstrip("- ").strip()
    gist = _clip(" ".join(lines[1:]), width)
    return f"- **{head}**" + (f" — {gist}" if gist else "")


# Leading tag block of a memory line: `- `[browser][prosemirror]` lesson...`.
# Anchored on purpose — bracketed things occur inside lesson prose too ("a","b",
# coordinate tuples), and matching those pulled 2500 junk tags into the index.
_MEM_TAGS = re.compile(r"^-\s*`((?:\[[^\]`]+\])+)`")
_IDEA_TAGS = re.compile(r"^##\s*\[([^\]]+)\]")

# An ideas heading is [DOMAIN / subdomain / long-descriptive-slug / ...], where
# only the leading segments are routing keys — the trailing ones are whole
# sentences unique to one entry. Keeping all of them yields 2504 tags at 118KB,
# which is not an index, it is a second copy of the headings.
_IDEA_TAG_DEPTH = 2


def _entry_tags(label: str, block: str) -> set:
    """Routing tags for one entry. Empty for prose-titled nodes."""
    head = block.splitlines()[0] if block.splitlines() else ""
    if label == "memory":
        m = _MEM_TAGS.match(head)
        if not m:
            return set()
        return {t.strip().lower()
                for t in re.findall(r"\[([^\]]+)\]", m.group(1)) if t.strip()}
    if label == "ideas":
        m = _IDEA_TAGS.match(head)
        if not m:
            return set()
        return {t.strip().lower()
                for t in m.group(1).split("/")[:_IDEA_TAG_DEPTH] if t.strip()}
    return set()


def _node_section(label: str, entries: list) -> list:
    """The bullet list for one node, with its source file named."""
    lines = [f"source: `{_CANON_FILES.get(label, '?')}`", ""]
    if not entries:
        return lines + ["_(empty)_", ""]
    for block in entries:
        bullet = _index_line(block)
        if bullet:
            lines.append(bullet)
    lines.append("")
    return lines


_EXPORT_PREAMBLE = [
    "Generated by `brain export`. Do not edit by hand — it is overwritten.",
    "",
    "This is a retrieval aid for readers that cannot run the `brain` CLI.",
    "`brain query` is keyword matching over exactly these sources, so",
    "scanning this is equivalent to running it. Each entry names the file it",
    "came from: open that for the full text.",
]


# `## E<n> — title` starts a body section inside a memory project file.
_BODY_HEAD = re.compile(r"^##\s+(E\d+)\b")
# Trailing pointer on a PITFALLS index line: `→ projects/<file>.md#<id>`.
_BODY_REF = re.compile(r"→\s*projects/([^\s#]+)#(E\d+)")


def _project_bodies() -> dict:
    """{(project-file, entry-id): full body text} across memory/projects/*.md.

    PITFALLS.md holds only one-line index entries; the lessons themselves live
    in 176 separate project files. Anything that has to stand alone — with no
    way to follow a link — has to pull those bodies back in.
    """
    bodies = {}
    root = os.path.join(node("memory"), "projects")
    if not os.path.isdir(root):
        return bodies
    for fname in sorted(os.listdir(root)):
        if not fname.endswith(".md"):
            continue
        cur, buf = None, []
        for line in read(os.path.join(root, fname)).splitlines():
            m = _BODY_HEAD.match(line)
            if m:
                if cur:
                    bodies[(fname, cur)] = "\n".join(buf).strip()
                cur, buf = m.group(1), [line]
            elif cur:
                buf.append(line)
        if cur:
            bodies[(fname, cur)] = "\n".join(buf).strip()
    return bodies


# Docs that describe HOW to work the system, as (cache-relative path, heading).
# Bundled for a reader that has the canon but not the CLI: it cannot run the
# commands, but the protocol — retrieval order, write-back routing, the proposal
# schema — is what makes its output usable when handed back to someone who can.
_PROTOCOL_DOCS = [
    ("Brain/HOOK.md", "Onboarding — how a project links and what a linked session does"),
    ("Brain/orchestration.md", "Orchestration — retrieval order and the write-back routing table"),
    ("Brain/PROTOCOL.md", "Protocol"),
    ("memory/INSTRUCTIONS.md", "Memory node — how entries are written"),
    ("memory/BRIEF.md", "Memory node — brief"),
    ("memory/incoming/TEMPLATE.md", "Proposal schema — follow VERBATIM, the `- Field:` bullets are parsed"),
]


def _export_protocol(path: str) -> int:
    """Bundle the CLI's own surface and the working protocol into one file."""
    out = [
        "# Brain — CLI surface and working protocol",
        "",
        "Generated by `brain export --full`. Do not edit by hand.",
        "",
        "For a reader that has the canon but cannot run the CLI. You cannot",
        "execute these commands; the point is the DISCIPLINE they encode —",
        "retrieve before non-trivial work, capture non-bugs as well as bugs, and",
        "write proposals in a schema a steward can actually parse. Output written",
        "to the schema below can be handed to someone with a shell and synced",
        "unchanged; output that invents its own format parses as an empty entry",
        "and is held on every field.",
        "",
        "---",
        "",
        "## Command surface",
        "",
        "```",
        (__doc__ or "").strip(),
        "```",
        "",
        "---",
        "",
        "## Collaboration stances (`brain stance <name>`)",
        "",
        "Stances set HOW the agent engages, orthogonal to read-only/full access",
        "mode. The card is what the agent adopts; `brain rearm N` re-injects it",
        "every N prompts, because a stance set once decays as the conversation",
        "moves on.",
        "",
    ]
    for name, (one, card) in STANCES.items():
        out += [f"### {name} — {one}", "", "```", card, "```", ""]

    for rel, heading in _PROTOCOL_DOCS:
        full = os.path.join(CACHE, rel)
        if not os.path.isfile(full):
            continue
        out += ["---", "", f"## {heading}", "", f"_source: `{rel}`_", "",
                read(full).strip(), ""]

    write(path, "\n".join(out) + "\n")
    return len(out)


def _export_full(sources: list, out: str) -> int:
    """Self-contained per-node files: every entry complete, no cross-references.

    A DIFFERENT artifact from the index, for a different reader. The index is a
    locator and assumes the reader can open the repos; this assumes it cannot —
    uploaded into an assistant's own file store, an anchor like
    `projects/foo.md#E3` points at nothing, so the reader would find that an
    entry exists and never be able to read it.

    Always per-node: one ~4.8MB file helps nobody, and the nodes are already the
    natural seam.
    """
    stem, ext = os.path.splitext(out)
    ext = ext or ".md"
    bodies = _project_bodies()
    written, missing = [], 0

    for label, entries in sources:
        chunks = [
            f"# Brain canon — {label} (complete)",
            "",
            "Generated by `brain export --full`. Do not edit by hand.",
            "",
            "Self-contained: every entry is reproduced in full, so nothing here",
            "refers out to a file you may not have. It is a SNAPSHOT — regenerate",
            "it when the canon moves; nothing updates it in place.",
            "",
            f"{len(entries)} entries.",
            "",
            "---",
            "",
        ]
        for block in entries:
            head = block.splitlines()[0] if block.splitlines() else ""
            if label == "memory":
                m = _BODY_REF.search(block)
                body = bodies.get((m.group(1), m.group(2))) if m else None
                chunks.append(block.strip())
                if body:
                    chunks += ["", body]
                else:
                    missing += 1
                    chunks += ["", "_(full body not found in projects/ — "
                                   "index line only)_"]
            else:
                chunks.append(block.strip())
            chunks += ["", "---", ""]

        path = f"{stem}-{label}{ext}"
        write(path, "\n".join(chunks) + "\n")
        written.append((os.path.basename(path), len(entries)))

    proto = f"{stem}-protocol{ext}"
    _export_protocol(proto)
    written.append((os.path.basename(proto), "protocol"))

    note = f", {missing} without bodies" if missing else ""
    return ok("exported full canon → " +
              ", ".join(f"{f} ({n})" for f, n in written) + note)


def cmd_export() -> int:
    """Render the shared canon as a markdown catalogue.

    For readers that cannot run the CLI. A GitHub-connected assistant with no
    shell can retrieve against this directly, because `query` is keyword
    matching over these same sources — not computation the reader is missing.

    Deliberately a LOCATOR, not a copy: each entry gets its heading, a one-line
    gist, and the file it lives in. The reader already has the repos, so
    duplicating full entries here would only create a second copy to go stale.

    `--split` writes one file per node plus a small root index. A single file is
    ~390KB, and a reader that has to ingest the whole thing to answer one
    question pays for all four nodes on every lookup — measured at 48s against a
    real assistant. Nearly every query is answerable from one node, so splitting
    turns that into reading the root plus the one file that matters.
    """
    require_link()
    ensure_cache(pull=True)
    full = "--full" in ARGS
    out = "BRAIN-FULL.md" if full else "BRAIN-INDEX.md"
    if "--out" in ARGS:
        out = ARGS[ARGS.index("--out") + 1]
    split = "--split" in ARGS

    sources = _shared_canon()
    total = sum(len(entries) for _, entries in sources)

    if full:
        return _export_full(sources, out)

    if not split:
        lines = ["# Brain canon index", ""] + _EXPORT_PREAMBLE + [
            "", f"{total} entries across {len(sources)} nodes.", "",
        ]
        for label, entries in sources:
            lines.append(f"## {label} — {len(entries)} entries")
            lines.extend(_node_section(label, entries))
        write(out, "\n".join(lines) + "\n")
        return ok(f"exported {total} entries → {out}")

    # Split: per-node files named off the --out stem, so `--out FOO.md` yields
    # FOO-memory.md and friends beside a FOO.md that routes to them.
    stem, ext = os.path.splitext(out)
    ext = ext or ".md"
    written = []
    for label, entries in sources:
        path = f"{stem}-{label}{ext}"
        lines = [f"# Brain canon index — {label}", ""] + _EXPORT_PREAMBLE + [
            "", f"{len(entries)} entries.", "",
        ] + _node_section(label, entries)
        write(path, "\n".join(lines) + "\n")
        written.append((label, os.path.basename(path), len(entries)))

    tag_map = {}
    for label, entries in sources:
        for block in entries:
            for tag in _entry_tags(label, block):
                tag_map.setdefault(tag, set()).add(label)

    root = ["# Brain canon index", ""] + _EXPORT_PREAMBLE + [
        "",
        f"{total} entries across {len(sources)} nodes, split one file per node.",
        "",
        "## How to use this without reading everything",
        "",
        "Look the term up in the tag index below, open only the node(s) it",
        "names, and stop. Reading all four node files to answer one question",
        "costs the whole canon on every lookup, which is what the split exists",
        "to avoid.",
        "",
        "**The tag index routes; it does not prove absence.** It is built from",
        "entry TAGS only, not full text, so a term can appear in an entry's body",
        "without appearing here. A miss means \"not tagged that\" — it does not",
        "license saying the canon has nothing on it. To answer an absence",
        "question honestly, read the node file itself, or say which you checked.",
        "",
        "`tension` and `exploration` have prose titles rather than tags, so",
        "every one of their entries is listed in full below — those two nodes",
        "need no lookup.",
        "",
        "| node | entries | file | holds |",
        "| --- | --- | --- | --- |",
    ]
    holds = {
        "memory": "lessons from bugs and decisions already paid for",
        "tension": "open forks — unresolved contradictions and questions",
        "ideas": "reusable kernels and patterns",
        "exploration": "experiments and synthesis residue",
    }
    for label, fname, count in written:
        root.append(f"| {label} | {count} | [`{fname}`]({fname}) | "
                    f"{holds.get(label, '')} |")

    for label in ("tension", "exploration"):
        entries = dict(sources).get(label, [])
        if not entries:
            continue
        root += ["", f"## {label} — all {len(entries)} entries", ""]
        for block in entries:
            head = block.splitlines()[0] if block.splitlines() else ""
            head = head.lstrip("#").strip()
            if head:
                root.append(f"- {head}")

    root += ["", f"## tag index — {len(tag_map)} tags", ""]
    for tag in sorted(tag_map):
        root.append(f"- `{tag}` → {', '.join(sorted(tag_map[tag]))}")
    root.append("")
    write(out, "\n".join(root) + "\n")
    return ok(f"exported {total} entries → {out} + "
              f"{len(written)} node files")


_ENTRY_REF = re.compile(r"projects/([^\s#)]+\.md)#(E\d+)")


def _kernel_header(vertex: str) -> str:
    return "## [" + " / ".join(vertex[len("ideas:"):].split("/")) + "]"


def _query_links(mem_hits: list[str], idea_hits: list[str]) -> list[tuple]:
    """Follow the recorded links out of a query's hits, one hop.

    A matched memory entry brings the idea kernels its `Composed:` names; a
    matched kernel brings the kernels it is `Linked:` with (either direction)
    and the memory entries that applied it. Retrieval used to stop at keyword
    hits, so a link recorded in the graph never reached the agent reading the
    results. Returns (declared, text) rows; a kernel only quoted in prose is
    returned as not-declared, because that quote may be an example (T26)."""
    entry_k, applied, linked = {}, {}, {}
    for e in _load_entries([node("memory")]):
        key = (e["file"], e["id"])
        val = _field(e["block"], "composed")
        dec = _declared_kernel_refs(val)[0] if val else set()
        for k in dec:
            entry_k.setdefault(key, {})[k] = True
            applied.setdefault(k, {})[key] = True
        for k in _kernel_prose_refs(e["block"]) - dec:
            entry_k.setdefault(key, {}).setdefault(k, False)
            applied.setdefault(k, {}).setdefault(key, False)
    for c in _idea_compositions():
        for r in _composed_refs(c, {}):
            if r.startswith("ideas:") and r != c["file"]:
                linked.setdefault(c["file"], set()).add(r)
                linked.setdefault(r, set()).add(c["file"])
    index_line = {}
    for ln in _memory_index(node("memory")):
        m = _ENTRY_REF.search(ln)
        if m:
            index_line[(m.group(1), m.group(2))] = ln
    hit_e = {(m.group(1), m.group(2)) for m in map(_ENTRY_REF.search, mem_hits) if m}
    hit_k = set()
    for b in idea_hits:
        m = re.match(r"##\s*\[([^\]]+)\]", b)
        if m:
            hit_k.add(_kernel_vertex(_kernel_canon(m.group(1))))
    rows, seen = [], set()

    def add(item, declared, text):
        if item in seen:
            return
        seen.add(item)
        rows.append((declared, text if declared else
                     text + "   (inferred: may be an example, T26)"))

    for key in sorted(hit_e):
        for k, dec in sorted(entry_k.get(key, {}).items()):
            if k not in hit_k:
                add(k, dec, f"{_kernel_header(k)}\n    ← "
                            f"{'applied' if dec else 'quoted'} by "
                            f"{_shortf(key[0])}#{key[1]}")
    for k in sorted(hit_k):
        for o in sorted(linked.get(k, ())):
            if o not in hit_k:
                add(o, True, f"{_kernel_header(o)}\n    ↔ linked with {_shortf(k)}")
        for key, dec in sorted(applied.get(k, {}).items()):
            if key not in hit_e and key in index_line:
                add(key, dec, f"{index_line[key]}\n    → "
                              f"{'applies' if dec else 'quotes'} {_shortf(k)}")
    return rows


def _hit_tiers(hits: list[str]) -> dict:
    """Index line -> tier of the entry its `→ projects/<f>.md#E<n>` anchor names."""
    want = {}
    for h in hits:
        m = re.search(r"projects/([^\s#]+\.md)#(E\d+)", h)
        if m:
            want[(m.group(1), m.group(2))] = h
    if not want:
        return {}
    out = {}
    for e in _load_entries([node("memory")]):
        h = want.get((e["file"], e["id"]))
        if h:
            out[h] = e["tier"]
    return out


def cmd_query() -> int:
    require_link()
    if not ARGS:
        return die("usage: brain query <terms...>")
    ensure_cache(pull=True)
    terms = ARGS
    # main (shared) canon from the cache
    canon = dict(_shared_canon())
    mem = [e for e in canon["memory"] if matches(e, terms)]
    tens = [b for b in canon["tension"] if matches(b, terms)]
    idea = [b for b in canon["ideas"] if matches(b, terms)]
    expl = [b for b in canon["exploration"] if matches(b, terms)]
    # this project's LOCAL canon (promoted lessons that never left the project)
    lroot = local_root()
    lmem = [e for e in _memory_index(os.path.join(lroot, "memory"))
            if matches(e, terms)] if os.path.isdir(lroot) else []
    ltens = [b for b in _blocks(read(os.path.join(lroot, "tension",
             "tension-ledger.md")), "### ") if matches(b, terms)]
    lidea = [b for b in _blocks(read(os.path.join(lroot, "ideas",
             "idea-repository.md")), "## [") if matches(b, terms)]
    # The intake queue. Reported apart from canon and never mixed into it.
    pend = [(f, held) for f, body, held in _incoming_proposals(node("memory"))
            if matches(body, terms)]
    links = _query_links(mem, idea)
    ldecl = sum(1 for d, _ in links if d)
    tiers = _hit_tiers(mem) if mem else {}

    # A 0-result multi-word query is almost always PHRASING, not absence: the
    # canon keys its headers on hyphenated kebab slugs, so "metallic roughness"
    # misses what "metallic-roughness" finds. CLAUDE.md has said so in prose for
    # months and agents (including the one writing this) still read 0 as "the
    # system is empty" and moved on. Do the retry here instead of asking.
    # words = the query's real tokens, whether the caller passed them as
    # separate argv entries or as one quoted phrase. Getting THIS wrong is how
    # the first version of this very guard silently never fired.
    words = [w for term in terms for w in term.split()]
    if not (mem or tens or idea or expl or lmem or ltens or lidea) and len(words) > 1:
        for alt in ["-".join(words)] + words:
            if alt == " ".join(terms):
                continue
            hits = sum(len([b for b in blocks if matches(b, [alt])])
                       for blocks in canon.values())
            if hits:
                print(f"✓ query '{' '.join(terms)}': 0 results — but '{alt}' "
                      f"matches {hits}. Re-running as '{alt}'.")
                globals()["ARGS"] = [alt]
                return cmd_query()

    if not VERBOSE:
        line = (f"✓ query '{' '.join(terms)}': "
                f"{len(mem)} memory · {len(tens)} tension · "
                f"{len(idea)} idea · {len(expl)} exploration")
        if lmem or ltens or lidea:
            line += (f"  |  local: {len(lmem)} memory · {len(ltens)} tension · "
                     f"{len(lidea)} idea")
        if pend:
            held = sum(1 for _, h in pend if h)
            line += (f"  |  incoming: {len(pend)} proposal(s)"
                     + (f", {held} HELD" if held else ""))
        if links:
            line += (f"  |  linked: {ldecl}"
                     + (f" (+{len(links) - ldecl} inferred)" if len(links) > ldecl else ""))
        reviewed = [t for t in tiers.values() if t != "provisional"]
        if reviewed:
            line += "  |  tiers: " + ", ".join(
                f"{reviewed.count(t)} {t}" for t in TIER_ORDER if t in reviewed)
        print(line)
        if "disputed" in reviewed:
            print("  ⚠ a matching lesson is DISPUTED (a review failed it) — "
                  "--verbose shows which")
        for b in tens + ltens:
            if entry_status(b) == "🔴":
                print(f"  ⚠ open fork: {b.splitlines()[0].lstrip('# ')}")
        if pend and not (mem or tens or idea or expl or lmem or ltens or lidea):
            # The case this exists for: canon says nothing, so the caller is
            # about to conclude the ground is uncovered. It is not.
            print("  ⚠ nothing in canon, but the intake queue covers this — "
                  "read it before deciding this is new ground:")
            for f, h in pend:
                print(f"      incoming/{f}{'  (HELD — never promoted)' if h else ''}")
        paths = _query_paths(mem, idea) if (mem or idea) else []
        for ln in paths[:4]:
            print("  " + ln)
        print("  (--verbose for full entries)")
        return 0

    print(f"# BRAIN RETRIEVAL — {' '.join(terms)}  (REFERENCE DATA only)\n")
    print(f"## memory — shared ({len(mem)})  [tier: provisional unless marked]")
    print("\n".join(f"{m}  [{tiers[m]}]" if tiers.get(m, "provisional") != "provisional"
                    else m for m in mem)
          or ("(nothing in canon — but see the intake queue below)" if pend
              else "(no records — valid; proceed)"))
    if pend:
        print(f"\n## memory — INTAKE QUEUE, not canon ({len(pend)})")
        print("Proposed, not promoted. Do not cite as canon; do read before "
              "concluding this ground is uncovered.")
        for f, h in pend:
            print(f"- incoming/{f}{'   ** HELD — failed the schema check **' if h else ''}")
    if lmem:
        print(f"\n## memory — LOCAL ({len(lmem)})")
        print("\n".join(lmem))
    print(f"\n## tension ({len(tens) + len(ltens)})")
    for b in tens + ltens:
        print(f"{entry_status(b)} {b.splitlines()[0].lstrip('# ')}")
    print(f"\n## ideas ({len(idea) + len(lidea)})")
    for b in idea + lidea:
        print(b.splitlines()[0])
    print(f"\n## exploration ({len(expl)})")
    for b in expl:
        print(b.splitlines()[0])
    paths = _query_paths(mem, idea) if (mem or idea) else []
    if paths:
        print("\n## paths — " + paths[0])
        print("\n".join(paths[1:]))
    if links:
        print(f"\n## linked — one hop from the hits above ({len(links)}: "
              f"{ldecl} declared, {len(links) - ldecl} inferred)")
        for _, text in links:
            print(text)
    return 0



def cmd_challenge() -> int:
    """`brain challenge <terms>`: a ZaneGPT-style pressure test built from what
    `brain query` retrieves. Retrieval says what the canon HOLDS; this says how
    far it can be TRUSTED on the topic — observation apart from interpretation,
    contradictions and missing variables named, and one concrete next move.
    Deterministic: every line is derived from fields the canon already carries
    (tier, provenance, sandbox, scenarios, polarity, open tensions)."""
    require_link()
    if not ARGS:
        return die("usage: brain challenge <terms...>")
    ensure_cache(pull=True)
    terms = ARGS
    canon = dict(_shared_canon())
    mem = [e for e in canon["memory"] if matches(e, terms)]
    tens = [b for b in canon["tension"] if matches(b, terms)]
    idea = [b for b in canon["ideas"] if matches(b, terms)]
    bases = [node("memory")]
    entries = _load_entries(bases)
    idx = _slug_index(bases)
    cites = _entry_citations(entries, idx)
    by_key = {(e["file"], e["id"]): e for e in entries}
    hits = []
    for h in mem:
        m = re.search(r"projects/([^\s#]+\.md)#(E\d+)", h)
        e = by_key.get((m.group(1), m.group(2))) if m else None
        if e:
            hits.append(e)
    topic = " ".join(terms)
    ref = lambda e: f"{e['file'][:-3].split('__')[-1]}#{e['id']}"
    short = lambda e, n=96: (e["rule"] or e["block"].splitlines()[0])[:n].rstrip() + ("…" if len(e["rule"] or "") > n else "")
    show = lambda rows, n=5: rows[:n] + ([f"  … +{len(rows) - n} more"] if len(rows) > n else [])

    def scen(e):
        v = _field(e["block"], "scenarios")
        return len([x for x in re.split(r"\s\d+\)|;", v) if x.strip()]) if v else 0
    prov = lambda e: e["provenance"].lower()
    tested = [e for e in hits if e["tier"] in ("confirmed", "audited", "composed")
              or (_field(e["block"], "sandbox") and re.search(r"verified|first-hand", prov(e)))]
    untested = [e for e in hits if e not in tested and e["tier"] != "disputed"]
    assumed = [e for e in untested if re.search(r"\bassumed\b", prov(e)) and not re.search(r"verified|first-hand", prov(e))]
    disputed = [e for e in hits if e["tier"] == "disputed"]
    refuted = [e for e in hits if _field(e["block"], "polarity").strip().lower() == "incompatible"]
    broad = [e for e in hits if _BROAD_RULE_RE.search(e["rule"]) and scen(e) < 3]
    modeled = [e for e in hits if e["tier"] == "modeled"]
    open_t = [b for b in tens if entry_status(b) in ("🔴", "🟡")]
    load = sorted(hits, key=lambda e: -cites.get((e["file"], e["id"]), 0))
    newest = max((e["date"] for e in hits), default="")
    domains = {}
    for b in idea:
        m = re.match(r"## \[([^/\]]+)", b)
        if m:
            domains.setdefault(m.group(1).strip(), []).append(b.splitlines()[0][3:].strip("[]"))

    print(f"# BRAIN CHALLENGE — {topic}  (ZaneGPT stance: observation ≠ interpretation ≠ recommendation)\n")
    if not hits and not tens and not idea:
        print("Nothing in canon matches. That is a fact about the index, not the world: "
              "re-query with one broader keyword before concluding the ground is new.")
        return 0
    print(f"PREMISE  the canon has {len(hits)} lesson(s), {len(tens)} tension(s), {len(idea)} kernel(s) on this. "
          f"Newest lesson: {newest or 'undated'}.")
    print(f"\nOBSERVATIONS — tested, cite freely ({len(tested)})")
    for l in show([f"  [{e['tier'] if e['tier'] != 'provisional' else 'sandboxed'}] {ref(e)}: {short(e)}" for e in tested]) or ["  none — nothing on this topic has survived a test"]:
        print(l)
    print(f"\nINTERPRETATIONS — plausible, untested ({len(untested)})")
    for l in show([f"  {ref(e)}: {short(e)}" + ("  ← provenance says ASSUMED" if e in assumed else "") for e in untested]) or ["  none"]:
        print(l)
    print(f"\nCONTRADICTIONS ({len(disputed) + len(refuted) + len(open_t)})")
    rows = ([f"  DISPUTED {ref(e)}: a review failed it — do not build on it" for e in disputed]
            + [f"  REFUTED composition {ref(e)}: {short(e)}" for e in refuted if e not in disputed]
            + [f"  OPEN FORK {entry_status(b)} {b.splitlines()[0].lstrip('# ')[:100]}" for b in open_t])
    for l in show(rows, 6) or ["  none recorded — which is weaker evidence than it sounds: refutations only had a field since Sep 29"]:
        print(l)
    print("\nMISSING VARIABLES")
    rows = ([f"  {ref(e)} says always/never on {scen(e)} scenario(s)" for e in broad]
            + [f"  {ref(e)} is MODELED: tested against a hand-written model, not the real system" for e in modeled]
            + [f"  {len(untested)} of {len(hits)} lessons have no test at all" for _ in [0] if untested]
            + [f"  no lesson newer than {newest}" for _ in [0] if newest and newest < (date.today() - timedelta(days=30)).isoformat()])
    for l in show(rows) or ["  none flagged by the fields the canon carries"]:
        print(l)
    print(f"\nCOMPETING FRAMES — kernels from other domains touching this ({len(idea)})")
    for l in show([f"  {d}: " + "; ".join(k.split(" / ")[-1] for k in ks[:2]) for d, ks in sorted(domains.items(), key=lambda kv: -len(kv[1]))], 5) or ["  none"]:
        print(l)
    print("\nNEXT MOVE")
    if disputed:
        print(f"  Stop building on {ref(disputed[0])}; read its failing review (`brain query {ref(disputed[0]).split('#')[0]} --verbose`).")
    elif open_t:
        print(f"  Settle the open fork before committing: {open_t[0].splitlines()[0].lstrip('# ')[:90]}")
    elif load and load[0] in untested and cites.get((load[0]["file"], load[0]["id"]), 0):
        print(f"  {ref(load[0])} is untested and {cites[(load[0]['file'], load[0]['id'])]} lesson(s) build on it: "
              f"`brain train audit` it first — it is the cheapest place to be wrong.")
    elif broad:
        print(f"  Narrow {ref(broad[0])} to what was tested, or add scenarios until the always/never is earned.")
    elif untested:
        print(f"  Build a sandbox for {ref(untested[0])} before relying on it; the rest here is already tested.")
    else:
        print("  The canon is tested on this topic. Proceed, and file what the build teaches.")
    return 0



def _project_key() -> str:
    """owner/repo from the nearest git remote, walking up from the current
    directory (never above $HOME). A subfolder that `brain link` turned into its
    own repo has no remote, and keying it by its folder name split one project
    into two files (local__demo-disc next to pappydapimp69__demo-disc)."""
    d = os.path.abspath(os.getcwd())
    home = os.path.abspath(os.path.expanduser("~"))
    while True:
        try:
            url = git(d, "remote", "get-url", "origin").strip()
            m = re.search(r"[:/]([^/:]+)/([^/]+?)(?:\.git)?$", url)
            if m:
                return f"{m.group(1)}/{m.group(2)}"
        except (RuntimeError, OSError):
            pass
        parent = os.path.dirname(d)
        if parent == d or d == home:
            break
        d = parent
    return os.path.basename(project_root())


def _proposal_skeleton(d: str, proj: str, text: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "__", proj.lower())
    return (
        "## FULL ENTRY\n"
        "- ID: E?\n"
        f"- Date: {d}\n"
        f"- Project: {proj}\n"
        "- Tags: [todo]   (lowercase [bracketed]; reuse existing tags)\n"
        f"- What: {text}\n"
        "- Why built: TODO\n"
        "- Design: TODO\n"
        "- Got right: TODO\n"
        "- Where/why it failed: TODO — describe the trap concretely\n"
        "- Fix: TODO — what you changed\n"
        "- Why this fix: TODO\n"
        f"- Rule of thumb: {text}\n"
        "- Provenance (verified/assumed): TODO\n"
        "- Link: TODO\n\n"
        "## PROPOSED INDEX LINE\n"
        f"`[todo]` {text} -> projects/{slug}.md#E?\n"
    )


def cmd_curate() -> int:
    """Turn quick stubs into full proposal skeletons the agent completes.
    Bridges capture → promotion: each stub becomes a schema file with its text
    in What/Rule and TODOs for the rest; `brain sync` then holds them until the
    agent fills the TODOs, and promotes once complete."""
    require_link()
    ensure_local()
    inc = os.path.join(local_root(), "memory", "incoming")
    stubs_path = os.path.join(inc, "stubs.md")
    lines = read(stubs_path).splitlines()
    stub_lines = [l for l in lines if l.startswith("- ")]
    if not stub_lines:
        return ok("no stubs to curate")
    made, kept, used = 0, [l for l in lines if not l.startswith("- ")], set()
    for l in stub_lines:
        parts = l[2:].split(" · ", 2)
        d = parts[0] if len(parts) == 3 and re.match(r"\d{4}-\d{2}-\d{2}", parts[0]) \
            else date.today().isoformat()
        text = parts[2] if len(parts) == 3 else l[2:]
        base = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:40] \
            or f"lesson-{made + 1}"
        slug, n = base, 1
        while slug in used:
            n += 1
            slug = f"{base}-{n}"
        used.add(slug)
        fname = f"{date.today().isoformat()}__{slug}.md"
        path = os.path.join(inc, fname)
        if not os.path.exists(path):
            write(path, _proposal_skeleton(d, _project_key(), text))
            made += 1
    write(stubs_path, "\n".join(kept).rstrip() + "\n")
    print(f"✓ curated {made} stub(s) → proposal skeleton(s) in "
          ".brain/memory/incoming/")
    print("  AGENT: fill the TODO fields in each (Tags, Where/why it failed, Fix,"
          " etc.), then `brain sync` — complete ones promote into local canon,"
          " incomplete ones are held with reasons.")
    return 0


def _proposal_template() -> str:
    """The proposal schema, read from memory/incoming/TEMPLATE.md in the cache.

    The CLI deliberately keeps NO copy of the schema. It used to paraphrase the
    field list in prose ("filling every field: Tags, What, ..."), which named the
    right fields but never showed the `- Field:` syntax the steward parses — so
    sessions guessed, and 18 of 22 queued proposals were held on all 11 fields at
    once. TEMPLATE.md ships in the same repo as steward.py, so the schema and the
    validator that enforces it change in one commit and cannot drift.
    """
    path = os.path.join(node("memory"), "incoming", "TEMPLATE.md")
    text = read(path).strip()
    if not text:
        return ("\n  (could not read memory/incoming/TEMPLATE.md from the cache — "
                "open it in the memory repo and follow it exactly; do NOT invent "
                "a format)")
    return "\n--- PROPOSAL SCHEMA (memory/incoming/TEMPLATE.md, verbatim) ---\n" + text


def cmd_mine() -> int:
    require_link()
    ensure_local()
    ensure_cache(pull=True)
    root = project_root()
    # The CLI has no LLM — it cannot judge what's a keepable lesson. So mine
    # GATHERS the raw evidence and hands the agent an explicit instruction; the
    # agent (which is reading this) does the extraction and writes proposals.
    log = git(root, "log", "--oneline", "-40", check=False).strip()
    tracked = [f for f in git(root, "ls-files", "--cached", "--others",
               "--exclude-standard", check=False).splitlines() if f]
    already = _local_findings()

    print(f"✓ mine — evidence for {_project_key()} "
          f"({len(tracked)} files, {already} local finding(s) so far):\n")
    if log:
        print(f"Recent commits (last {len(log.splitlines())}):")
        for l in log.splitlines():
            print("  " + l)
    else:
        print("  (no git history — mine the working files and this session instead)")

    terms = _suggest_terms(tracked)
    print("\n--- AGENT INSTRUCTION (do this now) ---")
    print("STEP 1 — retrieve. Run these (plus any topic specific to the code) and")
    print("REUSE what they return; do NOT re-derive what the shared repo knows:")
    for t in terms:
        print(f"    brain query {t}")
    if not terms:
        print("    brain query <the main topics in these files>")
    print("STEP 2 — mine BOTH this project and what happened in THIS session.")
    print("A lesson qualifies only if it is NON-OBVIOUS and TRANSFERABLE — a real")
    print("bug + its fix, or a design decision with a real tradeoff. Skip routine")
    print("features and refactors.")
    print("For each lesson, write a FULL proposal (not a one-line stub) into")
    print("  .brain/memory/incoming/<YYYY-MM-DD>__<slug>.md")
    print("using the schema below VERBATIM — the `- Field:` bullets are what the")
    print("steward parses. Prose or `## Headings` carrying the same information")
    print("parse as an EMPTY entry and are held on every field at once.")
    print(_proposal_template())
    print("Reusable design pattern? add a kernel to "
          ".brain/ideas/idea-repository.md.")
    print("Unresolved fork? add an entry to .brain/tension/tension-ledger.md.")
    print("STEP 3 — run `brain sync`: complete proposals promote into local")
    print("canon; duplicates of shared canon and incomplete ones are held.")
    print("If sync reports a proposal NOT pushed, that is your cue to fix the")
    print("listed reasons in the file and run `brain sync` again (up to 3")
    print("times) -- finish the loop yourself; do not hand it back.")
    return 0


def _suggest_terms(files: list) -> list:
    """Guess retrieval topics from the codebase — languages + top-level dirs."""
    lang = {"py": "python", "js": "javascript", "ts": "typescript",
            "tsx": "react", "jsx": "react", "go": "go", "rs": "rust",
            "java": "java", "rb": "ruby", "php": "php", "cs": "csharp",
            "html": "html", "css": "css", "sql": "sql", "sh": "shell",
            "swift": "swift", "kt": "kotlin", "c": "c", "cpp": "cpp"}
    exts, dirs = {}, {}
    for f in files:
        e = os.path.splitext(f)[1].lstrip(".").lower()
        if e in lang:
            exts[lang[e]] = exts.get(lang[e], 0) + 1
        parts = f.replace("\\", "/").split("/")
        if len(parts) > 1 and not parts[0].startswith("."):
            dirs[parts[0]] = dirs.get(parts[0], 0) + 1
    ranked = [t for t, _ in sorted(exts.items(), key=lambda x: -x[1])[:3]]
    ranked += [d for d, _ in sorted(dirs.items(), key=lambda x: -x[1])[:2]]
    seen, out = set(), []
    for t in ranked:
        if t not in seen:
            seen.add(t)
            out.append(t)
    return out[:5]


def cmd_sync() -> int:
    cfg = require_link()
    _self_update()  # refresh the CLI itself, not just the knowledge cache, so
                    # sync picks up new commands (e.g. analyze) without a reinstall
    ensure_cache(pull=True)
    ensure_local()
    _inject_pointer()  # the CLI is machine-wide, but each project holds its own
                       # pointer copy — this is the only place it can refresh
    inc = os.path.join(local_root(), "memory", "incoming")
    props = [f for f in os.listdir(inc) if f.endswith(".md")
             and f not in ("stubs.md", "README.md", "TEMPLATE.md")] \
        if os.path.isdir(inc) else []
    stubs = [l for l in read(os.path.join(inc, "stubs.md")).splitlines()
             if l.startswith("- ")]
    mode = cfg.get("mode")

    if mode == "read-only":
        # run the SAME steward against the LOCAL store: promote passing
        # proposals into local canon, hold the rest, push nothing to main.
        promoted, held = _local_promote()
        note = f"{promoted} promoted to local canon, {held} held" if \
            (promoted or held) else f"{len(stubs)} stub(s) kept (not yet proposals)"
        # Findings routed to ideas/ or tension/ stay local by definition in this
        # mode, but they must still be COUNTED — a read-only project that files
        # a fork deserves to be told it is holding one, not to see a memory-only
        # summary that implies its store is empty.
        waiting = len(_local_proposal_files("ideas")) + len(_local_ideas_blocks()) \
            + len(_local_proposal_files("tension")) + len(_local_tension_blocks())
        if waiting:
            note += f"; {waiting} idea/tension finding(s) kept local (switch to full mode to push)"
        return ok(f"synced (read-only) — pulled main in; {note}")

    # full: verify the already-written local files through main, then push.
    # ALL THREE write-back nodes, not just memory: `brain mine` tells the agent
    # to file kernels into ideas/ and forks into tension/, and for a long time
    # sync read only memory/incoming — so anything routed to the other two was
    # written, never pushed, and never mentioned. The summary said "0 held",
    # which reads as "nothing left behind" while a tension sat in the local
    # store forever. Silence is the bug; a node with nothing to send simply
    # contributes nothing to the counts below.
    pushed, held = _push_local_to_main(props, stubs)
    i_pushed, i_held = _push_local_ideas()
    t_pushed, t_held = _push_local_tension()
    total_p = pushed + i_pushed + t_pushed
    total_h = held + i_held + t_held
    bits = []
    if pushed or held:
        bits.append(f"memory {pushed}")
    if i_pushed or i_held:
        bits.append(f"ideas {i_pushed}")
    if t_pushed or t_held:
        bits.append(f"tension {t_pushed}")
    detail_bits = f" ({', '.join(bits)})" if bits else ""
    rc = ok(f"synced (full) — {total_p} pushed to main{detail_bits}, "
            f"{total_h} held (verify: --verbose)")
    _report_preflight_blocked()
    return rc


def _local_promote() -> tuple[int, int]:
    """Run the canonical steward against this project's LOCAL memory store.
    Promotes passing proposals into .brain/memory canon (PITFALLS + projects),
    holds the rest in-file — identical rules to main, nothing leaves the project."""
    steward = os.path.join(node("memory"), "scripts", "steward.py")
    localmem = os.path.join(local_root(), "memory")
    if not os.path.exists(steward):
        detail("steward script not found in cache; skipped local promotion")
        return 0, 0
    # dedup local promotions against the SHARED canon too, so a lesson that
    # already exists upstream is held as a duplicate, not filed as "original".
    env = dict(os.environ)
    env["BRAIN_DEDUP_EXTRA"] = os.path.join(node("memory"), "PITFALLS.md")
    r = subprocess.run([sys.executable, steward, "--root", localmem],
                       capture_output=True, text=True, env=env)
    if VERBOSE:
        detail(r.stdout.strip().replace("\n", "\n  "))
    m = re.search(r"promoted (\d+) . held (\d+)", r.stdout)
    return (int(m.group(1)), int(m.group(2))) if m else (0, 0)


_STEWARD_MOD = None
_PREFLIGHT_BLOCKED: list = []  # (filename, reasons) held back by the last push


def _report_preflight_blocked() -> None:
    """Tell the agent reading this output to repair and re-sync. The CLI has no
    model of its own, so the repair loop lives in this instruction: a blocked
    proposal is work for the agent to finish now, not a note for the user."""
    if not _PREFLIGHT_BLOCKED:
        return
    print("\n--- AGENT INSTRUCTION (do this now, do not ask) ---")
    print(f"{len(_PREFLIGHT_BLOCKED)} proposal(s) were NOT pushed because the "
          "steward would hold them. For each one:")
    print("  1. Open the file in .brain/memory/incoming/ and fix exactly the")
    print("     reasons listed above, using the schema from `brain mine`.")
    print("     Write the missing content from what actually happened this")
    print("     session; do NOT invent evidence, and do NOT reword Provenance")
    print("     to satisfy the check -- if the lesson was not verified")
    print("     first-hand, it does not qualify.")
    print("  2. Run `brain sync` again.")
    print("Repeat up to 3 times per proposal. If it still cannot pass, or the")
    print("lesson does not meet the bar, delete the file and say so in your")
    print("report. Do not leave an unpushed proposal behind silently.")


def _steward_preflight(body: str, root: str = "", label: str = "") -> list:
    """Reasons the memory repo's own steward would HOLD this proposal, or [].

    Imports scripts/steward.py from the cache and calls its check() and
    project_file() -- the same functions the auto-steward runs on main -- so a
    proposal that would be held is caught before it leaves the project, not
    after, where it sits invisible to `brain query` until someone edits the
    memory repo. If the steward can't be loaded this returns [] and sync
    behaves as it did before (the steward on main still guards canon)."""
    global _STEWARD_MOD
    path = os.path.join(node("memory"), "scripts", "steward.py")
    if _STEWARD_MOD is None:
        if not os.path.exists(path):
            detail("steward script not found in cache; skipped preflight")
            return []
        import importlib.util
        try:
            spec = importlib.util.spec_from_file_location("brain_steward", path)
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
        except Exception as e:  # noqa: BLE001 - a broken steward must not break sync
            detail(f"steward import failed ({str(e)[:60]}); skipped preflight")
            return []
        _STEWARD_MOD = mod
    st = _STEWARD_MOD
    try:
        fields, index_line = st.parse(body)
        if hasattr(st, "is_review") and st.is_review(body):
            # a review of an existing entry: its target lives in shared canon,
            # its sandbox (rebuilds) in this project's local incoming/
            return list(st.check_review(fields, body, root or None, node("memory")))
        if re.search(r"^##\s*REVIEW\s*$", body, re.M):
            return ["review: the cached memory steward predates reviews — "
                    "run `brain sync` again after the cache updates"]
        reasons = list(st.check(fields, index_line, body))
        # sandbox checks arrived later than check(); an older cached steward
        # simply lacks them, and sync must keep working against it
        if root and hasattr(st, "sandbox_hold_reasons"):
            reasons += st.sandbox_hold_reasons(fields, root)
        if not reasons and not st.project_file(fields):
            reasons.append("project: cannot parse the Project field into "
                           "<owner>/<repo>")
        if root and hasattr(st, "sandbox_warnings"):
            for w in st.sandbox_warnings(fields, root):
                print(f"⚠ {label or 'proposal'}: {w} (warning only)")
        thin = _thin_kernel_link(body)
        if thin:
            print(f"⚠ {label or 'proposal'}: {thin} (warning only)")
        return reasons
    except Exception as e:  # noqa: BLE001
        detail(f"steward preflight errored ({str(e)[:60]}); skipped")
        return []


def _sandbox_of(body: str) -> str:
    """Basename named by a proposal's `- Sandbox:` field, or ''. Same bullet
    grammar the steward parses; only a YYYY-MM-DD__<slug>.py name counts."""
    m = re.search(r"^\s*-\s*\**sandbox\**\s*(?:\(.*?\))?\s*:\s*(.+)$",
                  body, re.I | re.M)
    name = os.path.basename(m.group(1).strip().strip("`").strip()) if m else ""
    return name if re.fullmatch(r"\d{4}-\d{2}-\d{2}__[a-z0-9][a-z0-9-]*\.py",
                                name) else ""


def _push_local_to_main(props, stubs):
    """Copy local proposals/stubs into main's incoming/ and push; the auto
    steward promotes what passes. Held count = anything the local verify
    flagged before it left the project: a hold marker already on the file, or
    a preflight failure against the memory repo's own steward. A preflight
    failure leaves the file untouched and is reported here -- fix the listed
    fields and run `brain sync` again."""
    mem = node("memory")
    pushed = held = 0
    _PREFLIGHT_BLOCKED.clear()
    sent = []  # only these are removed locally after the push
    dst = os.path.join(mem, "incoming")
    localmem = os.path.join(local_root(), "memory")
    for f in props:
        src = os.path.join(localmem, "incoming", f)
        body = _with_session_link(read(src))
        if "STEWARD HOLD" in body:
            held += 1
            detail(f"held (local hold marker present): {f}")
            continue
        reasons = _steward_preflight(body, localmem, f)
        if reasons:
            held += 1
            print(f"! not pushed (the steward would hold it): {f}")
            for r in reasons:
                print(f"    - {r}")
            _PREFLIGHT_BLOCKED.append((f, reasons))
            continue
        write(os.path.join(dst, f), body)
        sent.append(f)
        pushed += 1
        # the sandbox that verified it travels with it (steward moves it to
        # sandboxes/ on promotion); it is evidence, so never leave it behind
        sbx = _sandbox_of(body)
        if sbx and os.path.isfile(os.path.join(localmem, "incoming", sbx)):
            write(os.path.join(dst, sbx),
                  read(os.path.join(localmem, "incoming", sbx)))
            sent.append(sbx)
    # local stubs → main stubs.md (append the ones not already there)
    if stubs:
        mstub = os.path.join(dst, "stubs.md")
        cur = read(mstub)
        add = [s for s in stubs if s not in cur]
        if add:
            with open(mstub, "a", encoding="utf-8") as fh:
                fh.write("\n".join(add) + "\n")
            pushed += len(add)
    if pushed:
        try:
            git(mem, "add", "incoming/")
            git(mem, "commit", "-m", f"sync: {_project_key()} — "
                f"{pushed} finding(s) for the steward")
            git(mem, "push", "origin", "main")
            # clear the local incoming now that it's upstream -- only what was
            # actually sent; a file held back by preflight must survive so the
            # author can fix it and sync again
            for f in sent:
                os.remove(os.path.join(localmem, "incoming", f))
        except RuntimeError as e:
            detail(f"push failed: {e}")
            return 0, held + pushed
    return pushed, held


# ------------------------------------------------- ideas / tension write-back
#
# Each node is fed the way that node's own README says to feed it:
#   ideas   -> proposal files in ideas/incoming/, where the existing steward
#              promotes what passes (same contract memory uses).
#   tension -> appended to tension-ledger.md directly. Tension has no incoming/
#              and no steward; its documented rule is append-mostly, never
#              delete, so an append IS the sanctioned write.
# Anything malformed is HELD and left in the local store rather than pushed —
# a half-formed block in shared canon is worse than one that never left.

# Files the local store seeds itself with; they are canon mirrors, not proposals.
LOCAL_SEED = {
    "memory": {"stubs.md", "README.md", "TEMPLATE.md", "PITFALLS.md"},
    "ideas": {"idea-repository.md", "exploration.md"},
    "tension": {"tension-ledger.md"},
}


def _local_proposal_files(sub: str) -> list[str]:
    """Standalone .md proposals dropped into .brain/<sub>/ by an agent."""
    d = os.path.join(local_root(), sub)
    if not os.path.isdir(d):
        return []
    return sorted(f for f in os.listdir(d)
                  if f.endswith(".md") and f not in LOCAL_SEED.get(sub, set()))


def _blocks_in(path: str, marker: str) -> list[str]:
    """Entry blocks written into a local canon mirror beyond its seed header."""
    body = read(path)
    if not body.strip():
        return []
    return [b for b in _blocks(body, marker) if b.strip()]


def _local_ideas_blocks() -> list[str]:
    return _blocks_in(os.path.join(local_root(), "ideas", "idea-repository.md"), "## [")


def _local_tension_blocks() -> list[str]:
    return _blocks_in(os.path.join(local_root(), "tension", "tension-ledger.md"), "### ")


def _reset_seed(rel: str, header: str) -> None:
    write(os.path.join(local_root(), rel), header)


def _push_local_ideas() -> tuple[int, int]:
    """Local kernels -> ideas/incoming/ for the steward. Returns (pushed, held)."""
    files = _local_proposal_files("ideas")
    blocks = _local_ideas_blocks()
    if not files and not blocks:
        return 0, 0
    repo = node("ideas")
    dst = os.path.join(repo, "incoming")
    if not os.path.isdir(dst):
        detail("ideas/incoming missing in cache; kernels kept local")
        return 0, len(files) + len(blocks)
    pushed = held = 0
    stamp = _sync_stamp()
    for f in files:
        src = os.path.join(local_root(), "ideas", f)
        body = read(src)
        # A kernel is a tagged DOMAIN block; anything without one cannot be
        # slotted by the steward and is held rather than guessed at.
        if "## [" not in body:
            held += 1
            detail(f"held (no '## [DOMAIN / ...]' header): ideas/{f}")
            continue
        write(os.path.join(dst, f), _with_session_line(body))
        os.remove(src)
        pushed += 1
    for i, b in enumerate(blocks):
        # ideas' validator wants YYYY-MM-DD__<lowercase slug>.md; the raw
        # project key ("Pappydapimp69/Zanegpt") made a name it rejects, and a
        # held file with that name blocked the whole ideas steward.
        key = re.sub(r"[^a-z0-9]+", "-", _project_key().lower()).strip("-")
        name = f"{stamp}__{key or 'project'}-kernel-{i + 1}.md"
        write(os.path.join(dst, name), _with_session_line(b.rstrip() + "\n"))
        pushed += 1
    if blocks:
        _reset_seed("ideas/idea-repository.md", "# LOCAL IDEAS\n")
    return (pushed, held) if _commit_node(repo, "incoming/", pushed, "kernel") \
        else (0, held + pushed)


def _push_local_tension() -> tuple[int, int]:
    """Local forks -> Tension's ledger. Returns (pushed, held)."""
    files = _local_proposal_files("tension")
    blocks = _local_tension_blocks()
    if not files and not blocks:
        return 0, 0
    repo = node("Tension")
    ledger = os.path.join(repo, "tension-ledger.md")
    if not os.path.exists(ledger):
        detail("tension-ledger.md missing in cache; forks kept local")
        return 0, len(files) + len(blocks)
    entries, held = [], 0
    for f in files:
        body = read(os.path.join(local_root(), "tension", f)).strip()
        # The ledger's schema is '### ' blocks; a file without one would land
        # as loose prose the gate's parser cannot see at all.
        if not body.startswith("### "):
            held += 1
            detail(f"held (not a '### ' tension block): tension/{f}")
            continue
        entries.append((f, _with_session_line(body).strip()))
    for i, b in enumerate(blocks):
        entries.append((None, _with_session_line(b.strip()).strip()))
    if not entries:
        return 0, held

    body = read(ledger)
    heading = f"## Project: {_project_key()}"
    add = "\n\n".join(e[1].rstrip() for e in entries)
    chunk = (f"{heading}\n\n" if heading not in body else "") + add + "\n"
    # Land entries above the ledger's trailing how-to-query footer if it has
    # one, so the file keeps reading as a ledger rather than trailing off
    # after its own instructions.
    marker = "## How to query this ledger"
    if marker in body:
        head, _, tail = body.partition(marker)
        body = f"{head.rstrip()}\n\n{chunk}\n{marker}{tail}"
    else:
        body = f"{body.rstrip()}\n\n{chunk}"
    write(ledger, body)

    if not _commit_node(repo, "tension-ledger.md", len(entries), "fork"):
        return 0, held + len(entries)
    for f, _ in entries:
        if f:
            os.remove(os.path.join(local_root(), "tension", f))
    if blocks:
        _reset_seed("tension/tension-ledger.md", "# LOCAL TENSION LEDGER\n")
    return len(entries), held


def _sync_stamp() -> str:
    return time.strftime("%Y-%m-%d")


def _commit_node(repo: str, path: str, n: int, what: str) -> bool:
    """Commit + push one node. False (and a detail line) on failure, so the
    caller can report the findings as HELD instead of silently losing them."""
    if not n:
        return True
    try:
        git(repo, "add", path)
        git(repo, "commit", "-m",
            f"sync: {_project_key()} — {n} {what}(s) from a linked project")
        git(repo, "push", "origin", "main")
        return True
    except RuntimeError as e:
        detail(f"push failed ({os.path.basename(repo)}): {e}")
        return False


# ------------------------------------------------------------- session link
#
# A lesson that records which session wrote it can be scored by who produced it
# later. The link is added at sync time from the running session's own id, so
# an author never has to remember it. Only the bare session id goes into the repo.

def _session_url() -> str:
    """The running session's BARE id (session_...), not a link: the id is all
    the scorecard and an auditor's session lookup need, and a bare id gives an
    agent reading the repo nothing to click or fetch."""
    sid = os.environ.get("CLAUDE_CODE_REMOTE_SESSION_ID", "")
    m = re.fullmatch(r"(?:cse|session)_([0-9A-Za-z]{20,})", sid)
    return f"session_{m.group(1)}" if m else ""


def _with_session_link(body: str) -> str:
    """Add this session's id to the proposal's `- Link:` line unless the Link
    field already names a session. A proposal with no Link line is returned
    untouched: inventing a field is the author's job, not sync's."""
    url = _session_url()
    if not url or re.search(r"session_[0-9A-Za-z]{20,}", _field(body, "link")):
        return body
    lines = body.splitlines(keepends=True)
    for i, ln in enumerate(lines):
        if re.match(r"^-\s*Link\s*:", ln):
            lines[i] = ln.rstrip("\n") + f"; {url}\n"
            return "".join(lines)
    return body


def _with_session_line(text: str) -> str:
    """Stamp a kernel or tension block with a `- Session: <id>` line unless it
    already names a session. These have no Link field, so the line is added at
    the end; the ideas steward ignores it for substance and dedup."""
    sid = _session_url()
    if not sid or re.search(r"session_[0-9A-Za-z]{20,}", text):
        return text
    return text.rstrip("\n") + f"\n- Session: {sid}\n"


# ------------------------------------------------------------- tension confidence
#
# A tension's status is DERIVED from the evidence logged on it, never typed in.
# Structured lines in a tension block (Updates: prose stays free text):
#   - Evidence: A|B · projects/<file>.md#E<n> | ideas:<path> | https://… · <date>
#   - Decision: A|B · <who> · <date>
# A = the first pole, B = the second. A decision (the owner's, or anyone's) sets
# a DIRECTION and is worth nothing by itself: only tested evidence moves the
# score. Repeats from one family count half as much each time, so fifty variants
# of one claim are not fifty proofs.

SCORE_W = {"confirmed": 3, "audited": 2, "modeled": 1, "composed": 1,
           "provisional": 1, "disputed": 0}
SOURCE_W, KERNEL_W = 2, 1
SETTLE, LEAN, SCORE_PRIOR = 60, 30, 2
_EVID_RE = re.compile(r"^-\s*Evidence\s*:\s*([AB])\s*·\s*([^·\n]+?)\s*(?:·\s*(\d{4}-\d{2}-\d{2}))?\s*$", re.M)
_DECIDE_RE = re.compile(r"^-\s*Decision\s*:\s*([AB])\s*·\s*([^·\n]+?)\s*(?:·\s*(\d{4}-\d{2}-\d{2}))?\s*$", re.M)


def _evidence_weight(ref: str, tiers: dict) -> tuple:
    """(weight, family) for one evidence reference. A reference that cannot be
    found counts for nothing: a typo must not manufacture support."""
    m = re.search(r"(?:projects/)?([^\s#·]+\.md)#(E\d+)", ref)
    if m:
        tier = tiers.get((m.group(1), m.group(2)))
        return (SCORE_W.get(tier, 0), _family(m.group(1))) if tier else (0, "?" + ref)
    if ref.startswith("ideas:"):
        return KERNEL_W, "/".join(ref.split("/")[:2])
    if re.match(r"https?://", ref):
        return SOURCE_W, ref
    return 0, ref


def _tension_score(events) -> tuple:
    """events = [(side, weight, family)] -> (leader|None, confidence 0-100, status)."""
    seen, S = {}, {"A": 0.0, "B": 0.0}
    for side, w, fam in events:
        n = seen.get(fam, 0)
        S[side] += w / (2 ** n)
        seen[fam] = n + 1
    if S["A"] == S["B"]:
        return None, 0, "open"
    lead, other = ("A", "B") if S["A"] > S["B"] else ("B", "A")
    conf = round(100 * (S[lead] - S[other]) / (S["A"] + S["B"] + SCORE_PRIOR))
    return lead, conf, "settled" if conf >= SETTLE else "leaning" if conf >= LEAN else "open"


def _decision_outcome(side: str, events, lead, conf) -> str:
    """How a recorded decision is standing, judged only by the evidence."""
    if not events:
        return "untested"
    if lead == side and conf >= LEAN:
        return "holding"
    if lead and lead != side and conf >= LEAN:
        return "overturned"
    return "shaky"


def _tension_rows(entries) -> list:
    tiers = {(e["file"], e["id"]): e["tier"] for e in entries}
    rows = []
    for b in _blocks(read(os.path.join(node("Tension"), "tension-ledger.md")), "### "):
        head = b.splitlines()[0].lstrip("# ").strip()
        ev = [(s, *_evidence_weight(r.strip(), tiers)) for s, r, _d in _EVID_RE.findall(b)]
        dec = [(s, who.strip(), d) for s, who, d in _DECIDE_RE.findall(b)]
        lead, conf, status = _tension_score(ev)
        rows.append({"id": head.split(" · ")[0], "head": head, "events": ev,
                     "decisions": dec, "lead": lead, "conf": conf, "status": status,
                     "recorded": entry_status(b)})
    return rows


def cmd_tension() -> int:
    require_link()
    ensure_cache(pull=True)
    rows = _tension_rows(_load_entries(_analyze_bases()))
    scored = [r for r in rows if r["events"]]
    print(f"✓ tension — {len(scored)} of {len(rows)} tensions carry structured evidence "
          f"(Evidence: A|B · <ref> lines); the rest have no score yet")
    for r in scored:
        print(f"  {r['id']:<5} confidence {r['conf']:>3}  {r['status']:<8} leads: "
              f"{r['lead'] or '-'}  recorded {r['recorded']}  ({len(r['events'])} evidence)")
        for side, who, d in r["decisions"]:
            out = _decision_outcome(side, r["events"], r["lead"], r["conf"])
            note = "" if out != "overturned" else "  ← the evidence now contradicts this decision"
            print(f"        decision by {who} for {side}: {out}{note}")
    print("  settled = enough tested support to stop testing it on purpose, not a truth;"
          " new evidence can move it back.")
    return 0


# ------------------------------------------------------------- scorecards

def _lesson_outcome(tier: str) -> str:
    return {"confirmed": "holding", "audited": "holding", "modeled": "shaky",
            "disputed": "overturned"}.get(tier, "untested")


def _model_map() -> dict:
    """session id -> model, from a LOCAL file next to the cache. It is never
    pushed: no model name belongs in a shared repo."""
    path = os.path.join(os.path.dirname(node("memory")), "session-models.json")
    try:
        return json.loads(read(path)) if os.path.isfile(path) else {}
    except ValueError:
        return {}


SCORE_MIN_TESTED = 10   # below this a score is noise: show the count, not a percentage


def _load_subjects() -> list:
    """[(category, branch, tags, fallback_tags)] from subjects.json beside the
    CLI. One fixed tree scores Brain and every model alike."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "subjects.json")
    try:
        data = json.loads(read(path))
        return [(c["name"], b["name"], set(b["tags"]), set(b.get("fallback_tags", [])))
                for c in data["categories"] for b in c["branches"]]
    except (OSError, ValueError, KeyError):
        return []


def _subject_of(tags, subjects) -> tuple:
    """(category, branch): the first branch whose `tags` share a tag with the
    lesson; only if none does, the first whose `fallback_tags` do; else Other."""
    ts = {x.lower() for x in (tags or [])}
    for idx in (2, 3):
        for row in subjects:
            if ts & row[idx]:
                return row[0], row[1]
    return "Other", "Other"


def _kernel_key(vertex: str) -> str:
    """The lowercase word that places a kernel on the tree: its domain, or for
    the catch-all SYSTEM domain, its second word."""
    segs = vertex.replace("ideas:", "", 1).split("/")
    if segs[0].strip().lower() == "system" and len(segs) > 1:
        return segs[1].strip().lower()
    return segs[0].strip().lower()


def _counts(rows) -> dict:
    c = {"holding": 0, "shaky": 0, "overturned": 0, "untested": 0}
    for o in rows:
        c[o] += 1
    c["tested"] = c["holding"] + c["shaky"] + c["overturned"]
    return c


def _cell(rows) -> str:
    """One scorecard cell: a percentage only once enough lessons were tested."""
    c = _counts(rows)
    if c["tested"] == 0:
        return "-"
    if c["tested"] < SCORE_MIN_TESTED:
        return f"n={c['tested']}"
    return f"{100 * c['holding'] // c['tested']}% ({c['holding']}/{c['tested']})"


def _short_model(m: str) -> str:
    return m.replace("claude-", "")


def cmd_scorecard() -> int:
    """Two separate scorecards, neither of which feeds a tension's score.
    Brain and each model are scored on the SAME subject list (subjects.json)."""
    require_link()
    ensure_cache(pull=True)
    entries = [e for e in _load_entries(_analyze_bases()) if e["scope"] == "shared"]
    models, subjects = _model_map(), _load_subjects()
    fold_skipped = _collapse_skipped()
    skipped_files = _ignored_files(entries) if fold_skipped else set()
    want_ids = bool(ARGS and ARGS[0] == "--sessions")
    sessions, cells = {}, {}   # cells[(row key, model)] -> [outcome]
    for e in entries:
        o = _lesson_outcome(e["tier"])
        cat, br = _subject_of(e["tags"], subjects)
        skipped = fold_skipped and e["file"] in skipped_files
        if skipped:
            cat, br = "Skipped families", "Skipped families"
        sid = re.search(r"session_[0-9A-Za-z]{20,}", _field(e["block"], "link"))
        if sid:
            sessions[sid.group(0)] = None
            mod = _short_model(models.get(sid.group(0), "unlooked"))
        else:
            mod = "no-link"
        keys = [(cat, br), (cat, None), ("ALL", None)]       # branch, category, all
        if not skipped:
            keys.append((None, None))                       # all, skipped excluded
        for key in keys:
            cells.setdefault((key, "BRAIN"), []).append(o)
            cells.setdefault((key, mod), []).append(o)
    if want_ids:
        for s in sorted(s for s in sessions if s not in models):
            print(s)
        return 0
    cols = ["BRAIN"] + [m for m, _ in sorted(
        ((m, len(v)) for (key, m), v in cells.items() if key == ("ALL", None) and m != "BRAIN"),
        key=lambda x: -x[1])]
    tree, seen = [], set()
    for cat, br, _tg, _fb in subjects:
        if cat not in seen:
            seen.add(cat)
            tree.append((cat, [b for c2, b, _t, _f2 in subjects if c2 == cat]))
    if ("Other", "Other") in {k for (k, _m) in cells}:
        tree.append(("Other", ["Other"]))
    w0 = max([len(b) + 2 for _c, bs in tree for b in bs] + [len(c) for c, _b in tree] + [12]) + 2
    print(f"BRAIN and each model, scored on the same subject tree "
          f"(percentage = lessons holding of those tested; under {SCORE_MIN_TESTED} tested "
          f"shows n=count; a category rolls up its branches)")
    print(f"  {'subject':<{w0}}" + "".join(f"{c:>20}" for c in cols))
    def line(label, key):
        print(f"  {label:<{w0}}" + "".join(f"{_cell(cells.get((key, c), [])):>20}" for c in cols))
    for cat, branches in tree:
        line(cat.upper(), (cat, None))
        if branches != [cat]:
            for b in branches:
                line("  " + b, (cat, b))
    if ("Skipped families", None) in {k for (k, _m) in cells}:
        line("SKIPPED FAMILIES", ("Skipped families", None))
    line("ALL SUBJECTS" + (" (skipped excluded)" if fold_skipped else ""), (None, None))
    if fold_skipped:
        line("ALL INCL. SKIPPED", ("ALL", None))
    print("  (models are looked up from the session id into a local file and never stored"
          " in a repo; 'unlooked' = id not looked up yet, 'no-link' = lesson has no session id)")
    declared, quoted, _pend = _kernel_links_state(entries)
    kc = {}
    for vertex, _blk in _kernel_blocks():
        cat, br = _subject_of([_kernel_key(vertex)], subjects)
        used = vertex in declared or vertex in quoted
        for key in ((cat, br), (cat, None), (None, None)):
            tot, app = kc.get(key, (0, 0))
            kc[key] = (tot + 1, app + (1 if used else 0))
    print("\nKERNELS (the ideas tree; coverage only, not scored: how many a lesson has built on)")
    for cat, branches in tree:
        for key, label in [((cat, None), cat.upper())] + [((cat, b), "  " + b) for b in branches if b != cat]:
            if key in kc:
                print(f"  {label:<{w0}} {kc[key][0]:>5} kernels, {kc[key][1]:>4} built on")
    print(f"  {'ALL SUBJECTS':<{w0}} {kc.get((None, None), (0, 0))[0]:>5} kernels, "
          f"{kc.get((None, None), (0, 0))[1]:>4} built on")
    rows = _tension_rows(_load_entries(_analyze_bases()))
    decs = [(r, s, who) for r in rows for s, who, _d in r["decisions"]]
    print("\nOWNER (decisions judged only by tested evidence; kept separate from Brain)")
    if not decs:
        print("  no decisions with structured evidence yet (Decision: A|B · <who> lines)")
    outs = []
    for r, s, who in decs:
        o = _decision_outcome(s, r["events"], r["lead"], r["conf"])
        outs.append(o)
        print(f"  {r['id']:<5} {o:<10} {r['head'].split(' · ', 2)[-1][:70]}")
    if outs:
        c = _counts(outs)
        print(f"  {len(outs)} decisions: holding {c['holding']}, shaky {c['shaky']}, "
              f"overturned {c['overturned']}, untested {c['untested']}")
    return 0


# ------------------------------------------------------------- gate (unchanged core)

DATE_RE = re.compile(r"\b(\d{4}-\d{2}-\d{2})\b")


def _open_tensions() -> list[tuple[str, str]]:
    text = read(os.path.join(node("Tension"), "tension-ledger.md"))
    out = []
    for b in _blocks(text, "### "):
        if entry_status(b) == "🔴":
            head = b.splitlines()[0].lstrip("# ").strip()
            out.append((head.split(" · ")[0], head))
    return out


def _tension_subject(heading: str) -> str:
    """The part of a heading that says what the tension is ABOUT.

    A heading is `T20 · assumption · one composing entry is enough ...`. The
    middle field is the entry's TYPE, drawn from a fixed vocabulary — tradeoff,
    assumption, open-question, contradiction, alternative — so it is present by
    construction and identical across many entries. Counting it as a keyword
    meant "assumption" in a commit message was evidence for every assumption in
    the ledger. That is how T20 refused a commit about a save format on
    "assumption" + "enough".
    """
    parts = heading.split(" · ")
    return " · ".join(parts[2:]) if len(parts) > 2 else heading


def _keywords(heading: str) -> set[str]:
    return {w for w in re.findall(r"[a-z][a-z-]{4,}", _tension_subject(heading).lower())
            if w not in STOPWORDS}


# Machine-rendered, never hand-authored. The gate skips these (see cmd_gate) and
# they carry a "do not edit by hand" header for the same reason.
GENERATED_FILES = ("BRAIN-INDEX*.md", "BRAIN-FULL*.md", "TRAIN-QUEUE.md")


def cmd_gate() -> int:
    cfg = load_cfg()
    if cfg and not cfg.get("enabled", True):
        return 0  # disabled link never blocks commits
    problems = []
    try:
        # Generated exports are excluded, and this is load-bearing rather than a
        # convenience. BRAIN-INDEX.md is a rendering of the entire canon, so its
        # diff contains every open tension's vocabulary by construction and trips
        # every single one of them at once. The gate exists to make a person stop
        # and acknowledge that something they WROTE touches an open fork; a file
        # the CLI just re-rendered touches nothing. Left in, every regeneration
        # refuses with the full tension list, and the only way to work is to ack
        # them all blindly — which is exactly the reflex the gate is supposed to
        # prevent. A gate that always fires is not a gate.
        excludes = [f":(exclude){f}" for f in GENERATED_FILES]
        diff = git(os.getcwd(), "diff", "--cached", "-U0",
                   "--", ".", *excludes, check=False).lower()
    except RuntimeError:
        diff = ""
    if diff and os.path.isdir(CACHE):
        ack = {a.strip().upper() for a in
               os.environ.get("BRAIN_ACK", "").split(",") if a.strip()}
        for tid, head in _open_tensions():
            kws = _keywords(head)
            found = {k for k in kws if k in diff}
            # Required hits SCALE with the heading's own keyword-set size
            # (floor 2). A short heading (5-6 keywords, the common case) still
            # needs just 2. A long heading accumulates more common/generic
            # single words (e.g. T21's "model"/"negative" — topically central
            # to T21 but also ordinary code vocabulary), so 2 of ITS keywords
            # turning up in an unrelated diff is far likelier by chance than 2
            # of a 5-keyword heading's. Scaling the bar with |kws| keeps the
            # false-positive rate roughly comparable across tensions instead
            # of penalizing only the ones with longer titles. Verified against
            # a real false-positive (T21 matched on "model"+"negative" in a
            # diff about a 3D renderer's model matrix and a "most negative z"
            # depth-sort comment — 2026-07-26) and a genuine on-topic T21 diff
            # (which still matches at 6 hits, well over the new floor of 3).
            # Floor of two, EXCEPT where the heading only has one keyword to
            # give. Widening the stopword list left T1 with a single word
            # ("systems-over-data"), and a floor of two made that tension
            # unfireable — the gate silently stopped watching it. A heading
            # distinctive enough to reduce to one term is exactly the case
            # where that one term is strong evidence.
            required = max(min(2, len(kws)), (len(kws) + 2) // 3)
            if len(found) >= required and tid.upper() not in ack:
                problems.append(f"staged diff touches open tension {tid} "
                                f"({head}) — matched {sorted(found)} "
                                f"({len(found)}/{required} required). "
                                f"Acknowledge: BRAIN_ACK={tid} git commit ...")
    if problems:
        print("✗ brain gate: REFUSED")
        for p in problems:
            print(f"  {p}")
        return 1
    return ok("gate: pass") if VERBOSE else 0


def _self_update() -> None:
    """git pull the Brain repo containing this script, so install always shims
    the latest CLI (prevents a stale wrapper after the code changes)."""
    repo = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if os.path.isdir(os.path.join(repo, ".git")):
        try:
            git(repo, "pull", "--quiet", "origin", "main", check=False)
            detail("self-updated Brain CLI to latest")
        except (RuntimeError, OSError):
            detail("self-update skipped (offline?)")


def _refresh_cache_hard() -> list[str]:
    """Force every node repo in the shared cache to origin/main (fetch + hard
    reset), discarding local drift. The cache is a mirror of main — a project's
    own findings live in its .brain/ store, not here — so a hard reset is safe and
    makes a just-merged change visible to every linked project on this machine."""
    notes = []
    for name in NODES:
        path = node(name)
        if not os.path.isdir(os.path.join(path, ".git")):
            notes.append(f"{name}: not in cache")
            continue
        try:
            git(path, "fetch", "-q", "origin", "main")
            git(path, "reset", "-q", "--hard", "origin/main")
            notes.append(f"{name} → {git(path, 'rev-parse', '--short', 'HEAD').strip()}")
        except (RuntimeError, OSError) as e:
            notes.append(f"{name}: refresh failed ({str(e)[:60]})")
    return notes


def cmd_update() -> int:
    """Force this machine's CLI + knowledge cache to the latest main — run after a
    merge so every linked project on this machine picks up the change at once.
    Machine-wide by design: all projects here share ONE CLI shim and ONE cache, so
    this IS the 'update all linked projects' command (each machine runs it once).
    A hard refresh: the cache is discarded and re-pointed at origin/main."""
    _self_update()
    notes = _refresh_cache_hard()
    for n in notes:
        detail("  " + n)
    return ok(f"updated to latest main — CLI + cache ({len(notes)} node(s) refreshed)")


def cmd_install() -> int:
    """Put `brain` on PATH so you can call it from anywhere. Idempotent.
    Cross-platform: symlink + shell rc on Unix; a .cmd shim + User PATH on
    Windows (symlinks need admin there). Self-updates first."""
    _self_update()
    me = os.path.abspath(__file__)
    rc = _install_windows(me) if os.name == "nt" else _install_unix(me)
    if rc == 0:
        _force_zanegpt_prompt()
    return rc


def _install_unix(me: str) -> int:
    os.chmod(me, 0o755)
    candidates = [
        os.path.expanduser("~/.local/bin"),
        os.path.join(os.environ.get("HOME", ""), "bin"),
        "/usr/local/bin",
    ]
    path_dirs = os.environ.get("PATH", "").split(os.pathsep)
    for d in candidates:
        if not d:
            continue
        try:
            os.makedirs(d, exist_ok=True)
            link = os.path.join(d, "brain")
            if os.path.islink(link) or os.path.exists(link):
                os.remove(link)
            os.symlink(me, link)
        except OSError:
            continue
        if d in path_dirs:
            return ok(f"installed → {link} (already on PATH; run `brain link`)")
        rc = os.path.expanduser("~/.bashrc")
        for cand in ("~/.zshrc", "~/.bashrc", "~/.profile"):
            if os.path.exists(os.path.expanduser(cand)):
                rc = os.path.expanduser(cand)
                break
        line = f'\nexport PATH="{d}:$PATH"  # brain CLI\n'
        if line.strip() not in read(rc):
            with open(rc, "a", encoding="utf-8") as fh:
                fh.write(line)
        return ok(f"installed → {link}. Restart your shell or run: "
                  f'export PATH="{d}:$PATH"  — then `brain link`')
    return die(f"could not write to a PATH dir; add manually:\n"
               f"  alias brain='python3 {me}'", code=1)


def _install_windows(me: str) -> int:
    # a .cmd shim beats a symlink (which needs admin/developer mode on Windows)
    bindir = os.path.join(CACHE, "bin")
    os.makedirs(bindir, exist_ok=True)
    py = sys.executable or "python"
    shim = os.path.join(bindir, "brain.cmd")
    with open(shim, "w", encoding="utf-8") as fh:
        fh.write(f'@echo off\r\n"{py}" "{me}" %*\r\n')
    # is bindir already on PATH for this process?
    path_dirs = [p.lower() for p in os.environ.get("PATH", "").split(os.pathsep)]
    if bindir.lower() in path_dirs:
        return ok(f"installed → {shim} (already on PATH; run `brain link`)")
    # append to the *User* PATH (not System) via PowerShell, only if absent
    ps = (
        "$d='{d}'; "
        "$u=[Environment]::GetEnvironmentVariable('PATH','User'); "
        "if ($u -notlike \"*$d*\") {{ "
        "[Environment]::SetEnvironmentVariable('PATH', "
        "($u.TrimEnd(';') + ';' + $d), 'User') }}"
    ).format(d=bindir)
    added = False
    try:
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True)
        added = r.returncode == 0
    except (OSError, subprocess.SubprocessError):
        added = False
    if added:
        return ok(f"installed → {shim}. Open a NEW terminal, then run "
                  "`brain link`.")
    return ok(f"installed → {shim}. Add its folder to PATH, or call it "
              f"directly:\n  \"{shim}\" link --mode read-only")


# ------------------------------------------------------------- ZaneGPT plugin

ZANEGPT_REPO = f"{DEFAULT_ORG}/Zanegpt"
ZANEGPT_PLUGIN = "zanegpt@zanegpt"
ZANEGPT_RULE = "─" * 56


def _zanegpt_manual() -> None:
    """The path that always works: the slash commands, inside Claude Code."""
    print("  Install it from inside Claude Code:")
    print(f"    /plugin marketplace add {ZANEGPT_REPO}")
    print(f"    /plugin install {ZANEGPT_PLUGIN}")


def _zanegpt_present() -> bool:
    claude = shutil.which("claude")
    if not claude:
        return False
    try:
        r = subprocess.run([claude, "plugin", "list"], capture_output=True,
                           text=True, timeout=60)
    except (OSError, subprocess.SubprocessError):
        return False
    return r.returncode == 0 and "zanegpt" in r.stdout.lower()


def cmd_zanegpt() -> int:
    """Install the ZaneGPT Claude Code plugin: marketplace, then plugin."""
    if _zanegpt_present():
        return ok("zanegpt already installed")
    claude = shutil.which("claude")
    if not claude:
        die("zanegpt not installed — no `claude` CLI on PATH")
        _zanegpt_manual()
        return 1
    steps = (("marketplace", ["plugin", "marketplace", "add", ZANEGPT_REPO]),
             ("plugin", ["plugin", "install", ZANEGPT_PLUGIN]))
    for what, args in steps:
        detail(f"claude {' '.join(args)}")
        try:
            r = subprocess.run([claude] + args, capture_output=True,
                               text=True, timeout=300)
        except (OSError, subprocess.SubprocessError) as e:
            die(f"zanegpt {what} step failed ({str(e)[:60]})")
            _zanegpt_manual()
            return 1
        if r.returncode != 0:
            out = ((r.stderr or "") + (r.stdout or "")).strip()
            # `marketplace add` is not idempotent on every version: a
            # marketplace that is already there is a success for us.
            if what == "marketplace" and "already" in out.lower():
                continue
            last = out.splitlines()[-1][:80] if out else "no output"
            die(f"zanegpt {what} step failed: {last}")
            _zanegpt_manual()
            return 1
    return ok("zanegpt installed (restart Claude Code to load it)")


def _force_zanegpt_prompt() -> None:
    """`brain install` never finishes without putting ZaneGPT in front of the
    user. On a terminal that means an actual question with an answer required.
    On a pipe (`curl | sh`, CI, an agent) there is nobody to ask, so it prints
    the ask and the one command that answers it rather than hanging forever."""
    if _zanegpt_present():
        return
    print(f"\n{ZANEGPT_RULE}")
    print("ZaneGPT — the companion plugin to this install: ZaneGPT-style")
    print("analytical reasoning and adversarial assumption testing, shipped")
    print("as a Claude Code skill.")
    if not sys.stdin.isatty():
        print("\n! NOT INSTALLED — no terminal here to ask on. Install it with:")
        print("    brain zanegpt")
        _zanegpt_manual()
        print(ZANEGPT_RULE)
        return
    while True:
        try:
            answer = input("\nInstall ZaneGPT now? [Y/n] ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            answer = "n"
        if answer in ("", "y", "yes"):
            print()
            cmd_zanegpt()
            break
        if answer in ("n", "no"):
            print("  skipped — install it later with:  brain zanegpt")
            break
        print("  please answer y or n")
    print(ZANEGPT_RULE)


def cmd_install_hooks(silent: bool = False, target: str = None) -> int:
    # explicit target when called internally (e.g. from link); only trust ARGS
    # when invoked directly as the `install-hooks` command
    if target is None:
        arg = ARGS[0] if (ARGS and not ARGS[0].startswith("-")) else None
        target = os.path.abspath(arg) if arg else project_root()
    hooks = os.path.join(target, ".git", "hooks")
    if not os.path.isdir(hooks):
        return die(f"{target} is not a git repo")
    me = os.path.abspath(__file__)
    path = os.path.join(hooks, "pre-commit")
    # git runs hooks via sh even on Windows (Git Bash); pick python3 or python
    # so the hook works cross-platform.
    write(path, "#!/bin/sh\n"
                'py=$(command -v python3 || command -v python)\n'
                f'exec "$py" "{me}" gate\n')
    os.chmod(path, 0o755)
    return 0 if silent else ok(f"gate installed → {path}")


# --------------------------------------------------------- unlink / uninstall

def _remove_pointer() -> str:
    """Strip the injected 'Cognitive system: Brain' block from CLAUDE.md/AGENTS.md."""
    root = project_root()
    for name in ("CLAUDE.md", "AGENTS.md"):
        p = os.path.join(root, name)
        if not os.path.exists(p):
            continue
        body = read(p)
        if "Cognitive system: Brain" not in body:
            continue
        out, skip = [], False
        for ln in body.splitlines(keepends=True):
            if ln.lstrip().startswith("## Cognitive system: Brain"):
                skip = True
                continue
            if skip and ln.startswith("## ") \
                    and "Cognitive system: Brain" not in ln:
                skip = False  # next real section ends our block
            if not skip:
                out.append(ln)
        write(p, "".join(out).rstrip() + "\n")
        return name
    return ""


def _remove_hook() -> bool:
    hook = os.path.join(project_root(), ".git", "hooks", "pre-commit")
    if os.path.exists(hook):
        body = read(hook)
        if "brain" in body and "gate" in body:  # only remove our own hook
            os.remove(hook)
            return True
    return False


def _local_findings() -> int:
    """Everything in the local store that has not reached main yet.

    Counts ALL THREE write-back nodes, not just memory. `unlink` gates the
    deletion of the local store on this number, so undercounting here does not
    merely misreport — it silently destroys a fork or a kernel that was written
    but never pushed, while telling the user there was nothing to lose.
    """
    inc = os.path.join(local_root(), "memory", "incoming")
    props = stubs = []
    if os.path.isdir(inc):
        props = [f for f in os.listdir(inc) if f.endswith(".md")
                 and f not in ("stubs.md", "README.md", "TEMPLATE.md")]
        stubs = [l for l in read(os.path.join(inc, "stubs.md")).splitlines()
                 if l.startswith("- ")]
    return (len(props) + len(stubs)
            + len(_local_proposal_files("ideas")) + len(_local_ideas_blocks())
            + len(_local_proposal_files("tension")) + len(_local_tension_blocks()))


def _remove_from_path() -> bool:
    removed = False
    if os.name == "nt":
        bindir = os.path.join(CACHE, "bin")
        ps = ("$d='{d}'; $u=[Environment]::GetEnvironmentVariable('PATH','User'); "
              "if ($u) {{ $n=(($u.Split(';') | Where-Object {{ $_ -and $_ -ne $d "
              "}}) -join ';'); [Environment]::SetEnvironmentVariable('PATH',$n,"
              "'User') }}").format(d=bindir)
        try:
            r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                               capture_output=True, text=True)
            removed = r.returncode == 0
        except (OSError, subprocess.SubprocessError):
            removed = False
        return removed
    for d in (os.path.expanduser("~/.local/bin"),
              os.path.join(os.environ.get("HOME", ""), "bin"), "/usr/local/bin"):
        link = os.path.join(d, "brain")
        if os.path.islink(link):
            try:
                os.remove(link)
                removed = True
            except OSError:
                pass
    for rc in ("~/.zshrc", "~/.bashrc", "~/.profile"):
        p = os.path.expanduser(rc)
        if not os.path.exists(p):
            continue
        body = read(p)
        kept = [l for l in body.splitlines(keepends=True) if "# brain CLI" not in l]
        if len(kept) != len(body.splitlines(keepends=True)):
            write(p, "".join(kept))
            removed = True
    return removed


def cmd_unlink() -> int:
    """Undo THIS project's link: pointer, hook, and local .brain store."""
    force = "--force" in ARGS or "--yes" in ARGS
    n = _local_findings()
    if n and not force:
        return die(f"{n} local finding(s) not yet synced — they would be lost. "
                   "Re-run `brain unlink --force` to delete anyway.")
    ptr = _remove_pointer()
    hook = _remove_hook()
    had_store = os.path.isdir(local_root())
    if had_store:
        shutil.rmtree(local_root(), ignore_errors=True)
    bits = []
    if ptr:
        bits.append(f"pointer ({ptr})")
    if hook:
        bits.append("pre-commit hook")
    if had_store:
        bits.append(".brain store")
    return ok("unlinked this project" + (" — removed " + ", ".join(bits)
              if bits else " (nothing to remove)"))


def cmd_uninstall() -> int:
    """Thorough machine-wide removal: this project's link + cache + PATH entry."""
    force = "--force" in ARGS or "--yes" in ARGS
    if load_cfg():
        n = _local_findings()
        if n and not force:
            return die(f"{n} unsynced local finding(s) in this project would be "
                       "lost. Re-run `brain uninstall --force` to proceed.")
        _remove_pointer()
        _remove_hook()
        if os.path.isdir(local_root()):
            shutil.rmtree(local_root(), ignore_errors=True)
    path_removed = _remove_from_path()
    cache_gone = False
    if os.path.isdir(CACHE):
        shutil.rmtree(CACHE, ignore_errors=True)
        cache_gone = not os.path.isdir(CACHE)
    done = ["this project's link"]
    if path_removed:
        done.append("PATH entry")
    if cache_gone:
        done.append(f"cache ({CACHE})")
    print("✓ uninstalled — removed " + ", ".join(done))
    if os.path.isdir(CACHE):
        print(f"  could not delete {CACHE} (a file may be locked) — "
              "remove it manually")
    print("  Note: any OTHER projects you linked still have their own .brain "
          "folder — run `brain unlink` in each, or delete that folder.")
    print("  A new terminal is needed for the PATH change to take effect.")
    return 0


# ------------------------------------------------------------- viz

def _pretty_project(rel: str) -> str:
    name = os.path.basename(rel)
    if name.endswith(".md"):
        name = name[:-3]
    repo = name.split("__", 1)[1] if "__" in name else name
    words = repo.replace("-", " ").replace("_", " ").split()
    return " ".join(w.capitalize() for w in words) or repo


def _entry_date(project_rel: str, entry_id: str) -> str:
    text = read(os.path.join(node("memory"), project_rel))
    m = re.search(rf"^## {re.escape(entry_id)}\b.*?(?=^## |\Z)", text,
                  re.M | re.S)
    if not m:
        return ""
    dm = re.search(r"-\s*Date:\s*(\d{4}-\d{2}-\d{2})", m.group(0))
    return dm.group(1) if dm else ""


def _dom_id(key: str) -> str:
    return "node-" + re.sub(r"[^a-zA-Z0-9_-]+", "-", key.lower()).strip("-")


def _viz_lessons() -> list:
    out = []
    anchor = re.compile(r"→\s*(projects/[^\s#]+\.md)#(\w+)\s*$")
    for entry in _memory_index(node("memory")):
        m = re.match(r"^- `((?:\[[^\]]+\])+)`\s*(.*)$", entry)
        if not m:
            continue
        tags = re.findall(r"\[([^\]]+)\]", m.group(1))
        rest = m.group(2)
        am = anchor.search(rest)
        if not am:
            continue
        project_file, entry_id = am.group(1), am.group(2)
        text = rest[:am.start()].strip(" —-→")
        stub = os.path.basename(project_file)[:-3]
        key = f"{stub}#{entry_id}"
        out.append({
            "type": "lesson",
            "text": text,
            "tags": tags,
            "project": _pretty_project(project_file),
            "project_slug": re.sub(r"[^a-z0-9]+", "-",
                                   _pretty_project(project_file).lower()).strip("-"),
            "project_file": project_file,
            "id": entry_id,
            "date": _entry_date(project_file, entry_id),
            "key": key,
            "dom_id": _dom_id(key),
            "related": [],
        })
    return out


def _norm_idea_path(s: str) -> str:
    return "/".join(p.strip().lower() for p in s.split("/") if p.strip())


def _viz_ideas() -> list:
    out = []
    text = read(os.path.join(node("ideas"), "idea-repository.md"))
    for i, b in enumerate(_blocks(text, "## [")):
        lines = b.splitlines()
        head = lines[0].strip()
        m = re.match(r"##\s*\[(.+)\]", head)
        raw_path = m.group(1) if m else head
        path = [p.strip() for p in raw_path.split("/")] if m else [head]
        body = "\n".join(lines[1:]).strip()
        key = f"idea#{i}"
        out.append({
            "type": "idea",
            "is_kernel": True,
            "domain": path[0] if path else "Idea",
            "path": path[1:],
            "text": body,
            "norm_path": _norm_idea_path(raw_path),
            "key": key,
            "dom_id": _dom_id(key),
            "related": [],
        })
    exp_text = read(os.path.join(node("ideas"), "exploration.md"))
    for b in _blocks(exp_text, "### "):
        lines = b.splitlines()
        head = lines[0][4:].strip()
        parts = [p.strip() for p in head.split("·")]
        if len(parts) < 2:
            continue
        eid = parts[0]
        etype = parts[1] if len(parts) > 1 else "note"
        title = parts[2] if len(parts) > 2 else parts[-1]
        state = parts[-1].strip("* ") if len(parts) > 3 else "live"
        body = "\n".join(lines[1:]).strip()
        key = f"expl#{eid}"
        out.append({
            "type": "idea",
            "is_kernel": False,
            "domain": etype.title() or "Exploration",
            "path": [state] if state else [],
            "text": (title + " — " + body) if title and title != state else body,
            "norm_path": "",
            "key": key,
            "dom_id": _dom_id(key),
            "related": [],
        })
    return out


def _viz_tensions() -> list:
    out = []
    text = read(os.path.join(node("Tension"), "tension-ledger.md"))
    field_re = re.compile(
        r"^(Poles|Lean|Open sub-question|Resolution path|Source):\s*(.*)$")
    labels = {"🔴": "Open", "🟡": "Leaning", "🟢": "Resolved",
             "⚪": "Superseded", "": "Open"}
    for b in _blocks(text, "### "):
        lines = b.splitlines()
        head = lines[0][4:].strip()
        parts = [p.strip() for p in head.split("·", 2)]
        tid = parts[0] if parts else head
        ttype = parts[1] if len(parts) > 1 else ""
        title = parts[2] if len(parts) > 2 else ttype
        status = entry_status(b)
        fields, cur_key, cur_val = {}, None, []
        for ln in lines[1:]:
            m = field_re.match(ln.strip())
            if m:
                if cur_key:
                    fields[cur_key] = " ".join(cur_val).strip()
                cur_key, cur_val = m.group(1), [m.group(2)]
            elif cur_key and ln.strip():
                cur_val.append(ln.strip())
        if cur_key:
            fields[cur_key] = " ".join(cur_val).strip()
        out.append({
            "type": "tension",
            "id": tid,
            "kind": ttype,
            "title": title,
            "status": status,
            "status_label": labels.get(status, "Open"),
            "poles": fields.get("Poles", ""),
            "lean": fields.get("Lean", ""),
            "source": fields.get("Source", ""),
            "key": tid,
            "dom_id": _dom_id(tid),
            "related": [],
        })
    return out


def _strip_md_light(s: str) -> str:
    """Plain-text label from body prose — no bold/italic/code markers or stray
    bullet-list dashes, since this feeds inline link text, not rendered HTML."""
    s = re.sub(r"\*\*(.+?)\*\*", r"\1", s)
    s = re.sub(r"\*(.+?)\*", r"\1", s)
    s = re.sub(r"`([^`]+)`", r"\1", s)
    s = re.sub(r"(^|\n|—)\s*[-•]\s+", r"\1 ", s)  # list markers, incl. right after em-dash
    return re.sub(r"\s+", " ", s).strip()


def _short_label(e: dict) -> str:
    if e["type"] == "lesson":
        clean = _strip_md_light(e["text"])
        snippet = clean[:56].rstrip()
        return f'{e["project"]} — {snippet}{"…" if len(clean) > 56 else ""}'
    if e["type"] == "tension":
        return f'{e["id"]}: {_strip_md_light(e["title"])[:50]}'
    # idea
    clean = _strip_md_light(e["text"])
    snippet = clean[:56].rstrip()
    return f'{e["domain"]} — {snippet}{"…" if len(clean) > 56 else ""}'


def _build_graph(lessons: list, ideas: list, tensions: list) -> None:
    """Scan each entity's own text for real cross-references already present in
    the writing (a lesson citing `file.md#E8`, a tension citing an idea's
    [DOMAIN/...] tag, tensions citing each other) and wire up a `related` list +
    `degree` on every entity, both directions. No fabricated connections — if
    the text doesn't mention it, there's no edge."""
    lesson_by_key = {l["key"]: l for l in lessons}
    idea_by_path = {i["norm_path"]: i for i in ideas if i.get("is_kernel") and i["norm_path"]}
    tension_by_id = {t["id"]: t for t in tensions}

    lesson_ref_re = re.compile(r"([a-z0-9_.-]+)\.md#(E\d+)", re.I)
    tension_ref_re = re.compile(r"\bT(\d+)\b")
    bracket_re = re.compile(r"\[([^\]]+)\]")

    def add_edge(src: dict, dst: dict) -> None:
        if src["key"] == dst["key"]:
            return
        for existing in src["related"]:
            if existing["key"] == dst["key"]:
                return
        src["related"].append({"key": dst["key"], "dom_id": dst["dom_id"],
                               "type": dst["type"], "label": _short_label(dst)})

    def scan_text(entity: dict) -> str:
        if entity["type"] == "tension":
            return " ".join([entity.get("poles", ""), entity.get("lean", ""),
                             entity.get("source", "")])
        return entity.get("text", "")

    for entity in lessons + ideas + tensions:
        text = scan_text(entity)
        for m in lesson_ref_re.finditer(text):
            key = f"{m.group(1)}#{m.group(2)}"
            target = lesson_by_key.get(key)
            if target:
                add_edge(entity, target)
                add_edge(target, entity)
        for m in tension_ref_re.finditer(text):
            target = tension_by_id.get(f"T{m.group(1)}")
            if target:
                add_edge(entity, target)
                add_edge(target, entity)
        for m in bracket_re.finditer(text):
            target = idea_by_path.get(_norm_idea_path(m.group(1)))
            if target:
                add_edge(entity, target)
                add_edge(target, entity)

    for entity in lessons + ideas + tensions:
        entity["degree"] = len(entity["related"])


def _esc(s) -> str:
    return html.escape(str(s), quote=True)


def _pill(text: str) -> str:
    return f'<span class="pill">{_esc(text)}</span>'


def _md_lite(s: str) -> str:
    """Render the small set of markdown emphasis these entries actually use,
    so **vs** / *advisory* show as real emphasis instead of literal asterisks."""
    s = _esc(s)
    s = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", s)
    s = re.sub(r"\*(.+?)\*", r"<em>\1</em>", s)
    s = re.sub(r"`([^`]+)`", r"<code>\1</code>", s)
    return s


def _preview(text: str, limit: int = 260) -> tuple:
    text = text.strip()
    if len(text) <= limit:
        return text, ""
    cut = text.rfind(" ", 0, limit)
    if cut < limit * 0.6:
        cut = limit
    return text[:cut] + "…", text


def _hub_badge(e: dict) -> str:
    if e.get("degree", 0) < 3:
        return ""
    return f'<span class="hub-badge" title="Highly connected">🔗 {e["degree"]}</span>'


def _related_row(e: dict, limit: int = 4) -> str:
    rel = e.get("related", [])
    if not rel:
        return ""
    links = "".join(
        f'<a class="rel-link" href="#{r["dom_id"]}" data-jump="{r["dom_id"]}">'
        f'{_esc(r["label"])}</a>' for r in rel[:limit])
    more = f'<span class="rel-more">+{len(rel) - limit} more</span>' if len(rel) > limit else ""
    return f'<div class="related-row"><span class="related-caption">Connects to</span>{links}{more}</div>'


def _render_lesson_card(l: dict) -> str:
    tags_attr = "|".join(t.lower() for t in l["tags"])
    search = _esc(" ".join([l["text"], l["project"], *l["tags"]]).lower())
    preview, full = _preview(l["text"])
    more = (f'<details><summary>Read more</summary>'
            f'<p class="full-text">{_md_lite(full)}</p></details>') if full else ""
    date_bit = f' · {_esc(l["date"])}' if l["date"] else ""
    pills = "".join(_pill(t) for t in l["tags"])
    return f'''<article id="{l["dom_id"]}" class="entry-card" data-type="lesson" data-project="{_esc(l["project_slug"])}" data-tags="{_esc(tags_attr)}" data-search="{search}">
  <div class="entry-accent accent-lesson"></div>
  <div class="entry-body">
    {_hub_badge(l)}
    <p class="entry-text">{_md_lite(preview)}</p>
    {more}
    <div class="entry-meta">{_esc(l["project"])}{date_bit}</div>
    <div class="entry-tags">{pills}</div>
    {_related_row(l)}
  </div>
</article>'''


def _render_idea_card(i: dict) -> str:
    search = _esc(" ".join([i["text"], i["domain"], *i["path"]]).lower())
    preview, full = _preview(i["text"])
    more = (f'<details><summary>Read more</summary>'
            f'<p class="full-text">{_md_lite(full)}</p></details>') if full else ""
    pills = "".join(_pill(t) for t in i["path"][:4])
    return f'''<article id="{i["dom_id"]}" class="entry-card" data-type="idea" data-search="{search}">
  <div class="entry-accent accent-idea"></div>
  <div class="entry-body">
    {_hub_badge(i)}
    <div class="entry-kicker">{_esc(i["domain"])}</div>
    <p class="entry-text">{_md_lite(preview)}</p>
    {more}
    <div class="entry-tags">{pills}</div>
    {_related_row(i)}
  </div>
</article>'''


def _render_tension_card(t: dict) -> str:
    search = _esc(" ".join([t["title"], t["poles"], t["lean"]]).lower())
    status_class = {"🔴": "status-critical", "🟡": "status-warning",
                    "🟢": "status-good", "⚪": "status-muted"
                   }.get(t["status"], "status-critical")
    status_icon = {"🔴": "●", "🟡": "◐", "🟢": "✓", "⚪": "○"
                  }.get(t["status"], "●")
    poles_html = f'<p class="entry-text">{_md_lite(t["poles"])}</p>' if t["poles"] else ""
    lean_html = (f'<p class="tension-lean"><strong>Current thinking:</strong> '
                f'{_md_lite(t["lean"])}</p>') if t["lean"] else ""
    return f'''<article id="{t["dom_id"]}" class="entry-card" data-type="tension" data-search="{search}">
  <div class="entry-accent accent-tension"></div>
  <div class="entry-body">
    {_hub_badge(t)}
    <div class="status-badge {status_class}">{status_icon} {_esc(t["status_label"])}</div>
    <p class="entry-title">{_esc(t["title"])}</p>
    {poles_html}
    {lean_html}
    {_related_row(t)}
  </div>
</article>'''


